extends ../layouts/layout

block content
  .row.justify-content-center
    .col-md-6.col-lg-4
      .card.shadow
        .card-header.bg-success.text-white
          h4.text-center.mb-0 Registro
        .card-body
          form(action="/register", method="POST")
            .mb-3
              label.form-label Nombre
              input.form-control(type="text", name="name", required)
            .mb-3
              label.form-label Email
              input.form-control(type="email", name="email", required)
            .mb-3
              label.form-label Contraseña
              input.form-control(type="password", name="password", required)
            button.btn.btn-success.w-100(type="submit") Registrarse
          .mt-3.text-center
            a(href="/login") ¿Ya tienes cuenta? Inicia sesión