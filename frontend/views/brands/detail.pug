extends ../layouts/layout

block content

  //- ============================================
  //- HEADER
  //- ============================================
  .d-flex.flex-wrap.flex-md-nowrap.align-items-center.justify-content-between.pb-3.mb-4.border-bottom
    .d-flex.align-items-center
      .bg-primary.bg-opacity-10.rounded-3.p-3.me-3
        i.fas.fa-trademark.text-primary.fa-2x
      div
        nav(aria-label="breadcrumb")
          ol.breadcrumb.mb-1
            li.breadcrumb-item
              a.text-decoration-none(href="/brands") Marcas
            li.breadcrumb-item.active= brand.name
        h1.h2.mb-0.fw-bold= brand.name
        p.text-muted.mb-0
          if brand.isActive
            span.badge.bg-success-subtle.text-success.px-3.py-2.rounded-pill.border.border-success-subtle
              i.fas.fa-check-circle.me-1
              | Activa
          else
            span.badge.bg-danger-subtle.text-danger.px-3.py-2.rounded-pill.border.border-danger-subtle
              i.fas.fa-times-circle.me-1
              | Inactiva
    div.d-flex.gap-2
      a.btn.btn-outline-secondary.rounded-pill.px-3(href="/brands")
        i.fas.fa-arrow-left.me-1
        | Volver
      a.btn.btn-warning.rounded-pill.px-4(href=`/brands/${brand._id}/edit`)
        i.fas.fa-pen.me-1
        | Editar

  //- ============================================
  //- TARJETAS DE ESTADÍSTICAS RÁPIDAS
  //- ============================================
  .row.g-3.mb-4
    .col-sm-6.col-lg-4
      .card.border-0.shadow-sm.rounded-3.stat-card.h-100
        .card-body.d-flex.justify-content-between.align-items-center
          div
            h6.card-title.mb-1.small.text-uppercase.text-muted.fw-semibold Productos
            h6.card-text.mb-0.fw-bold.text-dark #{brand.productsCount || 0}
          .stat-icon.bg-primary.bg-opacity-10.text-primary.rounded-3
            i.fas.fa-boxes.fa-lg

    .col-sm-6.col-lg-4
      .card.border-0.shadow-sm.rounded-3.stat-card.h-100
        .card-body.d-flex.justify-content-between.align-items-center
          div
            h6.card-title.mb-1.small.text-uppercase.text-muted.fw-semibold Estado
            h6.card-text.mb-0.fw-bold(class=brand.isActive ? 'text-success' : 'text-danger') #{brand.isActive ? 'Activa' : 'Inactiva'}
          .stat-icon.bg-success.bg-opacity-10.text-success.rounded-3
            i.fas.fa-toggle-on.fa-lg

    .col-sm-6.col-lg-4
      .card.border-0.shadow-sm.rounded-3.stat-card.h-100
        .card-body.d-flex.justify-content-between.align-items-center
          div
            h6.card-title.mb-1.small.text-uppercase.text-muted.fw-semibold Creada
            h6.card-text.mb-0.fw-bold.text-dark= new Date(brand.createdAt).toLocaleDateString('es-PE', { day: '2-digit', month: 'short', year: 'numeric' })
          .stat-icon.bg-info.bg-opacity-10.text-info.rounded-3
            i.fas.fa-calendar.fa-lg

  //- ============================================
  //- CONTENIDO PRINCIPAL
  //- ============================================
  .row.g-4

    //- ========== COLUMNA IZQUIERDA: LOGO ==========
    .col-lg-4

      .card.border-0.shadow-sm.rounded-3.mb-4
        .card-header.bg-white.border-bottom.py-3
          h6.mb-0.fw-bold
            i.fas.fa-image.me-2.text-primary
            | Logo de la Marca
        .card-body.p-4.text-center

          .logo-display.mb-3(
            style="width: 100%; max-width: 220px; height: 220px; margin: 0 auto; border-radius: 16px; background: #f8fafc; border: 2px solid #e2e8f0; display: flex; align-items: center; justify-content: center; overflow: hidden; padding: 16px;"
          )
            if brand.logo && !brand.logo.includes('default')
              img(
                src=brand.logo
                alt=brand.name
                style="max-width: 100%; max-height: 100%; object-fit: contain;"
                onerror="this.style.display='none'; this.nextElementSibling.style.display='block';"
              )
              i.fas.fa-trademark.text-muted(
                style="font-size: 80px; display: none; opacity: 0.3;"
              )
            else
              i.fas.fa-trademark.text-muted(
                style="font-size: 80px; opacity: 0.3;"
              )

          if brand.logo && !brand.logo.includes('default')
            a.btn.btn-outline-secondary.rounded-pill.w-100.mt-2(
              href=brand.logo
              target="_blank"
              rel="noopener"
            )
              i.fas.fa-external-link-alt.me-2
              | Ver imagen completa
          else
            p.text-muted.small.mb-0 Sin logo personalizado

      //- ACCIONES RÁPIDAS
      .card.border-0.shadow-sm.rounded-3
        .card-header.bg-white.border-bottom.py-3
          h6.mb-0.fw-bold
            i.fas.fa-bolt.me-2.text-primary
            | Acciones Rápidas
        .card-body.p-4

          .d-grid.gap-2
            a.btn.btn-outline-warning.rounded-pill(
              href=`/brands/${brand._id}/edit`
            )
              i.fas.fa-pen.me-2
              | Editar Marca

            if brand.isActive
              button.btn.btn-outline-secondary.rounded-pill.btn-toggle-status(
                type="button"
                data-brand-id=brand._id
                data-brand-name=brand.name
                data-action="deactivate"
              )
                i.fas.fa-toggle-off.me-2
                | Desactivar Marca
            else
              button.btn.btn-outline-success.rounded-pill.btn-toggle-status(
                type="button"
                data-brand-id=brand._id
                data-brand-name=brand.name
                data-action="activate"
              )
                i.fas.fa-toggle-on.me-2
                | Activar Marca

            button.btn.btn-outline-danger.rounded-pill.btn-delete-brand(
              type="button"
              data-brand-id=brand._id
              data-brand-name=brand.name
            )
              i.fas.fa-trash.me-2
              | Eliminar Marca

    //- ========== COLUMNA DERECHA: INFO ==========
    .col-lg-8

      //- INFORMACIÓN GENERAL
      .card.border-0.shadow-sm.rounded-3.mb-4
        .card-header.bg-white.border-bottom.py-3
          h6.mb-0.fw-bold
            i.fas.fa-info-circle.me-2.text-primary
            | Información General
        .card-body.p-4

          .info-list
            .info-item
              .info-icon.bg-primary.bg-opacity-10.text-primary
                i.fas.fa-trademark
              div
                small.text-muted.d-block Nombre de la Marca
                strong= brand.name

            .info-item
              .info-icon.bg-secondary.bg-opacity-10.text-secondary
                i.fas.fa-hashtag
              div
                small.text-muted.d-block ID de Marca
                strong= brand._id.toString().slice(-8).toUpperCase()

            .info-item
              .info-icon.bg-info.bg-opacity-10.text-info
                i.fas.fa-align-left
              div
                small.text-muted.d-block Descripción
                if brand.description
                  span= brand.description
                else
                  span.text-muted.fst-italic Sin descripción

            .info-item
              .info-icon.bg-success.bg-opacity-10.text-success
                i.fas.fa-toggle-on
              div
                small.text-muted.d-block Estado
                if brand.isActive
                  span.badge.bg-success-subtle.text-success.px-3.py-1.rounded-pill.border.border-success-subtle
                    i.fas.fa-check-circle.me-1
                    | Activa
                else
                  span.badge.bg-danger-subtle.text-danger.px-3.py-1.rounded-pill.border.border-danger-subtle
                    i.fas.fa-times-circle.me-1
                    | Inactiva

            .info-item
              .info-icon.bg-warning.bg-opacity-10.text-warning
                i.fas.fa-calendar
              div
                small.text-muted.d-block Fecha de Creación
                strong= new Date(brand.createdAt).toLocaleDateString('es-PE', { day: '2-digit', month: 'long', year: 'numeric', hour: '2-digit', minute: '2-digit' })

            if brand.updatedAt
              .info-item
                .info-icon.bg-primary.bg-opacity-10.text-primary
                  i.fas.fa-clock
                div
                  small.text-muted.d-block Última Actualización
                  strong= new Date(brand.updatedAt).toLocaleDateString('es-PE', { day: '2-digit', month: 'long', year: 'numeric', hour: '2-digit', minute: '2-digit' })

            if brand.createdBy
              .info-item
                .info-icon.bg-secondary.bg-opacity-10.text-secondary
                  i.fas.fa-user
                div
                  small.text-muted.d-block Creado por
                  strong= brand.createdBy.name || 'Usuario'

  //- ============================================
  //- MODAL CONFIRMAR ELIMINACIÓN
  //- ============================================
  .modal.fade#modalDeleteBrand(tabindex="-1")
    .modal-dialog.modal-dialog-centered
      .modal-content.rounded-4.border-0.shadow-lg

        .modal-header.bg-danger.text-white.rounded-top-4
          h5.modal-title
            i.fas.fa-exclamation-triangle.me-2
            | Eliminar Marca
          button.btn-close.btn-close-white(type="button" data-bs-dismiss="modal")

        .modal-body.p-4
          .text-center.mb-4
            .bg-danger.bg-opacity-10.rounded-circle.d-inline-flex.align-items-center.justify-content-center.mb-3(
              style="width: 80px; height: 80px;"
            )
              i.fas.fa-trash.text-danger.fa-2x

            h5.fw-bold.mb-2 ¿Estás seguro de eliminar esta marca?
            p.text-muted.mb-0
              | Se eliminará la marca 
              strong#deleteBrandName.text-primary -
              | . Esta acción no se puede deshacer.

          .alert.alert-warning.rounded-3.mb-0
            i.fas.fa-info-circle.me-2
            small
              strong Nota:
              |  Si la marca tiene productos asociados, no se podrá eliminar.

        .modal-footer.border-top-0.p-3
          button.btn.btn-outline-secondary.rounded-pill.px-4(
            type="button"
            data-bs-dismiss="modal"
          )
            i.fas.fa-times.me-1
            | Cancelar
          form#formDeleteBrand(method="POST" action="")
            input(type="hidden" name="_method" value="DELETE")
            button.btn.btn-danger.rounded-pill.px-4(
              type="submit"
              id="btnConfirmarDelete"
            )
              i.fas.fa-trash.me-1
              | Sí, eliminar

  //- ============================================
  //- MODAL CONFIRMAR CAMBIO DE ESTADO
  //- ============================================
  .modal.fade#modalToggleStatus(tabindex="-1")
    .modal-dialog.modal-dialog-centered
      .modal-content.rounded-4.border-0.shadow-lg

        .modal-header.bg-warning.text-white.rounded-top-4
          h5.modal-title
            i.fas.fa-toggle-on.me-2
            | Cambiar Estado
          button.btn-close.btn-close-white(type="button" data-bs-dismiss="modal")

        .modal-body.p-4
          .text-center.mb-4
            .bg-warning.bg-opacity-10.rounded-circle.d-inline-flex.align-items-center.justify-content-center.mb-3(
              style="width: 80px; height: 80px;"
            )
              i.fas.fa-toggle-on.text-warning.fa-2x

            h5.fw-bold.mb-2#toggleStatusTitle ¿Confirmar cambio?
            p.text-muted.mb-0#toggleStatusMessage

        .modal-footer.border-top-0.p-3
          button.btn.btn-outline-secondary.rounded-pill.px-4(
            type="button"
            data-bs-dismiss="modal"
          )
            i.fas.fa-times.me-1
            | Cancelar
          form#formToggleStatus(method="POST" action="")
            input(type="hidden" name="_method" value="PUT")
            input(type="hidden" name="isActive" id="toggleStatusValue" value="")
            input(type="hidden" name="name" id="toggleStatusName" value="")
            button.btn.btn-warning.rounded-pill.px-4(
              type="submit"
              id="btnConfirmarToggle"
            )
              i.fas.fa-check.me-1
              | Confirmar

  //- ============================================
  //- ESTILOS
  //- ============================================
  style.
    .stat-card {
      transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .stat-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 12px 24px rgba(0,0,0,0.08) !important;
    }
    .stat-icon {
      width: 52px;
      height: 52px;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .logo-display {
      transition: all 0.3s ease;
    }
    .logo-display:hover {
      border-color: #0d6efd;
      box-shadow: 0 8px 24px rgba(13, 110, 253, 0.15);
    }

    .info-list {
      display: flex;
      flex-direction: column;
      gap: 18px;
    }
    .info-item {
      display: flex;
      align-items: flex-start;
      gap: 14px;
    }
    .info-icon {
      width: 44px;
      height: 44px;
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 16px;
      flex-shrink: 0;
    }
    .info-item strong,
    .info-item span {
      color: #1e293b;
      font-size: 0.95rem;
      word-break: break-word;
    }

    .badge {
      font-size: 0.75rem;
      font-weight: 600;
      letter-spacing: 0.2px;
    }

    @media (max-width: 768px) {
      .info-icon {
        width: 40px;
        height: 40px;
        font-size: 14px;
      }
      .stat-icon {
        width: 44px;
        height: 44px;
      }
    }

  //- ============================================
  //- SCRIPT
  //- ============================================
  script.
    document.addEventListener('DOMContentLoaded', function() {

      // ============================================
      // ELIMINAR
      // ============================================
      const modalDeleteEl = document.getElementById('modalDeleteBrand');
      const modalDelete = new bootstrap.Modal(modalDeleteEl);
      const deleteBrandName = document.getElementById('deleteBrandName');
      const formDeleteBrand = document.getElementById('formDeleteBrand');
      const btnConfirmarDelete = document.getElementById('btnConfirmarDelete');

      document.querySelectorAll('.btn-delete-brand').forEach(btn => {
        btn.addEventListener('click', function() {
          const brandId = this.dataset.brandId;
          const brandName = this.dataset.brandName;

          deleteBrandName.textContent = brandName;
          formDeleteBrand.action = `/brands/${brandId}?_method=DELETE`;

          modalDelete.show();
        });
      });

      if (formDeleteBrand) {
        formDeleteBrand.addEventListener('submit', function() {
          btnConfirmarDelete.disabled = true;
          btnConfirmarDelete.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Eliminando...';
        });
      }

      modalDeleteEl.addEventListener('hidden.bs.modal', function() {
        btnConfirmarDelete.disabled = false;
        btnConfirmarDelete.innerHTML = '<i class="fas fa-trash me-1"></i> Sí, eliminar';
      });

      // ============================================
      // CAMBIAR ESTADO
      // ============================================
      const modalToggleEl = document.getElementById('modalToggleStatus');
      const modalToggle = new bootstrap.Modal(modalToggleEl);
      const toggleStatusTitle = document.getElementById('toggleStatusTitle');
      const toggleStatusMessage = document.getElementById('toggleStatusMessage');
      const toggleStatusValue = document.getElementById('toggleStatusValue');
      const toggleStatusName = document.getElementById('toggleStatusName');
      const formToggleStatus = document.getElementById('formToggleStatus');
      const btnConfirmarToggle = document.getElementById('btnConfirmarToggle');

      document.querySelectorAll('.btn-toggle-status').forEach(btn => {
        btn.addEventListener('click', function() {
          const brandId = this.dataset.brandId;
          const brandName = this.dataset.brandName;
          const action = this.dataset.action;

          if (action === 'deactivate') {
            toggleStatusTitle.textContent = '¿Desactivar esta marca?';
            toggleStatusMessage.textContent = `La marca "${brandName}" dejará de estar disponible en el sistema.`;
            toggleStatusValue.value = 'off';
          } else {
            toggleStatusTitle.textContent = '¿Activar esta marca?';
            toggleStatusMessage.textContent = `La marca "${brandName}" estará disponible nuevamente en el sistema.`;
            toggleStatusValue.value = 'on';
          }

          toggleStatusName.value = brandName;
          formToggleStatus.action = `/brands/${brandId}?_method=PUT`;

          modalToggle.show();
        });
      });

      if (formToggleStatus) {
        formToggleStatus.addEventListener('submit', function() {
          btnConfirmarToggle.disabled = true;
          btnConfirmarToggle.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Guardando...';
        });
      }

      modalToggleEl.addEventListener('hidden.bs.modal', function() {
        btnConfirmarToggle.disabled = false;
        btnConfirmarToggle.innerHTML = '<i class="fas fa-check me-1"></i> Confirmar';
      });
    });