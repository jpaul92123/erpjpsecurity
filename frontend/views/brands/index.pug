extends ../layouts/layout

block content

  //- ============================================
  //- HEADER
  //- ============================================
  .d-flex.flex-wrap.flex-md-nowrap.align-items-center.justify-content-between.pb-3.mb-4.border-bottom
    .d-flex.align-items-center
      .bg-primary.bg-opacity-10.rounded-3.p-3.me-3
        i.fas.fa-trademark.text-primary.fa-2x
      div
        h1.h2.mb-0.fw-bold Marcas
        p.text-muted.mb-0
          i.fas.fa-info-circle.me-1
          | Gestión de marcas de productos
    div.d-flex.gap-2
      a.btn.btn-primary.rounded-pill.px-4.shadow-sm(href="/brands/create")
        i.fas.fa-plus-circle.me-1
        | Nueva Marca

  //- ============================================
  //- TARJETAS DE ESTADÍSTICAS
  //- ============================================
  .row.g-3.mb-4
    .col-sm-6.col-lg-4
      .card.border-0.shadow-sm.rounded-3.stat-card.h-100
        .card-body.d-flex.justify-content-between.align-items-center
          div
            h6.card-title.mb-1.small.text-uppercase.text-muted.fw-semibold Total Marcas
            h2.card-text.mb-0.fw-bold.text-dark #{brands ? brands.length : 0}
            small.text-primary
              i.fas.fa-trademark.me-1
              | Registradas
          .stat-icon.bg-primary.bg-opacity-10.text-primary.rounded-3
            i.fas.fa-trademark.fa-lg

    .col-sm-6.col-lg-4
      .card.border-0.shadow-sm.rounded-3.stat-card.h-100
        .card-body.d-flex.justify-content-between.align-items-center
          div
            h6.card-title.mb-1.small.text-uppercase.text-muted.fw-semibold Activas
            h2.card-text.mb-0.fw-bold.text-success #{brands ? brands.filter(b => b.isActive).length : 0}
            small.text-success
              i.fas.fa-check-circle.me-1
              | Disponibles
          .stat-icon.bg-success.bg-opacity-10.text-success.rounded-3
            i.fas.fa-check-double.fa-lg

    .col-sm-6.col-lg-4
      .card.border-0.shadow-sm.rounded-3.stat-card.h-100
        .card-body.d-flex.justify-content-between.align-items-center
          div
            h6.card-title.mb-1.small.text-uppercase.text-muted.fw-semibold Inactivas
            h2.card-text.mb-0.fw-bold.text-danger #{brands ? brands.filter(b => !b.isActive).length : 0}
            small.text-danger
              i.fas.fa-times-circle.me-1
              | Deshabilitadas
          .stat-icon.bg-danger.bg-opacity-10.text-danger.rounded-3
            i.fas.fa-ban.fa-lg

  //- ============================================
  //- FILTROS
  //- ============================================
  .card.border-0.shadow-sm.rounded-3.mb-3
    .card-body.p-3
      .row.g-3.align-items-center
        .col-md-6
          .input-group
            span.input-group-text.bg-white.border-end-0
              i.fas.fa-search.text-muted
            input.form-control.border-start-0(
              type="text"
              id="searchBrand"
              placeholder="Buscar por nombre o descripción..."
            )
        .col-md-3
          select.form-select#filterStatus
            option(value="") Todos los estados
            option(value="active") ✅ Activas
            option(value="inactive") ❌ Inactivas
        .col-md-3.text-md-end
          span.text-muted.small
            i.fas.fa-filter.me-1
            span#resultsCount #{brands ? brands.length : 0} resultados

  //- ============================================
  //- TABLA
  //- ============================================
  .card.border-0.shadow-sm.rounded-3.overflow-hidden
    .card-body.p-0
      .table-responsive
        table.table.table-hover.align-middle.mb-0#brandsTable
          thead.bg-light
            tr
              th(style="min-width: 250px;") Marca
              th(style="min-width: 300px;") Descripción
              th.text-center(style="min-width: 110px;") Estado
              th.text-center(style="min-width: 140px;") Acciones
          tbody
            if brands && brands.length
              each brand in brands
                tr(data-status=brand.isActive ? 'active' : 'inactive')
                  td
                    .d-flex.align-items-center
                      //- ✅ LOGO de la marca (con fallback a icono)
                      .brand-logo-wrapper.me-3(
                        style="width: 48px; height: 48px; border-radius: 10px; background: #f8fafc; border: 1px solid #e2e8f0; display: flex; align-items: center; justify-content: center; overflow: hidden; flex-shrink: 0;"
                      )
                        if brand.logo && !brand.logo.includes('default')
                          img(
                            src=brand.logo
                            alt=brand.name
                            style="max-width: 90%; max-height: 90%; object-fit: contain;"
                            onerror="this.style.display='none'; this.nextElementSibling.style.display='inline-block';"
                          )
                          i.fas.fa-trademark.text-primary.fa-lg(style="display: none;")
                        else
                          i.fas.fa-trademark.text-primary.fa-lg
                      div
                        a.text-decoration-none.fw-semibold.d-block.text-dark(
                          href=`/brands/${brand._id}`
                        ) #{brand.name}
                        small.text-muted
                          i.fas.fa-hashtag.me-1
                          | #{brand._id.toString().slice(-6).toUpperCase()}
                  td
                    if brand.description
                      span #{brand.description}
                    else
                      span.text-muted.fst-italic Sin descripción
                  td.text-center
                    if brand.isActive
                      span.badge.bg-success-subtle.text-success.px-3.py-2.rounded-pill.border.border-success-subtle
                        i.fas.fa-check-circle.me-1
                        | Activa
                    else
                      span.badge.bg-danger-subtle.text-danger.px-3.py-2.rounded-pill.border.border-danger-subtle
                        i.fas.fa-times-circle.me-1
                        | Inactiva
                  td
                    .d-flex.justify-content-center.gap-1
                      a.btn.btn-sm.btn-outline-primary.rounded-circle.action-btn(
                        href=`/brands/${brand._id}`
                        title="Ver detalle"
                      )
                        i.fas.fa-eye
                      a.btn.btn-sm.btn-outline-warning.rounded-circle.action-btn(
                        href=`/brands/${brand._id}/edit`
                        title="Editar"
                      )
                        i.fas.fa-pen
                      button.btn.btn-sm.btn-outline-danger.rounded-circle.action-btn.btn-delete-brand(
                        type="button"
                        title="Eliminar"
                        data-brand-id=brand._id
                        data-brand-name=brand.name
                      )
                        i.fas.fa-trash
            else
              tr#emptyRow
                td(colspan="4").text-center.py-5
                  .mb-3
                    i.fas.fa-trademark.fa-3x.text-muted.opacity-25
                  h5.text-muted.fw-semibold No hay marcas registradas
                  p.text-muted.mb-4 Comienza agregando tu primera marca
                  a.btn.btn-primary.rounded-pill.px-4(href="/brands/create")
                    i.fas.fa-plus-circle.me-1
                    | Crear Primera Marca

  //- ============================================
  //- MODAL CONFIRMAR ELIMINACIÓN
  //- ============================================
  .modal.fade#modalDeleteBrand(tabindex="-1")
    .modal-dialog.modal-dialog-centered
      .modal-content.rounded-4.border-0.shadow-lg

        .modal-header.bg-danger.text-white.rounded-top-4
          h5.modal-title
            i.fas.fa-exclamation-triangle.me-2
            | Eliminar Marca
          button.btn-close.btn-close-white(type="button" data-bs-dismiss="modal")

        .modal-body.p-4
          .text-center.mb-4
            .bg-danger.bg-opacity-10.rounded-circle.d-inline-flex.align-items-center.justify-content-center.mb-3(
              style="width: 80px; height: 80px;"
            )
              i.fas.fa-trash.text-danger.fa-2x

            h5.fw-bold.mb-2 ¿Estás seguro de eliminar esta marca?
            p.text-muted.mb-0
              | Se eliminará la marca 
              strong#deleteBrandName.text-primary -
              | . Esta acción no se puede deshacer.

          .alert.alert-warning.rounded-3.mb-0
            i.fas.fa-info-circle.me-2
            small
              strong Nota:
              |  Si la marca tiene productos asociados, no se podrá eliminar.

        .modal-footer.border-top-0.p-3
          button.btn.btn-outline-secondary.rounded-pill.px-4(
            type="button"
            data-bs-dismiss="modal"
          )
            i.fas.fa-times.me-1
            | Cancelar
          form#formDeleteBrand(method="POST" action="")
            input(type="hidden" name="_method" value="DELETE")
            button.btn.btn-danger.rounded-pill.px-4(
              type="submit"
              id="btnConfirmarDelete"
            )
              i.fas.fa-trash.me-1
              | Sí, eliminar

  //- ============================================
  //- ESTILOS
  //- ============================================
  style.
    .stat-card {
      transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .stat-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 12px 24px rgba(0,0,0,0.08) !important;
    }
    .stat-icon {
      width: 52px;
      height: 52px;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .brand-logo-wrapper {
      transition: all 0.2s ease;
    }
    .table tbody tr:hover .brand-logo-wrapper {
      border-color: #0d6efd !important;
      background: #f0f7ff !important;
    }

    .table th {
      font-weight: 600;
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      background: #f8fafc;
      color: #64748b;
      padding: 1rem 0.75rem;
      border-bottom: 2px solid #e2e8f0;
      white-space: nowrap;
    }
    .table td {
      vertical-align: middle;
      padding: 0.9rem 0.75rem;
    }
    .table tbody tr {
      transition: background 0.15s ease;
    }
    .table tbody tr:hover {
      background: #f8fafc;
    }

    .badge {
      font-size: 0.75rem;
      font-weight: 600;
      letter-spacing: 0.2px;
    }

    .action-btn {
      width: 34px;
      height: 34px;
      padding: 0;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      transition: all 0.2s ease;
    }
    .action-btn:hover {
      transform: scale(1.1);
    }

    .input-group-text {
      background-color: #fff !important;
    }
    .input-group:focus-within .input-group-text,
    .input-group:focus-within .form-control {
      border-color: #86b7fe;
      box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.1);
    }

    .form-select:focus, .form-control:focus {
      border-color: #86b7fe;
      box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.1);
    }

    @media (max-width: 768px) {
      .table-responsive {
        font-size: 0.85rem;
      }
      .stat-icon {
        width: 44px;
        height: 44px;
      }
      .brand-logo-wrapper {
        width: 40px !important;
        height: 40px !important;
      }
    }

  //- ============================================
  //- SCRIPT
  //- ============================================
  script.
    document.addEventListener('DOMContentLoaded', function() {
      const searchInput = document.getElementById('searchBrand');
      const filterStatus = document.getElementById('filterStatus');
      const table = document.getElementById('brandsTable');
      const resultsCount = document.getElementById('resultsCount');

      // ============================================
      // FILTROS
      // ============================================
      function filterTable() {
        const term = searchInput.value.toLowerCase().trim();
        const status = filterStatus.value;
        const rows = table.querySelectorAll('tbody tr');
        let visible = 0;

        rows.forEach(row => {
          if (row.id === 'emptyRow') return;

          const text = row.textContent.toLowerCase();
          const rowStatus = row.dataset.status || '';

          let show = text.includes(term);
          if (status) show = show && (rowStatus === status);

          row.style.display = show ? '' : 'none';
          if (show) visible++;
        });

        if (resultsCount) {
          resultsCount.textContent = visible + (visible === 1 ? ' resultado' : ' resultados');
        }
      }

      if (searchInput) searchInput.addEventListener('input', filterTable);
      if (filterStatus) filterStatus.addEventListener('change', filterTable);

      // ============================================
      // ELIMINAR MARCA
      // ============================================
      const modalEl = document.getElementById('modalDeleteBrand');
      const modalDelete = new bootstrap.Modal(modalEl);
      const deleteBrandName = document.getElementById('deleteBrandName');
      const formDeleteBrand = document.getElementById('formDeleteBrand');
      const btnConfirmarDelete = document.getElementById('btnConfirmarDelete');

      document.querySelectorAll('.btn-delete-brand').forEach(btn => {
        btn.addEventListener('click', function() {
          const brandId = this.dataset.brandId;
          const brandName = this.dataset.brandName;

          deleteBrandName.textContent = brandName;
          formDeleteBrand.action = `/brands/${brandId}?_method=DELETE`;

          modalDelete.show();
        });
      });

      if (formDeleteBrand) {
        formDeleteBrand.addEventListener('submit', function() {
          btnConfirmarDelete.disabled = true;
          btnConfirmarDelete.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Eliminando...';
        });
      }

      // Resetear estado del botón al cerrar el modal
      modalEl.addEventListener('hidden.bs.modal', function() {
        btnConfirmarDelete.disabled = false;
        btnConfirmarDelete.innerHTML = '<i class="fas fa-trash me-1"></i> Sí, eliminar';
      });
    });