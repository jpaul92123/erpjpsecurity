extends ../layouts/layout

block content

  //- ============================================
  //- HEADER DEL DASHBOARD
  //- ============================================
  .dashboard-header.mb-3.mb-md-4
    .d-flex.flex-wrap.justify-content-between.align-items-center.gap-2.gap-md-3

      div.min-w-0
        nav.d-none.d-md-block(aria-label="breadcrumb")
          ol.breadcrumb.mb-1
            li.breadcrumb-item
              a.text-decoration-none(href="/") Inicio
            li.breadcrumb-item.active(aria-current="page") Dashboard

        h1.h4.h3-md.fw-bold.mb-1.text-dark.text-truncate Panel de Control

        p.text-muted.mb-0.small.d-none.d-sm-block
          i.fas.fa-circle.text-success.me-1(style="font-size: 0.5rem;")
          | Sistema operativo · 
          = new Date().toLocaleDateString('es-ES', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' })

      .d-flex.align-items-center.gap-2.flex-shrink-0

        //- ⚙️ Configuración
        a.btn.btn-light.rounded-circle.shadow-sm.icon-btn(
          href="/settings"
          title="Configuración"
        )
          i.fas.fa-cog

        //- 🔔 Campana con dropdown de notificaciones
        .dropdown.notification-dropdown
          button.btn.btn-light.rounded-circle.shadow-sm.position-relative.icon-btn(
            type="button"
            data-bs-toggle="dropdown"
            data-bs-auto-close="outside"
            aria-expanded="false"
            title="Notificaciones"
          )
            i.fas.fa-bell
            span.badge.rounded-pill.bg-danger.position-absolute#notificationBadge(
              class=(pendingOrdersCount > 0 ? '' : 'd-none')
              style="top: -2px; right: -2px; font-size: 0.6rem; padding: 3px 5px;"
            )= pendingOrdersCount || 0

          ul.dropdown-menu.dropdown-menu-end.shadow-lg.rounded-3.border-0.p-0.notif-menu
            li.px-3.py-3.border-bottom.d-flex.justify-content-between.align-items-center
              div
                h6.mb-0.fw-bold
                  i.fas.fa-bell.me-2.text-primary
                  | Notificaciones
                small.text-muted#notifSubtitle
                  = pendingOrdersCount + ' pedidos pendientes'
              button.btn.btn-sm.btn-link.text-decoration-none.p-0#markAllRead(
                type="button"
                title="Marcar todas como leídas"
              )
                i.fas.fa-check-double

            li
              #notificationList.notif-list
                if pendingOrders && pendingOrders.length
                  each order in pendingOrders
                    a.dropdown-item.d-flex.align-items-start.gap-3.py-3.border-bottom.text-wrap(
                      href=`/orders/${order._id}`
                      style="white-space: normal;"
                    )
                      .rounded-circle.bg-warning-subtle.text-warning.d-flex.align-items-center.justify-content-center.flex-shrink-0(
                        style="width: 42px; height: 42px;"
                      )
                        i.fas.fa-shopping-bag
                      div.flex-grow-1.min-w-0
                        div.d-flex.justify-content-between.align-items-center.mb-1.gap-2
                          span.fw-bold.text-primary.text-truncate= order.orderNumber
                          small.text-muted.flex-shrink-0
                            = new Date(order.createdAt).toLocaleTimeString('es-ES', { hour: '2-digit', minute: '2-digit' })
                        div.small.fw-semibold.text-truncate= order.customer.name
                        div.small.text-muted.text-truncate
                          = order.customer.phone + ' · S/. ' + order.total.toFixed(2)
                        div.small.text-muted
                          i.fas.fa-box.me-1
                          = order.items.length + ' producto' + (order.items.length !== 1 ? 's' : '')

                  li.px-3.py-2.text-center.border-top
                    a.btn.btn-sm.btn-link.text-decoration-none.fw-semibold(
                      href="/orders?status=pendiente"
                    )
                      | Ver todos los pedidos pendientes
                      i.fas.fa-arrow-right.ms-1
                else
                  li.text-center.py-5.text-muted
                    i.fas.fa-bell-slash.fa-3x.mb-3.opacity-25.d-block
                    p.mb-0 No hay pedidos pendientes

        //- 🛒 Tienda pública
        a.btn.btn-light.rounded-circle.shadow-sm.icon-btn(
          href="/landing"
          target="_blank"
          title="Ver tienda"
        )
          i.fas.fa-store

  //- ============================================
  //- TARJETA DE BIENVENIDA
  //- ============================================
  .row.mb-3.mb-md-4
    .col-12
      .welcome-card.p-3.p-md-4.rounded-4.shadow-sm.position-relative.overflow-hidden
        .row.align-items-center.position-relative(style="z-index: 2;")
          .col-lg-8
            .d-flex.align-items-center.mb-2.mb-md-3
              .avatar-circle-lg.bg-white.text-primary.me-3.flex-shrink-0
                i.fas.fa-user.fa-lg
              div.min-w-0
                h4.fw-bold.mb-0.text-truncate ¡Hola, #{user.name}!

          .col-lg-4.d-none.d-lg-flex.justify-content-end
            i.fas.fa-shield-alt.welcome-icon

  //- ============================================
  //- ALERTA DE PEDIDOS PENDIENTES
  //- ============================================
  if pendingOrdersCount > 0
    .row.mb-3.mb-md-4
      .col-12
        .alert.alert-warning.border-0.shadow-sm.rounded-3.d-flex.align-items-center.justify-content-between.flex-wrap.gap-2.p-3
          .d-flex.align-items-center.gap-3.min-w-0
            .rounded-circle.bg-warning.text-white.d-flex.align-items-center.justify-content-center.flex-shrink-0(
              style="width: 44px; height: 44px; font-size: 1.2rem;"
            )
              i.fas.fa-bell.animate-ring
            div.min-w-0
              h6.mb-1.fw-bold.text-dark.mb-0
                | ¡Tienes #{pendingOrdersCount} pedido#{pendingOrdersCount !== 1 ? 's' : ''} pendiente#{pendingOrdersCount !== 1 ? 's' : ''}!
              small.text-muted.d-block Los clientes esperan confirmación.
          a.btn.btn-warning.rounded-pill.px-3.px-md-4.text-dark.fw-bold.w-100.w-sm-auto(
            href="/orders?status=pendiente"
          )
            i.fas.fa-eye.me-1
            | Ver pedidos

  //- ============================================
  //- ESTADÍSTICAS
  //- ============================================
  .row.g-2.g-md-3.mb-3.mb-md-4.stats-mobile
    .col-6.col-lg-3
      .card.stat-card.border-0.shadow-sm.h-100
        .card-body.p-2.p-md-3
          .d-flex.justify-content-between.align-items-start.mb-2
            .stat-icon.bg-primary-subtle.text-primary
              i.fas.fa-users
            span.badge.bg-success-subtle.text-success.rounded-pill.d-none.d-sm-inline-flex
              i.fas.fa-arrow-up.me-1
              | 12%
          h3.fw-bold.mb-1 #{totalUsers || 0}
          p.text-muted.small.mb-0 Usuarios

    .col-6.col-lg-3
      .card.stat-card.border-0.shadow-sm.h-100
        .card-body.p-2.p-md-3
          .d-flex.justify-content-between.align-items-start.mb-2
            .stat-icon.bg-success-subtle.text-success
              i.fas.fa-building
            span.badge.bg-success-subtle.text-success.rounded-pill.d-none.d-sm-inline-flex
              i.fas.fa-arrow-up.me-1
              | 8%
          h3.fw-bold.mb-1 #{totalClients || 0}
          p.text-muted.small.mb-0 Clientes

    .col-6.col-lg-3
      .card.stat-card.border-0.shadow-sm.h-100
        .card-body.p-2.p-md-3
          .d-flex.justify-content-between.align-items-start.mb-2
            .stat-icon.bg-warning-subtle.text-warning
              i.fas.fa-box
            span.badge.bg-danger-subtle.text-danger.rounded-pill.d-none.d-sm-inline-flex
              i.fas.fa-arrow-down.me-1
              | 3%
          h3.fw-bold.mb-1 #{totalProducts || 0}
          p.text-muted.small.mb-0 Productos

    .col-6.col-lg-3
      .card.stat-card.border-0.shadow-sm.h-100(
        class=(pendingOrdersCount > 0 ? 'border-warning' : '')
      )
        .card-body.p-2.p-md-3
          .d-flex.justify-content-between.align-items-start.mb-2
            .stat-icon.bg-warning-subtle.text-warning
              i.fas.fa-shopping-bag
            if pendingOrdersCount > 0
              span.badge.bg-danger-subtle.text-danger.rounded-pill.d-none.d-sm-inline-flex
                i.fas.fa-exclamation-circle.me-1
                | Nuevos
            else
              span.badge.bg-success-subtle.text-success.rounded-pill.d-none.d-sm-inline-flex
                i.fas.fa-check.me-1
                | Al día
          h3.fw-bold.mb-1 #{pendingOrdersCount || 0}
          p.text-muted.small.mb-0 Pendientes

  //- ============================================
  //- CARRUSEL DE MARCAS
  //- ============================================
  if brands && brands.length
    .row.mb-3.mb-md-4
      .col-12
        .card.border-0.shadow-sm.rounded-3.overflow-hidden.brands-carousel-card
          .card-header.bg-white.border-bottom.py-3.d-flex.justify-content-between.align-items-center
            h6.mb-0.fw-bold
              i.fas.fa-bookmark.me-2.text-primary
              | Nuestras Marcas
              span.badge.bg-primary-subtle.text-primary.ms-2 #{brands.length}
            a.btn.btn-sm.btn-link.text-decoration-none.fw-semibold(href="/brands")
              | Ver todas
              i.fas.fa-arrow-right.ms-1

          .card-body.p-0
            .brands-marquee
              .brands-marquee-inner
                each brand in brands
                  a.brand-chip(href=`/brands/${brand._id}` title=brand.name)
                    .brand-chip-logo
                      if brand.logo && !brand.logo.includes('default')
                        img(src=brand.logo alt=brand.name loading="lazy" onerror="this.style.display='none'; this.parentElement.classList.add('no-logo');")
                      else
                        i.fas.fa-bookmark
                    .brand-chip-info
                      span.brand-chip-name= brand.name
                each brand in brands
                  a.brand-chip(href=`/brands/${brand._id}` title=brand.name)
                    .brand-chip-logo
                      if brand.logo && !brand.logo.includes('default')
                        img(src=brand.logo alt=brand.name loading="lazy" onerror="this.style.display='none'; this.parentElement.classList.add('no-logo');")
                      else
                        i.fas.fa-bookmark
                    .brand-chip-info
                      span.brand-chip-name= brand.name
  else
    .row.mb-3.mb-md-4
      .col-12
        .alert.alert-info.rounded-3.text-center.border-0.shadow-sm
          i.fas.fa-info-circle.me-2
          | No hay marcas activas. 
          a.alert-link(href="/brands/create") Crea la primera aquí

  //- ============================================
  //- PEDIDOS RECIENTES + VENTAS DEL DÍA
  //- ============================================
  .row.g-3.mb-3.mb-md-4
    .col-12.col-lg-7
      .card.border-0.shadow-sm.rounded-3.h-100
        .card-header.bg-transparent.border-0.py-3.d-flex.justify-content-between.align-items-center
          h6.mb-0.fw-bold
            i.fas.fa-history.me-2.text-primary
            | Pedidos recientes
          a.btn.btn-sm.btn-link.text-decoration-none.fw-semibold(href="/orders")
            | Ver todos
            i.fas.fa-arrow-right.ms-1

        .card-body.pt-0
          if pendingOrders && pendingOrders.length
            .table-responsive
              table.table.table-sm.table-hover.align-middle.mb-0
                tbody
                  each order in pendingOrders.slice(0, 5)
                    tr
                      td
                        a.fw-bold.text-primary.text-decoration-none(href=`/orders/${order._id}`)= order.orderNumber
                      td.d-none.d-sm-table-cell
                        div.small.fw-semibold= order.customer.name
                        small.text-muted= order.customer.phone
                      td.d-sm-none
                        div.small.fw-semibold.text-truncate(style="max-width:110px;")= order.customer.name
                      td.text-end
                        span.fw-bold.text-primary S/. #{order.total.toFixed(2)}
                      td.text-end.d-none.d-md-table-cell
                        span.badge.bg-warning-subtle.text-warning.rounded-pill
                          i.fas.fa-clock-o.me-1
                          | Pendiente
          else
            .text-center.py-4.text-muted
              i.fas.fa-check-circle.fa-3x.mb-3.opacity-25.d-block.text-success
              p.mb-0 No hay pedidos pendientes

    .col-12.col-lg-5
      .card.border-0.shadow-sm.rounded-3.h-100
        .card-header.bg-transparent.border-0.py-3
          h6.mb-0.fw-bold
            i.fas.fa-line-chart.me-2.text-success
            | Ventas de hoy

        .card-body.pt-0
          .text-center.py-3
            .display-6.fw-bold.text-success.mb-2
              | S/. #{todaySalesTotal.toFixed(2)}
            p.text-muted.mb-3.mb-2
              = todaySalesCount
              |  pedido#{todaySalesCount !== 1 ? 's' : ''} registrado#{todaySalesCount !== 1 ? 's' : ''}
          .d-grid
            a.btn.btn-outline-success.rounded-pill(href="/orders?from=" + new Date().toISOString().split('T')[0])
              i.fas.fa-list.me-1
              | Ver pedidos de hoy

  //- ============================================
  //- MÓDULOS DEL SISTEMA
  //- ============================================
  .row.mb-3
    .col-12
      h5.fw-bold.mb-0
        i.fas.fa-th-large.me-2.text-primary
        | Módulos del Sistema

  //- ============================================
  //- MIXIN
  //- ============================================
  mixin moduleCard(href, icon, label, color, category)
    .col-6.col-md-4.col-lg-3.col-xl-2.module-item(data-category=category)
      a.module-card.card.text-decoration-none.border-0.shadow-sm.h-100(href=href, class=`module-${color}`)
        .card-body.p-3.d-flex.flex-column.align-items-center.justify-content-center.text-center.gap-2
          .module-icon-lg
            i(class=icon)
          .w-100.min-w-0
            .module-label.fw-bold.text-truncate= label
            small.text-muted.module-sub.d-block= category

  //- ============================================
  //- SEGURIDAD
  //- ============================================
  .row.mb-2
    .col-12
      .d-flex.align-items-center.mb-2
        span.badge.bg-primary-subtle.text-primary.me-2
          i.fas.fa-shield.me-1
          | Seguridad
        .flex-grow-1.border-bottom
  .row.g-2.g-md-3.mb-3.mb-md-4
    +moduleCard('/users', 'fas.fa-users', 'Usuarios', 'indigo', 'Seguridad')
    +moduleCard('/clients', 'fas.fa-building', 'Clientes', 'success', 'Seguridad')
    +moduleCard('/suppliers', 'fas.fa-handshake', 'Proveedores', 'teal', 'Seguridad')

  //- ============================================
  //- INVENTARIO
  //- ============================================
  .row.mb-2
    .col-12
      .d-flex.align-items-center.mb-2
        span.badge.bg-warning-subtle.text-warning.me-2
          i.fas.fa-archive.me-1
          | Inventario
        .flex-grow-1.border-bottom
  .row.g-2.g-md-3.mb-3.mb-md-4
    +moduleCard('/products', 'fas.fa-cube', 'Productos', 'danger', 'Inventario')
    +moduleCard('/categories', 'fas.fa-tags', 'Categorías', 'purple', 'Inventario')
    +moduleCard('/brands', 'fas.fa-bookmark', 'Marcas', 'slate', 'Inventario')
    +moduleCard('/warehouses', 'fas.fa-home', 'Almacenes', 'amber', 'Inventario')

  //- ============================================
  //- VENTAS
  //- ============================================
  .row.mb-2
    .col-12
      .d-flex.align-items-center.mb-2
        span.badge.bg-success-subtle.text-success.me-2
          i.fas.fa-shopping-cart.me-1
          | Ventas
        .flex-grow-1.border-bottom
  .row.g-2.g-md-3.mb-3.mb-md-4
    +moduleCard('/quotations', 'fas.fa-file-text', 'Cotizaciones', 'blue', 'Ventas')
    +moduleCard('/orders', 'fas.fa-list', 'Pedidos', 'orange', 'Ventas')
    +moduleCard('/sales', 'fas.fa-shopping-bag', 'Ventas', 'emerald', 'Ventas')
    +moduleCard('/vouchers', 'fas.fa-file', 'Comprobantes', 'rose', 'Ventas')

  //- ============================================
  //- SERVICIOS
  //- ============================================
  .row.mb-2
    .col-12
      .d-flex.align-items-center.mb-2
        span.badge.bg-info-subtle.text-info.me-2
          i.fas.fa-wrench.me-1
          | Servicios
        .flex-grow-1.border-bottom
  .row.g-2.g-md-3.mb-3.mb-md-4
    +moduleCard('/installations', 'fas.fa-cogs', 'Instalaciones', 'cyan', 'Servicios')
    +moduleCard('/maintenances', 'fas.fa-refresh', 'Mantenimientos', 'amber', 'Servicios')
    +moduleCard('/visits', 'fas.fa-calendar', 'Visitas', 'teal', 'Servicios')
    +moduleCard('/work-orders', 'fas.fa-check-square', 'Órdenes Trabajo', 'red', 'Servicios')
    +moduleCard('/projects', 'fas.fa-folder-open', 'Proyectos', 'violet', 'Servicios')

  //- ============================================
  //- ANALÍTICA
  //- ============================================
  .row.mb-2
    .col-12
      .d-flex.align-items-center.mb-2
        span.badge.bg-secondary-subtle.text-secondary.me-2
          i.fas.fa-bar-chart.me-1
          | Analítica
        .flex-grow-1.border-bottom
  .row.g-2.g-md-3.mb-3.mb-md-4
    +moduleCard('/reports/sales', 'fas.fa-line-chart', 'Reportes', 'indigo', 'Reportes')

  //- ============================================
  //- SISTEMA
  //- ============================================
  .row.mb-2
    .col-12
      .d-flex.align-items-center.mb-2
        span.badge.bg-dark-subtle.text-dark.me-2
          i.fas.fa-cog.me-1
          | Sistema
        .flex-grow-1.border-bottom
  .row.g-2.g-md-3.mb-3.mb-md-4
    +moduleCard('/settings', 'fas.fa-cog', 'Configuración', 'slate', 'Sistema')
    +moduleCard('/about/admin', 'fas.fa-info-circle', 'Nosotros', 'slate', 'Sistema')

  //- ============================================
  //- CTA LANDING
  //- ============================================
  .row.mt-3.mb-4
    .col-12
      .card.border-0.shadow-sm.rounded-4.overflow-hidden
        .card-body.p-3.p-md-4.cta-landing
          .d-flex.flex-wrap.justify-content-between.align-items-center.gap-3
            div.min-w-0
              h5.fw-bold.mb-1
                i.fas.fa-store.me-2.text-primary
                | Tienda en línea
              p.text-muted.mb-0.small Muestra tu catálogo de productos a tus clientes
            a.btn.btn-primary.rounded-pill.px-4.w-100.w-sm-auto(href="/landing" target="_blank")
              | Visitar Landing
              i.fas.fa-external-link.ms-2

  //- ============================================
  //- ESTILOS
  //- ============================================
  style.
    /* ==== CORRECCIÓN ANTI-DESBORDE EN MÓVIL ==== */
    html, body { overflow-x: hidden !important; max-width: 100vw; }
    .dashboard-header, .row, .card, .container, .container-fluid { min-width: 0; }
    .card-body { min-width: 0; }
    .table-responsive { -webkit-overflow-scrolling: touch; }

    /* Iconos del header (botones circulares) */
    .icon-btn {
      width: 42px; height: 42px;
      display: inline-flex; align-items: center; justify-content: center;
      flex-shrink: 0;
    }
    @media (max-width: 575.98px) {
      .icon-btn { width: 38px; height: 38px; font-size: 0.9rem; }
    }

    /* Dropdown de notificaciones responsive */
    .notif-menu {
      min-width: 0;
      width: min(360px, calc(100vw - 24px)) !important;
    }
    @media (max-width: 575.98px) {
      .notification-dropdown .dropdown-menu {
        position: fixed !important;
        top: 60px !important;
        left: 12px !important;
        right: 12px !important;
        width: auto !important;
      }
    }
    .notif-list { max-height: 400px; overflow-y: auto; }
    .notification-dropdown .dropdown-menu { padding: 0; }
    .notification-dropdown .dropdown-item:last-child { border-bottom: none; }
    .notification-dropdown .dropdown-item:hover { background: #f8fafc; }

    .animate-ring {
      animation: ring 2s ease-in-out infinite;
      transform-origin: top center;
    }
    @keyframes ring {
      0%, 100% { transform: rotate(0); }
      10%, 30%, 50%, 70%, 90% { transform: rotate(-10deg); }
      20%, 40%, 60%, 80% { transform: rotate(10deg); }
    }

    .stat-card.border-warning {
      border: 2px solid #f59e0b !important;
      animation: pulse-warning 2s ease-in-out infinite;
    }
    @keyframes pulse-warning {
      0%, 100% { box-shadow: 0 0 0 0 rgba(245, 158, 11, 0.4); }
      50% { box-shadow: 0 0 0 8px rgba(245, 158, 11, 0); }
    }

    /* ==== TOAST RESPONSIVE ==== */
    .notification-toast {
      position: fixed;
      bottom: 16px;
      right: 12px;
      left: 12px;
      max-width: 380px;
      margin-left: auto;
      background: white;
      border-radius: 12px;
      box-shadow: 0 8px 32px rgba(0,0,0,0.15);
      padding: 16px;
      z-index: 9999;
      border-left: 4px solid #f59e0b;
      animation: slideInRight 0.35s ease;
    }
    @media (min-width: 576px) {
      .notification-toast { left: auto; right: 24px; }
    }
    @keyframes slideInRight {
      from { transform: translateX(120%); opacity: 0; }
      to { transform: translateX(0); opacity: 1; }
    }

    /* ==== CARRUSEL DE MARCAS ==== */
    .brands-carousel-card { background: linear-gradient(135deg, #ffffff 0%, #f8fafc 100%); }
    .brands-marquee {
      position: relative; overflow: hidden; padding: 20px 0;
      background: white; width: 100%;
    }
    .brands-marquee::before, .brands-marquee::after {
      content: ''; position: absolute; top: 0; bottom: 0; width: 60px;
      z-index: 2; pointer-events: none;
    }
    .brands-marquee::before { left: 0; background: linear-gradient(to right, white 0%, rgba(255,255,255,0) 100%); }
    .brands-marquee::after { right: 0; background: linear-gradient(to left, white 0%, rgba(255,255,255,0) 100%); }
    .brands-marquee-inner {
      display: flex; gap: 14px; width: max-content;
      animation: brands-scroll 30s linear infinite;
      will-change: transform; padding: 0 20px;
    }
    .brands-marquee:hover .brands-marquee-inner { animation-play-state: paused; }
    @keyframes brands-scroll {
      0% { transform: translate3d(0, 0, 0); }
      100% { transform: translate3d(-50%, 0, 0); }
    }

    .brand-chip {
      display: flex; align-items: center; gap: 10px;
      padding: 10px 18px 10px 10px;
      background: #ffffff; border: 1.5px solid #e2e8f0;
      border-radius: 999px; text-decoration: none;
      transition: all 0.3s ease; flex-shrink: 0;
      min-width: 130px; max-width: 200px;
    }
    .brand-chip-logo {
      width: 38px; height: 38px; border-radius: 50%;
      background: #f1f5f9; display: flex; align-items: center; justify-content: center;
      overflow: hidden; flex-shrink: 0; color: #64748b; font-size: 16px;
      transition: all 0.3s ease;
    }
    .brand-chip:hover .brand-chip-logo { background: #dbeafe; color: #0d6efd; }
    .brand-chip-logo img { width: 100%; height: 100%; object-fit: contain; padding: 4px; }
    .brand-chip-logo.no-logo::before {
      content: '\f02b'; font-family: 'Font Awesome 6 Free'; font-weight: 900;
    }
    .brand-chip-info { display: flex; flex-direction: column; min-width: 0; flex: 1; }
    .brand-chip-name {
      font-size: 13px; font-weight: 700; color: #1e293b;
      white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
      transition: color 0.3s ease;
    }
    .brand-chip:hover .brand-chip-name { color: #0d6efd; }

    /* ==== MÓDULOS CON ICONOS GRANDES (estilo app) ==== */
    .module-card {
      transition: all 0.25s ease;
      border-radius: 16px;
      overflow: hidden;
    }
    .module-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 12px 28px rgba(0,0,0,0.10) !important;
    }
    .module-icon-lg {
      width: 56px;
      height: 56px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: 16px;
      font-size: 1.5rem;
      flex-shrink: 0;
      transition: all 0.25s ease;
    }
    .module-card:hover .module-icon-lg {
      transform: scale(1.08);
    }
    .module-label {
      font-size: 0.85rem;
      line-height: 1.2;
      color: #1e293b;
    }
    .module-sub {
      font-size: 0.68rem;
      text-transform: capitalize;
      margin-top: 2px;
    }

    /* Colores de fondo de los iconos grandes */
    .module-indigo   .module-icon-lg { background: #e0e7ff; color: #4f46e5; }
    .module-success  .module-icon-lg { background: #dcfce7; color: #16a34a; }
    .module-teal     .module-icon-lg { background: #ccfbf1; color: #0d9488; }
    .module-danger   .module-icon-lg { background: #fee2e2; color: #dc2626; }
    .module-purple   .module-icon-lg { background: #f3e8ff; color: #9333ea; }
    .module-slate    .module-icon-lg { background: #e2e8f0; color: #475569; }
    .module-amber    .module-icon-lg { background: #fef3c7; color: #d97706; }
    .module-blue     .module-icon-lg { background: #dbeafe; color: #2563eb; }
    .module-orange   .module-icon-lg { background: #ffedd5; color: #ea580c; }
    .module-emerald  .module-icon-lg { background: #d1fae5; color: #059669; }
    .module-rose     .module-icon-lg { background: #ffe4e6; color: #e11d48; }
    .module-cyan     .module-icon-lg { background: #cffafe; color: #0891b2; }
    .module-red      .module-icon-lg { background: #fee2e2; color: #dc2626; }
    .module-violet   .module-icon-lg { background: #ede9fe; color: #7c3aed; }

    /* ==== MÓVIL: módulos como app ==== */
    @media (max-width: 767.98px) {
      .module-icon-lg { width: 64px; height: 64px; font-size: 1.7rem; border-radius: 18px; }
      .module-label { font-size: 0.78rem; }
      .module-sub { display: none; }
      .brand-chip { padding: 8px 14px 8px 8px; min-width: 110px; gap: 8px; }
      .brand-chip-logo { width: 32px; height: 32px; font-size: 14px; }
      .brand-chip-name { font-size: 12px; }
      .brands-marquee-inner { animation-duration: 20s; }
      .brands-marquee::before, .brands-marquee::after { width: 30px; }
      .stat-card h3 { font-size: 1.4rem; }
    }

    /* ==== FAB FLOTANTE DE NOTIFICACIONES (móvil) ==== */
    .notif-fab {
      position: fixed; right: 16px; bottom: 88px;
      width: 56px; height: 56px; border-radius: 50%; border: none;
      background: linear-gradient(135deg, #f59e0b, #d97706); color: #fff;
      display: none; align-items: center; justify-content: center; font-size: 1.35rem;
      box-shadow: 0 8px 24px rgba(245, 158, 11, 0.45); z-index: 1050; animation: fab-pop 0.35s ease;
    }
    .notif-fab.show { display: inline-flex; }
    .notif-fab:active { transform: scale(0.94); }
    .notif-fab .fab-badge {
      position: absolute; top: -4px; right: -4px; min-width: 22px; height: 22px;
      padding: 0 6px; border-radius: 999px; background: #dc2626; color: #fff;
      font-size: 0.7rem; font-weight: 700; display: flex; align-items: center; justify-content: center; border: 2px solid #fff;
    }
    @keyframes fab-pop {
      0%   { transform: scale(0); opacity: 0; }
      70%  { transform: scale(1.12); }
      100% { transform: scale(1); opacity: 1; }
    }
    @media (max-width: 575.98px) {
      .notification-toast { bottom: 156px !important; }
    }

  //- ============================================
  //- FAB FLOTANTE
  //- ============================================
  button.notif-fab#notifFab(
    type="button"
    class=(pendingOrdersCount > 0 ? 'show' : '')
    title="Notificaciones"
  )
    i.fas.fa-bell.animate-ring
    span.fab-badge#fabBadge= pendingOrdersCount || 0

  //- ============================================
  //- SCRIPT
  //- ============================================
  script.
    document.addEventListener('DOMContentLoaded', function() {

      /* ---------- BUSCADOR DE MÓDULOS ---------- */
      var searchInput = document.getElementById('moduleSearch');
      var items = document.querySelectorAll('.module-item');
      var sectionRows = document.querySelectorAll('.row.mb-2');

      if (searchInput) {
        searchInput.addEventListener('input', function(e) {
          var term = e.target.value.toLowerCase().trim();
          items.forEach(function(item) {
            var labelEl = item.querySelector('.module-label');
            var label = labelEl ? labelEl.textContent.toLowerCase() : '';
            var category = (item.dataset.category || '').toLowerCase();
            var match = label.indexOf(term) !== -1 || category.indexOf(term) !== -1;
            item.style.display = (match || !term) ? '' : 'none';
          });
          sectionRows.forEach(function(row) {
            if (!term) { row.style.display = ''; return; }
            var nextRow = row.nextElementSibling;
            if (nextRow && nextRow.classList.contains('row')) {
              var visible = nextRow.querySelectorAll('.module-item:not([style*="display: none"])').length;
              row.style.display = visible > 0 ? '' : 'none';
              nextRow.style.display = visible > 0 ? '' : 'none';
            }
          });
        });

        document.addEventListener('keydown', function(e) {
          if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
            e.preventDefault();
            searchInput.focus();
          }
        });
      }

      /* ---------- NOTIFICACIONES ---------- */
      var notificationBadge = document.getElementById('notificationBadge');
      var notificationList  = document.getElementById('notificationList');
      var notifSubtitle     = document.getElementById('notifSubtitle');
      var notifFab          = document.getElementById('notifFab');
      var fabBadge          = document.getElementById('fabBadge');
      var lastPendingCount = #{pendingOrdersCount || 0};

      function renderNotifications(data) {
        if (!notificationList) return;
        var count = data.pendingOrdersCount || 0;

        if (notificationBadge) {
          notificationBadge.textContent = count;
          notificationBadge.classList.toggle('d-none', count === 0);
        }
        if (notifFab && fabBadge) {
          fabBadge.textContent = count;
          notifFab.classList.toggle('show', count > 0);
        }
        if (notifSubtitle) {
          notifSubtitle.textContent = count + ' pedidos pendientes';
        }

        if (data.pendingOrders && data.pendingOrders.length > 0) {
          notificationList.innerHTML = data.pendingOrders.map(function(order) {
            return '<a class="dropdown-item d-flex align-items-start gap-3 py-3 border-bottom text-wrap" href="/orders/' + order._id + '" style="white-space: normal;">' +
              '<div class="rounded-circle bg-warning-subtle text-warning d-flex align-items-center justify-content-center flex-shrink-0" style="width: 42px; height: 42px;">' +
                '<i class="fas fa-shopping-bag"></i>' +
              '</div>' +
              '<div class="flex-grow-1 min-w-0">' +
                '<div class="d-flex justify-content-between align-items-center mb-1 gap-2">' +
                  '<span class="fw-bold text-primary text-truncate">' + order.orderNumber + '</span>' +
                  '<small class="text-muted flex-shrink-0">' + new Date(order.createdAt).toLocaleTimeString('es-ES', { hour: '2-digit', minute: '2-digit' }) + '</small>' +
                '</div>' +
                '<div class="small fw-semibold text-truncate">' + order.customerName + '</div>' +
                '<div class="small text-muted text-truncate">' + order.customerPhone + ' · S/. ' + order.total.toFixed(2) + '</div>' +
                '<div class="small text-muted"><i class="fas fa-box me-1"></i>' + order.itemsCount + ' producto' + (order.itemsCount !== 1 ? 's' : '') + '</div>' +
              '</div>' +
            '</a>';
          }).join('') +
          '<li class="px-3 py-2 text-center border-top">' +
            '<a class="btn btn-sm btn-link text-decoration-none fw-semibold" href="/orders?status=pendiente">' +
              'Ver todos los pedidos pendientes <i class="fas fa-arrow-right ms-1"></i>' +
            '</a>' +
          '</li>';
        } else {
          notificationList.innerHTML =
            '<li class="text-center py-5 text-muted">' +
              '<i class="fas fa-bell-slash fa-3x mb-3 opacity-25 d-block"></i>' +
              '<p class="mb-0">No hay pedidos pendientes</p>' +
            '</li>';
        }
      }

      function checkNotifications() {
        fetch('/api/notifications')
          .then(function(r) { return r.json(); })
          .then(function(data) {
            if (!data.success) return;
            var newPendingCount = data.pendingOrdersCount || 0;
            if (newPendingCount > lastPendingCount) {
              showNotificationToast(data.pendingOrders[0]);
              playNotificationSound();
            }
            lastPendingCount = newPendingCount;
            renderNotifications(data);
          })
          .catch(function(err) { console.error('Error:', err); });
      }

      setInterval(checkNotifications, 30000);

      function showNotificationToast(order) {
        if (!order) return;
        var toast = document.createElement('div');
        toast.className = 'notification-toast';
        toast.innerHTML =
          '<div class="d-flex align-items-start gap-3">' +
            '<div class="rounded-circle bg-warning text-white d-flex align-items-center justify-content-center flex-shrink-0" style="width: 48px; height: 48px; font-size: 1.3rem;">' +
              '<i class="fas fa-bell animate-ring"></i>' +
            '</div>' +
            '<div class="flex-grow-1 min-w-0">' +
              '<div class="d-flex justify-content-between align-items-center mb-1">' +
                '<strong class="text-dark">¡Nuevo pedido!</strong>' +
                '<button type="button" class="btn-close btn-sm" onclick="this.closest(\'.notification-toast\').remove()"></button>' +
              '</div>' +
              '<div class="small fw-semibold text-primary text-truncate">' + order.orderNumber + '</div>' +
              '<div class="small text-muted text-truncate">' + order.customerName + '</div>' +
              '<div class="small text-muted mb-2">S/. ' + order.total.toFixed(2) + '</div>' +
              '<a href="/orders/' + order._id + '" class="btn btn-sm btn-warning rounded-pill fw-semibold">Ver pedido</a>' +
            '</div>' +
          '</div>';
        document.body.appendChild(toast);
        setTimeout(function() {
          if (toast.parentNode) {
            toast.style.opacity = '0';
            toast.style.transform = 'translateX(120%)';
            setTimeout(function() { toast.remove(); }, 300);
          }
        }, 10000);
      }

      function playNotificationSound() {
        try {
          var audioCtx = new (window.AudioContext || window.webkitAudioContext)();
          var oscillator = audioCtx.createOscillator();
          var gainNode = audioCtx.createGain();
          oscillator.connect(gainNode);
          gainNode.connect(audioCtx.destination);
          oscillator.frequency.value = 800;
          oscillator.type = 'sine';
          gainNode.gain.setValueAtTime(0.1, audioCtx.currentTime);
          gainNode.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.5);
          oscillator.start(audioCtx.currentTime);
          oscillator.stop(audioCtx.currentTime + 0.5);
        } catch (e) {
          console.log('No se pudo reproducir sonido:', e);
        }
      }

      var markAllReadBtn = document.getElementById('markAllRead');
      if (markAllReadBtn) {
        markAllReadBtn.addEventListener('click', function() {
          if (notificationBadge) notificationBadge.classList.add('d-none');
          if (notifFab) notifFab.classList.remove('show');
          this.innerHTML = '<i class="fas fa-check-double text-success"></i>';
        });
      }

      if (notifFab) {
        notifFab.addEventListener('click', function() {
          var trigger = document.querySelector('.notification-dropdown [data-bs-toggle="dropdown"]');
          if (trigger && window.bootstrap) {
            bootstrap.Dropdown.getOrCreateInstance(trigger).toggle();
          } else {
            window.location.href = '/orders?status=pendiente';
          }
        });
      }
    });