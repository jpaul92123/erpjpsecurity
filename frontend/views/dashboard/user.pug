extends ../layouts/layout

block content

  //- ============================================
  //- HEADER
  //- ============================================
  .dashboard-header.mb-3.mb-md-4
    .d-flex.flex-wrap.justify-content-between.align-items-center.gap-2.gap-md-3
      div.min-w-0
        nav.d-none.d-md-block(aria-label="breadcrumb")
          ol.breadcrumb.mb-1
            li.breadcrumb-item
              a.text-decoration-none(href="/") Inicio
            li.breadcrumb-item.active(aria-current="page") Dashboard
        h1.h4.h3-md.fw-bold.mb-1.text-dark.text-truncate Panel de Control
        p.text-muted.mb-0.small.d-none.d-sm-block
          i.fas.fa-circle.text-success.me-1(style="font-size: 0.5rem;")
          | Sistema operativo · 
          = new Date().toLocaleDateString('es-ES', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' })

      .d-flex.align-items-center.gap-2.flex-shrink-0
        .dropdown.notification-dropdown
          button.btn.btn-light.rounded-circle.shadow-sm.position-relative.icon-btn(
            type="button"
            data-bs-toggle="dropdown"
            data-bs-auto-close="outside"
            aria-expanded="false"
            title="Notificaciones"
          )
            i.fas.fa-bell
            span.badge.rounded-pill.bg-danger.position-absolute#notificationBadge(
              class=(pendingOrdersCount > 0 ? '' : 'd-none')
              style="top: -2px; right: -2px; font-size: 0.6rem; padding: 3px 5px;"
            )= pendingOrdersCount || 0
          ul.dropdown-menu.dropdown-menu-end.shadow-lg.rounded-3.border-0.p-0.notif-menu
            li.px-3.py-3.border-bottom
              h6.mb-0.fw-bold
                i.fas.fa-bell.me-2.text-primary
                | Notificaciones
              small.text-muted#notifSubtitle
                = pendingOrdersCount + ' pedidos pendientes'
            li
              #notificationList.notif-list
                if pendingOrders && pendingOrders.length
                  each order in pendingOrders
                    a.dropdown-item.d-flex.align-items-start.gap-3.py-3.border-bottom.text-wrap(href=`/orders/${order._id}`)
                      .rounded-circle.bg-warning-subtle.text-warning.d-flex.align-items-center.justify-content-center.flex-shrink-0(style="width: 42px; height: 42px;")
                        i.fas.fa-shopping-bag
                      div.flex-grow-1.min-w-0
                        div.small.fw-bold.text-primary.text-truncate= order.orderNumber
                        div.small.fw-semibold.text-truncate= order.customer.name
                        div.small.text-muted.text-truncate
                          = order.customer.phone + ' · S/. ' + order.total.toFixed(2)
                  li.px-3.py-2.text-center.border-top
                    a.btn.btn-sm.btn-link.text-decoration-none.fw-semibold(href="/orders?status=pendiente")
                      | Ver todos los pendientes
                      i.fas.fa-arrow-right.ms-1
                else
                  li.text-center.py-5.text-muted
                    i.fas.fa-bell-slash.fa-3x.mb-3.opacity-25.d-block
                    p.mb-0 No hay pedidos pendientes

        a.btn.btn-light.rounded-circle.shadow-sm.icon-btn(href="/landing" target="_blank" title="Ver tienda")
          i.fas.fa-store

  //- ============================================
  //- BIENVENIDA
  //- ============================================
  .row.mb-3.mb-md-4
    .col-12
      .welcome-card.p-3.p-md-4.rounded-4.shadow-sm.position-relative.overflow-hidden
        .row.align-items-center.position-relative(style="z-index: 2;")
          .col-lg-8
            .d-flex.align-items-center.mb-2.mb-md-3
              .avatar-circle-lg.bg-white.text-primary.me-3.flex-shrink-0
                i.fas.fa-user.fa-lg
              div.min-w-0
                h4.fw-bold.mb-0.text-truncate ¡Hola, #{user.name}!
          .col-lg-4.d-none.d-lg-flex.justify-content-end
            i.fas.fa-briefcase.welcome-icon

  //- ============================================
  //- ALERTA PENDIENTES
  //- ============================================
  if pendingOrdersCount > 0
    .row.mb-3.mb-md-4
      .col-12
        .alert.alert-warning.border-0.shadow-sm.rounded-3.d-flex.align-items-center.justify-content-between.flex-wrap.gap-2.p-3
          .d-flex.align-items-center.gap-3.min-w-0
            .rounded-circle.bg-warning.text-white.d-flex.align-items-center.justify-content-center.flex-shrink-0(style="width: 44px; height: 44px; font-size: 1.2rem;")
              i.fas.fa-bell.animate-ring
            div.min-w-0
              h6.mb-1.fw-bold.text-dark.mb-0
                | ¡Tienes #{pendingOrdersCount} pedido#{pendingOrdersCount !== 1 ? 's' : ''} pendiente#{pendingOrdersCount !== 1 ? 's' : ''}!
              small.text-muted.d-block Los clientes esperan confirmación.
          a.btn.btn-warning.rounded-pill.px-3.px-md-4.text-dark.fw-bold.w-100.w-sm-auto(href="/orders?status=pendiente")
            i.fas.fa-eye.me-1
            | Ver pedidos

  //- ============================================
  //- ESTADÍSTICAS (solo 2 cards para user)
  //- ============================================
  .row.g-2.g-md-3.mb-3.mb-md-4
    .col-6
      .card.stat-card.border-0.shadow-sm.h-100(class=(pendingOrdersCount > 0 ? 'border-warning' : ''))
        .card-body.p-3
          .d-flex.justify-content-between.align-items-start.mb-2
            .stat-icon.bg-warning-subtle.text-warning
              i.fas.fa-shopping-bag
            if pendingOrdersCount > 0
              span.badge.bg-danger-subtle.text-danger.rounded-pill
                i.fas.fa-exclamation-circle.me-1
                | Nuevos
            else
              span.badge.bg-success-subtle.text-success.rounded-pill
                i.fas.fa-check.me-1
                | Al día
          h3.fw-bold.mb-1 #{pendingOrdersCount || 0}
          p.text-muted.small.mb-0 Pedidos pendientes

    .col-6
      .card.stat-card.border-0.shadow-sm.h-100
        .card-body.p-3
          .d-flex.justify-content-between.align-items-start.mb-2
            .stat-icon.bg-success-subtle.text-success
              i.fas.fa-chart-line
          h3.fw-bold.mb-1 S/. #{todaySalesTotal.toFixed(2)}
          p.text-muted.small.mb-0 Ventas de hoy

  //- ============================================
  //- PEDIDOS RECIENTES + VENTAS HOY
  //- ============================================
  .row.g-3.mb-3.mb-md-4
    .col-12.col-lg-7
      .card.border-0.shadow-sm.rounded-3.h-100
        .card-header.bg-transparent.border-0.py-3.d-flex.justify-content-between.align-items-center
          h6.mb-0.fw-bold
            i.fas.fa-clock-rotate-left.me-2.text-primary
            | Pedidos recientes
          a.btn.btn-sm.btn-link.text-decoration-none.fw-semibold(href="/orders")
            | Ver todos
            i.fas.fa-arrow-right.ms-1
        .card-body.pt-0
          if pendingOrders && pendingOrders.length
            .table-responsive
              table.table.table-sm.table-hover.align-middle.mb-0
                tbody
                  each order in pendingOrders.slice(0, 5)
                    tr
                      td
                        a.fw-bold.text-primary.text-decoration-none(href=`/orders/${order._id}`)= order.orderNumber
                      td.d-none.d-sm-table-cell
                        div.small.fw-semibold= order.customer.name
                        small.text-muted= order.customer.phone
                      td.text-end
                        span.fw-bold.text-primary S/. #{order.total.toFixed(2)}
          else
            .text-center.py-4.text-muted
              i.fas.fa-check-circle.fa-3x.mb-3.opacity-25.d-block.text-success
              p.mb-0 No hay pedidos pendientes

    .col-12.col-lg-5
      .card.border-0.shadow-sm.rounded-3.h-100
        .card-header.bg-transparent.border-0.py-3
          h6.mb-0.fw-bold
            i.fas.fa-chart-line.me-2.text-success
            | Ventas de hoy
        .card-body.pt-0
          .text-center.py-3
            .display-6.fw-bold.text-success.mb-2
              | S/. #{todaySalesTotal.toFixed(2)}
            p.text-muted.mb-3.mb-2
              = todaySalesCount
              |  pedido#{todaySalesCount !== 1 ? 's' : ''} registrado#{todaySalesCount !== 1 ? 's' : ''}
          .d-grid
            a.btn.btn-outline-success.rounded-pill(href="/orders?from=" + new Date().toISOString().split('T')[0])
              i.fas.fa-list.me-1
              | Ver pedidos de hoy

  //- ============================================
  //- MÓDULOS (solo Ventas + Servicios)
  //- ============================================
  .row.mb-3
    .col-12
      h5.fw-bold.mb-0
        i.fas.fa-th-large.me-2.text-primary
        | Mis Módulos

  mixin moduleCard(href, icon, label, color)
    .col-4.col-md-4.col-lg-3
      a.module-card.card.text-decoration-none.border-0.shadow-sm.h-100(href=href, class=`module-${color}`)
        .card-body.p-2.p-md-3.d-flex.flex-column.flex-md-row.align-items-center.gap-2.gap-md-3.text-center.text-md-start
          .module-icon
            i(class=icon)
          .flex-grow-1.min-w-0.w-100
            .module-label.fw-semibold.text-truncate= label
          i.fas.fa-chevron-right.module-arrow.d-none.d-md-block

  //- VENTAS
  .row.mb-2
    .col-12
      .d-flex.align-items-center.mb-2
        span.badge.bg-success-subtle.text-success.me-2
          i.fas.fa-shopping-cart.me-1
          | Ventas
        .flex-grow-1.border-bottom
  .row.g-2.g-md-3.mb-3.mb-md-4
    +moduleCard('/quotations', 'fas.fa-file-invoice', 'Cotizaciones', 'blue')
    +moduleCard('/orders', 'fas.fa-clipboard-list', 'Pedidos', 'orange')
    +moduleCard('/sales', 'fas.fa-cart-plus', 'Ventas', 'emerald')
    +moduleCard('/vouchers', 'fas.fa-file-pdf', 'Comprobantes', 'rose')

  //- SERVICIOS
  .row.mb-2
    .col-12
      .d-flex.align-items-center.mb-2
        span.badge.bg-info-subtle.text-info.me-2
          i.fas.fa-tools.me-1
          | Servicios
        .flex-grow-1.border-bottom
  .row.g-2.g-md-3.mb-3.mb-md-4
    +moduleCard('/installations', 'fas.fa-wrench', 'Instalaciones', 'cyan')
    +moduleCard('/maintenances', 'fas.fa-sync-alt', 'Mantenimientos', 'amber')
    +moduleCard('/visits', 'fas.fa-clipboard-check', 'Visitas', 'teal')
    +moduleCard('/work-orders', 'fas.fa-tasks', 'Órdenes Trabajo', 'red')
    +moduleCard('/projects', 'fas.fa-project-diagram', 'Proyectos', 'violet')

  //- ============================================
  //- ESTILOS (mismos que el admin)
  //- ============================================
  style.
    html, body { overflow-x: hidden !important; max-width: 100vw; }
    .icon-btn { width: 42px; height: 42px; display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0; }
    .notif-menu { min-width: 0; width: min(360px, calc(100vw - 24px)) !important; }
    @media (max-width: 575.98px) {
      .notification-dropdown .dropdown-menu { position: fixed !important; top: 60px !important; left: 12px !important; right: 12px !important; width: auto !important; }
    }
    .notif-list { max-height: 400px; overflow-y: auto; }
    .animate-ring { animation: ring 2s ease-in-out infinite; }
    @keyframes ring { 0%,100%{transform:rotate(0);} 10%,30%,50%,70%,90%{transform:rotate(-10deg);} 20%,40%,60%,80%{transform:rotate(10deg);} }
    .stat-card.border-warning { border: 2px solid #f59e0b !important; animation: pulse-warning 2s ease-in-out infinite; }
    @keyframes pulse-warning { 0%,100%{box-shadow:0 0 0 0 rgba(245,158,11,0.4);} 50%{box-shadow:0 0 0 8px rgba(245,158,11,0);} }
    .module-card { transition: all 0.25s ease; border-radius: 14px; overflow: hidden; }
    .module-card:hover { transform: translateY(-3px); box-shadow: 0 10px 24px rgba(0,0,0,0.08) !important; }
    .module-icon { width: 44px; height: 44px; display: inline-flex; align-items: center; justify-content: center; border-radius: 12px; font-size: 1.15rem; flex-shrink: 0; }
    .module-arrow { color: #cbd5e1; font-size: 0.85rem; flex-shrink: 0; }
    .module-blue .module-icon { background: #dbeafe; color: #2563eb; }
    .module-orange .module-icon { background: #ffedd5; color: #ea580c; }
    .module-emerald .module-icon { background: #d1fae5; color: #059669; }
    .module-rose .module-icon { background: #ffe4e6; color: #e11d48; }
    .module-cyan .module-icon { background: #cffafe; color: #0891b2; }
    .module-amber .module-icon { background: #fef3c7; color: #d97706; }
    .module-teal .module-icon { background: #ccfbf1; color: #0d9488; }
    .module-red .module-icon { background: #fee2e2; color: #dc2626; }
    .module-violet .module-icon { background: #ede9fe; color: #7c3aed; }
    @media (max-width: 767.98px) {
      .module-card .card-body { flex-direction: column !important; text-align: center; padding: 12px 6px !important; gap: 8px !important; }
      .module-icon { width: 52px; height: 52px; font-size: 1.4rem; border-radius: 16px; }
      .module-label { font-size: 0.8rem; line-height: 1.15; }
      .stat-card h3 { font-size: 1.4rem; }
    }

  //- ============================================
  //- SCRIPT (notificaciones)
  //- ============================================
  script.
    document.addEventListener('DOMContentLoaded', function() {
      const notificationBadge = document.getElementById('notificationBadge');
      const notificationList  = document.getElementById('notificationList');
      const notifSubtitle     = document.getElementById('notifSubtitle');
      let lastPendingCount = #{pendingOrdersCount || 0};

      function checkNotifications() {
        fetch('/api/notifications')
          .then(r => r.json())
          .then(data => {
            if (!data.success) return;
            const count = data.pendingOrdersCount || 0;
            if (notificationBadge) {
              notificationBadge.textContent = count;
              notificationBadge.classList.toggle('d-none', count === 0);
            }
            if (notifSubtitle) notifSubtitle.textContent = count + ' pedidos pendientes';
            lastPendingCount = count;
          })
          .catch(() => {});
      }
      setInterval(checkNotifications, 30000);
    });