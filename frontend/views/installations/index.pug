extends ../layouts/layout

block content

  //- ============================================
  //- HEADER
  //- ============================================
  .inst-page-header.mb-3.mb-md-4
    .d-flex.flex-wrap.justify-content-between.align-items-center.gap-2.gap-md-3
      div.min-w-0
        nav.d-none.d-md-block(aria-label="breadcrumb")
          ol.breadcrumb.mb-1
            li.breadcrumb-item
              a.text-decoration-none(href="/") Inicio
            li.breadcrumb-item.active(aria-current="page") Instalaciones

        h1.h4.h3-md.fw-bold.mb-1.text-dark.text-truncate
          i.fas.fa-wrench.me-2.text-primary
          | Instalaciones

        p.text-muted.mb-0.small.d-none.d-sm-block
          | Gestiona las instalaciones técnicas de tus clientes

      a.btn.btn-primary.rounded-pill.px-3.px-md-4.fw-semibold.d-inline-flex.align-items-center.gap-2.inst-new-btn(
        href="/installations/create"
      )
        i.fas.fa-plus-circle
        span.d-none.d-sm-inline Nueva Instalación
        span.d-sm-none Nueva

  //- ============================================
  //- BARRA DE BÚSQUEDA Y FILTROS
  //- ============================================
  .card.border-0.shadow-sm.rounded-3.mb-3
    .card-body.p-2.p-md-3
      .row.g-2.align-items-center

        //- Buscador
        .col-12.col-md-6
          .input-group
            span.input-group-text.bg-transparent.border-end-0
              i.fas.fa-search.text-muted
            input.form-control.border-start-0#searchInput(
              type="text"
              placeholder="Buscar cliente, equipo o técnico..."
              autocomplete="off"
            )

        //- Filtro por estado
        .col-8.col-md-4
          select.form-select#statusFilter
            option(value="") Todos los estados
            option(value="Pendiente") Pendiente
            option(value="En proceso") En proceso
            option(value="Completado") Completado
            option(value="Cancelado") Cancelado

        //- Contador
        .col-4.col-md-2.text-end
          span.badge.bg-primary-subtle.text-primary.rounded-pill.px-3.py-2.w-100.inst-count-badge
            i.fas.fa-list.me-1
            span#resultCount= (installations && installations.length) || 0

  //- ============================================
  //- VISTA DE TABLA (DESKTOP / TABLET)
  //- ============================================
  .card.border-0.shadow-sm.rounded-3.d-none.d-md-block
    .card-body.p-0
      .table-responsive
        table.table.table-hover.align-middle.mb-0.inst-table
          thead.table-light
            tr
              th Cliente
              th Equipo
              th Fecha
              th Técnico
              th Estado
              th.text-end Acciones
          tbody#installationsTableBody
            if installations && installations.length
              each installation in installations
                tr.inst-row(
                  data-search=((installation.client ? installation.client.businessName : '') + ' ' + (installation.equipment || '') + ' ' + (installation.technician || '')).toLowerCase()
                  data-status=installation.status
                )
                  td
                    .d-flex.align-items-center.gap-2
                      .inst-avatar
                        i.fas.fa-user
                      div.min-w-0
                        .fw-semibold.text-truncate= installation.client ? installation.client.businessName : '-'

                  td
                    div.small.fw-semibold.text-truncate= installation.equipment
                    small.text-muted.text-truncate.d-block= installation.serialNumber || ''

                  td
                    div.small.fw-semibold
                      = new Date(installation.installationDate).toLocaleDateString('es-ES', { day: '2-digit', month: 'short', year: 'numeric' })

                  td
                    div.small.text-truncate= installation.technician

                  td
                    span.inst-badge(
                      class=installation.status === 'Completado' ? 'inst-badge-success'
                      class=installation.status === 'Cancelado' ? 'inst-badge-danger'
                      class=installation.status === 'En proceso' ? 'inst-badge-info'
                      class='inst-badge-warning'
                    )
                      i.fas(
                        class=installation.status === 'Completado' ? 'fa-check-circle'
                        class=installation.status === 'Cancelado' ? 'fa-times-circle'
                        class=installation.status === 'En proceso' ? 'fa-spinner'
                        class='fa-clock'
                      )
                      span= installation.status

                  td.text-end
                    .btn-group.btn-group-sm
                      a.btn.btn-outline-info.inst-action-btn(
                        href=`/installations/${installation._id}`
                        title="Ver"
                      )
                        i.fas.fa-eye
                      a.btn.btn-outline-warning.inst-action-btn(
                        href=`/installations/${installation._id}/edit`
                        title="Editar"
                      )
                        i.fas.fa-edit
                      form.d-inline(
                        method="POST"
                        action=`/installations/${installation._id}?_method=DELETE`
                        onsubmit="return confirm('¿Eliminar esta instalación?')"
                      )
                        button.btn.btn-outline-danger.inst-action-btn(
                          type="submit"
                          title="Eliminar"
                        )
                          i.fas.fa-trash
            else
              tr
                td(colspan="6").text-center.py-5
                  .inst-empty
                    i.fas.fa-wrench.fa-3x.mb-3.opacity-25.d-block
                    p.text-muted.mb-3 No hay instalaciones registradas
                    a.btn.btn-sm.btn-primary.rounded-pill(href="/installations/create")
                      i.fas.fa-plus-circle.me-1
                      | Registrar primera instalación

  //- ============================================
  //- VISTA DE CARDS (MÓVIL)
  //- ============================================
  .d-md-none#installationsCardsView
    if installations && installations.length
      each installation in installations
        .card.inst-mobile-card.border-0.shadow-sm.rounded-4.mb-2.inst-row(
          data-search=((installation.client ? installation.client.businessName : '') + ' ' + (installation.equipment || '') + ' ' + (installation.technician || '')).toLowerCase()
          data-status=installation.status
        )
          .card-body.p-3

            //- Header
            .d-flex.justify-content-between.align-items-start.gap-2.mb-2
              .d-flex.align-items-center.gap-2.min-w-0
                .inst-avatar
                  i.fas.fa-user
                div.min-w-0
                  .fw-bold.text-dark.text-truncate
                    = installation.client ? installation.client.businessName : '-'
                  small.text-muted.text-truncate.d-block= installation.equipment

              span.inst-badge.flex-shrink-0(
                class=installation.status === 'Completado' ? 'inst-badge-success'
                class=installation.status === 'Cancelado' ? 'inst-badge-danger'
                class=installation.status === 'En proceso' ? 'inst-badge-info'
                class='inst-badge-warning'
              )
                i.fas(
                  class=installation.status === 'Completado' ? 'fa-check-circle'
                  class=installation.status === 'Cancelado' ? 'fa-times-circle'
                  class=installation.status === 'En proceso' ? 'fa-spinner'
                  class='fa-clock'
                )
                span= installation.status

            //- Info
            .inst-mobile-info.mb-3
              .d-flex.align-items-center.gap-2.mb-1
                i.fas.fa-calendar.text-primary.fa-sm
                small.text-muted
                  = new Date(installation.installationDate).toLocaleDateString('es-ES', { day: '2-digit', month: 'short', year: 'numeric' })
              .d-flex.align-items-center.gap-2
                i.fas.fa-user-cog.text-primary.fa-sm
                small.text-muted.text-truncate= installation.technician

            //- Acciones
            .d-flex.gap-2
              a.btn.btn-sm.btn-outline-info.flex-fill.rounded-pill(
                href=`/installations/${installation._id}`
              )
                i.fas.fa-eye.me-1
                | Ver
              a.btn.btn-sm.btn-outline-warning.flex-fill.rounded-pill(
                href=`/installations/${installation._id}/edit`
              )
                i.fas.fa-edit.me-1
                | Editar
              form.d-inline.flex-fill(
                method="POST"
                action=`/installations/${installation._id}?_method=DELETE`
                onsubmit="return confirm('¿Eliminar esta instalación?')"
              )
                button.btn.btn-sm.btn-outline-danger.w-100.rounded-pill(type="submit")
                  i.fas.fa-trash.me-1
                  | Borrar
    else
      .card.border-0.shadow-sm.rounded-4
        .card-body.text-center.py-5
          .inst-empty
            i.fas.fa-wrench.fa-3x.mb-3.opacity-25.d-block
            p.text-muted.mb-3 No hay instalaciones registradas
            a.btn.btn-primary.rounded-pill(href="/installations/create")
              i.fas.fa-plus-circle.me-1
              | Registrar primera instalación

  //- ============================================
  //- MENSAJE SIN RESULTADOS (filtros)
  //- ============================================
  .card.border-0.shadow-sm.rounded-3.d-none#noResultsCard
    .card-body.text-center.py-5
      i.fas.fa-search.fa-3x.mb-3.opacity-25.d-block.text-muted
      p.text-muted.mb-0 No se encontraron instalaciones con esos filtros

  //- ============================================
  //- ESTILOS
  //- ============================================
  style.
    /* ---- Page header ---- */
    .inst-page-header { padding-bottom: 0; }

    /* ---- Botón nueva instalación ---- */
    .inst-new-btn { white-space: nowrap; }

    /* ---- Contador ---- */
    .inst-count-badge {
      font-size: 0.85rem;
      font-weight: 700;
    }

    /* ---- Avatar cliente ---- */
    .inst-avatar {
      width: 38px; height: 38px;
      border-radius: 10px;
      background: #eff6ff;
      color: #2563eb;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 0.9rem;
      flex-shrink: 0;
    }

    /* ---- Tabla ---- */
    .inst-table thead th {
      font-size: 0.72rem;
      text-transform: uppercase;
      letter-spacing: 0.7px;
      font-weight: 700;
      color: #64748b;
      border-bottom: 2px solid #e2e8f0;
      padding: 0.9rem 0.75rem;
      white-space: nowrap;
    }
    .inst-table tbody td {
      padding: 0.85rem 0.75rem;
      vertical-align: middle;
      border-bottom: 1px solid #f1f5f9;
    }
    .inst-table tbody tr:hover {
      background: #f8fafc;
    }
    .inst-table tbody tr:last-child td {
      border-bottom: none;
    }

    /* ---- Action buttons ---- */
    .inst-action-btn {
      width: 34px;
      height: 34px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: 8px !important;
      font-size: 0.85rem;
      transition: all 0.2s;
    }
    .inst-action-btn:hover {
      transform: translateY(-1px);
    }

    /* ---- Badges de estado ---- */
    .inst-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      padding: 0.35rem 0.75rem;
      border-radius: 999px;
      font-size: 0.75rem;
      font-weight: 700;
      white-space: nowrap;
    }
    .inst-badge i { font-size: 0.7rem; }
    .inst-badge-success { background: #dcfce7; color: #15803d; }
    .inst-badge-danger  { background: #fee2e2; color: #b91c1c; }
    .inst-badge-warning { background: #fef3c7; color: #b45309; }
    .inst-badge-info    { background: #dbeafe; color: #1d4ed8; }

    /* ---- Empty state ---- */
    .inst-empty i { color: #cbd5e1; }

    /* ---- Mobile cards ---- */
    .inst-mobile-card {
      transition: all 0.2s ease;
      border: 1px solid #eef2f7 !important;
    }
    .inst-mobile-card:active {
      transform: scale(0.99);
      box-shadow: 0 2px 8px rgba(0,0,0,0.06) !important;
    }
    .inst-mobile-info {
      background: #f8fafc;
      border-radius: 10px;
      padding: 0.6rem 0.75rem;
    }

    /* ---- Responsive ---- */
    @media (max-width: 575.98px) {
      .inst-page-header h1 { font-size: 1.15rem; }
      .inst-new-btn { padding: 0.5rem 0.9rem; font-size: 0.85rem; }
      .inst-mobile-card .card-body { padding: 0.85rem !important; }
      .inst-badge { font-size: 0.7rem; padding: 0.3rem 0.6rem; }
    }

    /* ---- Tablet: ajustar paddings de tabla ---- */
    @media (min-width: 768px) and (max-width: 991.98px) {
      .inst-table thead th,
      .inst-table tbody td { padding: 0.7rem 0.5rem; }
      .inst-table { font-size: 0.85rem; }
    }

  //- ============================================
  //- SCRIPT (filtros + búsqueda)
  //- ============================================
  script.
    document.addEventListener('DOMContentLoaded', function() {
      const searchInput = document.getElementById('searchInput');
      const statusFilter = document.getElementById('statusFilter');
      const resultCount = document.getElementById('resultCount');
      const tableBody = document.getElementById('installationsTableBody');
      const cardsView = document.getElementById('installationsCardsView');
      const noResultsCard = document.getElementById('noResultsCard');
      const tableCard = document.querySelector('.inst-table')?.closest('.card');
      const mobileCardContainer = cardsView;

      function getRows() {
        return document.querySelectorAll('.inst-row');
      }

      function applyFilters() {
        const term = (searchInput?.value || '').toLowerCase().trim();
        const status = statusFilter?.value || '';

        let visible = 0;
        getRows().forEach(row => {
          const searchData = row.getAttribute('data-search') || '';
          const rowStatus = row.getAttribute('data-status') || '';

          const matchSearch = !term || searchData.includes(term);
          const matchStatus = !status || rowStatus === status;

          if (matchSearch && matchStatus) {
            row.style.display = '';
            visible++;
          } else {
            row.style.display = 'none';
          }
        });

        // Actualizar contador
        if (resultCount) resultCount.textContent = visible;

        // Mostrar/ocultar vista vacía
        if (visible === 0) {
          if (tableCard) tableCard.classList.add('d-none');
          if (cardsView) cardsView.classList.add('d-none');
          if (noResultsCard) noResultsCard.classList.remove('d-none');
        } else {
          if (noResultsCard) noResultsCard.classList.add('d-none');
          if (tableCard) tableCard.classList.remove('d-none');
          if (cardsView) cardsView.classList.remove('d-none');
        }
      }

      if (searchInput) searchInput.addEventListener('input', applyFilters);
      if (statusFilter) statusFilter.addEventListener('change', applyFilters);

      // Atajo Ctrl+K / Cmd+K
      document.addEventListener('keydown', function(e) {
        if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
          e.preventDefault();
          if (searchInput) searchInput.focus();
        }
      });
    });