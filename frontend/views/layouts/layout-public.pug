doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")

    //- ============================================
    //- SEO
    //- ============================================
    - const pageTitle = (typeof title !== 'undefined' && title) ? (title + ' | ' + (setting && setting.siteName ? setting.siteName : 'JP Security')) : ((setting && setting.siteName) ? setting.siteName : 'JP Security')
    title= pageTitle

    if setting && setting.favicon
      link(rel="icon" href=setting.favicon)

    //- ============================================
    //- CSS GLOBAL
    //- ============================================
    link(rel="stylesheet" href="/bootstrap/css/bootstrap.min.css")
    link(rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css")
    link(rel="stylesheet" href="/css/styles.css")
    link(rel="stylesheet" href="/css/landing.css")

    //- ============================================
    //- VARIABLES DE MARCA
    //- ============================================
    - const brandPrimary = (setting && setting.colors && setting.colors.primary) ? setting.colors.primary : '#0d6efd'
    - const brandSecondary = (setting && setting.colors && setting.colors.secondary) ? setting.colors.secondary : '#0a58ca'

    style.
      /* ================================================
         VARIABLES GLOBALES
         ================================================ */
      :root {
        --brand: #{brandPrimary};
        --brand-dark: #{brandSecondary};
        --navbar-height: 64px;
        --sidebar-width: 400px;
      }

      html, body {
        height: 100%;
      }

      body {
        font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
        color: #1f2937;
        background: #f8fafc;
        display: flex;
        flex-direction: column;
        min-height: 100vh;
        overflow-x: hidden;
      }

      main {
        flex: 1 0 auto;
        padding-top: calc(var(--navbar-height) + 24px);
        padding-bottom: 40px;
      }

      /* ================================================
         NAVBAR
         ================================================ */
      .navbar-public {
        height: var(--navbar-height);
        padding: 0;
        background: #0f172a !important;
      }
      .navbar-public .container {
        height: 100%;
        display: flex;
        align-items: center;
      }
      .navbar-public .navbar-brand {
        font-weight: 700;
        font-size: 1.15rem;
        letter-spacing: -0.3px;
        padding: 0;
        margin-right: 1.5rem;
      }
      .navbar-public .navbar-brand img {
        max-height: 70px;
        width: auto;
      }
      .navbar-public .nav-link {
        font-weight: 500;
        font-size: 0.9rem;
        padding: 0.5rem 0.85rem !important;
        color: rgba(255,255,255,0.85);
        transition: color 0.15s;
      }
      .navbar-public .nav-link:hover { color: #fff !important; }
      .navbar-public .nav-link.active { color: var(--brand) !important; }

      /* Carrito */
      .btn-cart-public {
        position: relative;
        width: 42px;
        height: 42px;
        border-radius: 50%;
        background: rgba(255,255,255,0.1);
        border: none;
        color: white;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s;
      }
      .btn-cart-public:hover { background: var(--brand); color: white; }

      .cart-badge-count {
        position: absolute;
        top: -2px;
        right: -2px;
        background: #dc3545;
        color: white;
        font-size: 0.65rem;
        min-width: 20px;
        height: 20px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        padding: 0 5px;
        border: 2px solid #0f172a;
      }

      /* ================================================
         BOTÓN AGREGAR AL CARRITO
         ================================================ */
      .btn-add-cart {
        border-radius: 50rem;
        font-weight: 600;
        transition: all 0.2s;
      }
      .btn-add-cart:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 16px rgba(13,110,253,0.3);
      }

      /* ================================================
         CARRITO LATERAL
         ================================================ */
      .cart-sidebar {
        position: fixed;
        top: 0;
        right: calc(-1 * var(--sidebar-width));
        width: var(--sidebar-width);
        max-width: 100%;
        height: 100vh;
        height: 100dvh;
        background: white;
        box-shadow: -8px 0 24px rgba(0,0,0,0.15);
        z-index: 1060;
        transition: right 0.35s cubic-bezier(0.4, 0, 0.2, 1);
        display: flex;
        flex-direction: column;
        overflow: hidden;
      }
      .cart-sidebar.open { right: 0; }

      .cart-header {
        padding: 1rem 1.25rem;
        border-bottom: 1px solid #e5e7eb;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-shrink: 0;
        background: white;
      }

      .cart-body {
        flex: 1 1 auto;
        overflow-y: auto;
        overflow-x: hidden;
        padding: 1rem;
        -webkit-overflow-scrolling: touch;
      }

      .cart-footer {
        padding: 1rem 1.25rem;
        border-top: 1px solid #e5e7eb;
        background: #f8fafc;
        flex-shrink: 0;
      }

      .cart-item {
        display: flex;
        gap: 0.75rem;
        padding: 0.75rem;
        border-radius: 0.75rem;
        background: #f8fafc;
        margin-bottom: 0.75rem;
        align-items: flex-start;
      }
      .cart-item img {
        width: 60px;
        height: 60px;
        object-fit: contain;
        background: white;
        border-radius: 0.5rem;
        padding: 0.25rem;
        flex-shrink: 0;
      }
      .cart-item .cart-item-info { flex: 1; min-width: 0; }
      .cart-item .cart-item-info .cart-item-title {
        font-weight: 600;
        font-size: 0.85rem;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }

      .cart-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.5);
        z-index: 1055;
        opacity: 0;
        visibility: hidden;
        transition: all 0.3s;
      }
      .cart-overlay.open { opacity: 1; visibility: visible; }

      /* ================================================
         FOOTER
         ================================================ */
      .footer-public {
        background: #0f172a;
        color: #94a3b8;
        padding: 3rem 0 1rem;
        margin-top: auto;
        flex-shrink: 0;
      }
      .footer-public h6 {
        color: white;
        font-weight: 700;
        text-transform: uppercase;
        font-size: 0.72rem;
        letter-spacing: 1.2px;
        margin-bottom: 1.25rem;
      }
      .footer-public .footer-brand {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 1.15rem;
        font-weight: 700;
        color: white;
        margin-bottom: 0.75rem;
      }
      .footer-public .footer-brand img { max-height: 32px; }
      .footer-public p {
        font-size: 0.88rem;
        line-height: 1.6;
        margin-bottom: 0.75rem;
      }
      .footer-public ul {
        padding: 0;
        margin: 0;
        list-style: none;
      }
      .footer-public ul li {
        margin-bottom: 0.5rem;
        font-size: 0.88rem;
      }
      .footer-public a {
        color: #94a3b8;
        text-decoration: none;
        transition: color 0.15s;
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
      }
      .footer-public a:hover { color: white; }

      .footer-social {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-top: 0.75rem;
      }
      .footer-social a {
        width: 38px;
        height: 38px;
        border-radius: 50%;
        background: rgba(255,255,255,0.08);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s;
      }
      .footer-social a:hover {
        background: var(--brand);
        color: white;
        transform: translateY(-3px);
      }

      .footer-bottom {
        border-top: 1px solid rgba(255,255,255,0.08);
        margin-top: 2.5rem;
        padding-top: 1.25rem;
        font-size: 0.82rem;
        color: #64748b;
      }

      /* ================================================
         FLOATING WHATSAPP
         ================================================ */
      .whatsapp-float {
        position: fixed;
        bottom: 24px;
        left: 24px;
        width: 52px;
        height: 52px;
        border-radius: 50%;
        background: #25d366;
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.6rem;
        box-shadow: 0 4px 16px rgba(37,211,102,0.45);
        z-index: 1040;
        transition: all 0.25s;
      }
      .whatsapp-float:hover {
        color: white;
        transform: scale(1.1);
        box-shadow: 0 6px 20px rgba(37,211,102,0.6);
      }

      /* ================================================
         TOASTS
         ================================================ */
      .toast-container-jp {
        position: fixed;
        top: calc(var(--navbar-height) + 16px);
        right: 16px;
        z-index: 1070;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        max-width: calc(100vw - 32px);
        pointer-events: none;
      }
      .toast-jp {
        pointer-events: auto;
        background: white;
        border-radius: 0.75rem;
        box-shadow: 0 8px 24px rgba(0,0,0,0.15);
        padding: 0.75rem 1rem;
        display: flex;
        align-items: center;
        gap: 0.75rem;
        min-width: 260px;
        max-width: 100%;
        animation: toastSlideIn 0.3s ease;
        border-left: 4px solid var(--brand);
      }
      .toast-jp.success { border-left-color: #10b981; }
      .toast-jp.error { border-left-color: #dc3545; }
      @keyframes toastSlideIn {
        from { transform: translateX(120%); opacity: 0; }
        to { transform: translateX(0); opacity: 1; }
      }

      /* ================================================
         FLASH MESSAGES
         ================================================ */
      .flash-wrapper {
        padding-top: calc(var(--navbar-height) + 16px);
      }

      /* ================================================
         RESPONSIVE
         ================================================ */
      @media (max-width: 991px) {
        .navbar-public .navbar-collapse {
          background: #0f172a;
          padding: 1rem;
          margin: 0 -1rem;
          border-top: 1px solid rgba(255,255,255,0.08);
        }
        .navbar-public .navbar-nav {
          padding-top: 0.5rem;
        }
        .navbar-public .nav-link {
          padding: 0.75rem 0.5rem !important;
        }
      }

      @media (max-width: 576px) {
        :root {
          --navbar-height: 60px;
          --sidebar-width: 100vw;
        }
        .footer-public { padding: 2rem 0 1rem; }
        .footer-public h6 { margin-bottom: 0.75rem; margin-top: 0.5rem; }
        .whatsapp-float {
          width: 48px;
          height: 48px;
          font-size: 1.4rem;
          bottom: 16px;
          left: 16px;
        }
        .toast-container-jp {
          top: calc(var(--navbar-height) + 12px);
          right: 12px;
          left: 12px;
        }
        .toast-jp {
          min-width: auto;
          width: 100%;
        }
      }

  body

    //- ============================================
    //- NAVBAR PÚBLICO
    //- ============================================
    nav.navbar.navbar-expand-lg.navbar-dark.navbar-public.fixed-top
      .container

        a.navbar-brand.d-flex.align-items-center(href="/")
          if setting && setting.logo
            img.me-2(src=setting.logo alt=(setting.siteName || 'Logo'))
          else
            i.fas.fa-shield-alt.me-2
          span= setting && setting.siteName ? setting.siteName : 'JP Security'

        button.navbar-toggler(type="button" data-bs-toggle="collapse" data-bs-target="#navbarPublic" aria-controls="navbarPublic" aria-expanded="false" aria-label="Menú")
          span.navbar-toggler-icon

        .collapse.navbar-collapse#navbarPublic

          //- ============================================
          //- Navegación principal
          //- ============================================
          ul.navbar-nav.me-auto.mb-2.mb-lg-0
            li.nav-item
              a.nav-link(href="/products")
                i.fas.fa-cubes.me-1
                | Catálogo

            li.nav-item
              a.nav-link(href="/checkout/track")
                i.fas.fa-search-location.me-1
                | Seguir pedido

            //- Nosotros
            li.nav-item
              a.nav-link(href="/about")
                i.fas.fa-building.me-1
                | Nosotros

            if categories && categories.length
              li.nav-item.dropdown
                a.nav-link.dropdown-toggle(href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false")
                  i.fas.fa-list.me-1
                  | Categorías
                ul.dropdown-menu.shadow-lg.rounded-3.border-0
                  each cat in categories
                    li
                      a.dropdown-item(href=`/products?category=${cat._id}`)
                        i.fas.fa-folder-open.me-2.text-primary
                        = cat.name
                    if cat.subcategories && cat.subcategories.length
                      each sub in cat.subcategories
                        li
                          a.dropdown-item.ps-4(href=`/products?category=${sub._id}`)
                            i.fas.fa-tag.me-2.text-muted
                            = sub.name
                      li: hr.dropdown-divider

          //- ============================================
          //- Acciones
          //- ============================================
          ul.navbar-nav.align-items-lg-center.gap-lg-2
            li.nav-item
              button.btn.btn-cart-public#cartBtn(type="button" title="Mi carrito" aria-label="Mi carrito")
                i.fas.fa-shopping-cart
                span.cart-badge-count#cartCount 0

            if user
              li.nav-item
                a.nav-link(href="/")
                  i.fas.fa-tachometer-alt.me-1
                  | Dashboard
              li.nav-item.dropdown
                a.nav-link.dropdown-toggle(href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false")
                  i.fas.fa-user-circle.me-1
                  span.d-none.d-sm-inline= user.name
                ul.dropdown-menu.dropdown-menu-end.shadow-lg.rounded-3.border-0
                  li
                    h6.dropdown-header.mb-0
                      div.fw-bold= user.name
                      small.text-muted= user.email || ''
                  li: hr.dropdown-divider
                  li
                    a.dropdown-item(href="/profile")
                      i.fas.fa-id-card.me-2.text-primary
                      | Mi Perfil
                  li
                    a.dropdown-item(href="/")
                      i.fas.fa-gauge.me-2.text-primary
                      | Dashboard
                  li
                    a.dropdown-item(href="/settings")
                      i.fas.fa-cog.me-2.text-primary
                      | Configuración
                  li: hr.dropdown-divider
                  li
                    a.dropdown-item.text-danger(href="/logout")
                      i.fas.fa-sign-out-alt.me-2
                      | Cerrar Sesión
            else
              li.nav-item
                a.nav-link(href="/login")
                  i.fas.fa-sign-in-alt.me-1
                  | Ingresar

    //- ============================================
    //- FLASH MESSAGES
    //- ============================================
    if (success && success.length) || (error && error.length)
      .container.flash-wrapper
        if success && success.length
          .alert.alert-success.alert-dismissible.fade.show.rounded-3.shadow-sm(role="alert")
            i.fas.fa-check-circle.me-2
            = success
            button.btn-close(type="button" data-bs-dismiss="alert" aria-label="Cerrar")
        if error && error.length
          .alert.alert-danger.alert-dismissible.fade.show.rounded-3.shadow-sm(role="alert")
            i.fas.fa-exclamation-circle.me-2
            = error
            button.btn-close(type="button" data-bs-dismiss="alert" aria-label="Cerrar")

    //- ============================================
    //- CONTENIDO
    //- ============================================
    main
      block content

    //- ============================================
    //- FOOTER
    //- ============================================
    footer.footer-public
      .container
        .row.g-4

          //- ============================================
          //- Columna 1: Marca + Redes
          //- ============================================
          .col-lg-4.col-md-6
            .footer-brand
              if setting && setting.logo
                img(src=setting.logo alt=(setting.siteName || 'Logo'))
              else if setting && setting.icon
                i.fas(class=setting.icon)
              else
                i.fas.fa-shield-alt
              span= setting && setting.siteName ? setting.siteName : 'JP Security'

            p= setting && setting.siteTagline ? setting.siteTagline : 'Soluciones integrales en seguridad electrónica.'

            .footer-social
              if setting && setting.social && setting.social.facebook
                a(href=setting.social.facebook target="_blank" rel="noopener" title="Facebook")
                  i.fab.fa-facebook-f
              if setting && setting.social && setting.social.instagram
                a(href=setting.social.instagram target="_blank" rel="noopener" title="Instagram")
                  i.fab.fa-instagram
              if setting && setting.social && setting.social.youtube
                a(href=setting.social.youtube target="_blank" rel="noopener" title="YouTube")
                  i.fab.fa-youtube
              if setting && setting.social && setting.social.tiktok
                a(href=setting.social.tiktok target="_blank" rel="noopener" title="TikTok")
                  i.fab.fa-tiktok
              if setting && setting.social && setting.social.whatsapp
                a(href=`https://wa.me/${setting.social.whatsapp}` target="_blank" rel="noopener" title="WhatsApp")
                  i.fab.fa-whatsapp

          //- ============================================
          //- Columna 2: Enlaces
          //- ============================================
          .col-lg-2.col-md-6.col-6
            h6 Enlaces
            ul
              li: a(href="/")
                i.fas.fa-home.me-1
                | Inicio
              li: a(href="/products")
                i.fas.fa-cubes.me-1
                | Catálogo
              li: a(href="/products?filter=new")
                i.fas.fa-star.me-1
                | Novedades
              li: a(href="/checkout/track")
                i.fas.fa-search-location.me-1
                | Seguir pedido
              //- Nosotros
              li: a(href="/about")
                i.fas.fa-building.me-1
                | Nosotros

          //- ============================================
          //- Columna 3: Cuenta
          //- ============================================
          .col-lg-2.col-md-6.col-6
            h6 Cuenta
            ul
              if user
                li: a(href="/")
                  i.fas.fa-gauge.me-1
                  | Dashboard
                li: a(href="/profile")
                  i.fas.fa-id-card.me-1
                  | Mi Perfil
                li: a(href="/logout")
                  i.fas.fa-sign-out-alt.me-1
                  | Salir
              else
                li: a(href="/login")
                  i.fas.fa-sign-in-alt.me-1
                  | Ingresar
                li: a(href="/checkout/track")
                  i.fas.fa-search-location.me-1
                  | Seguir pedido

          //- ============================================
          //- Columna 4: Contacto
          //- ============================================
          .col-lg-4.col-md-6
            h6 Contacto
            ul
              if setting && setting.company && setting.company.phone
                li
                  a(href=`tel:${setting.company.phone}`)
                    i.fas.fa-phone
                    = setting.company.phone
              if setting && setting.company && setting.company.email
                li
                  a(href=`mailto:${setting.company.email}`)
                    i.fas.fa-envelope
                    = setting.company.email
              if setting && setting.company && setting.company.address
                li
                  span.d-flex.align-items-start
                    i.fas.fa-map-marker-alt.mt-1
                    span= setting.company.address
              if setting && setting.schedule && setting.schedule.weekdays
                li
                  span.d-flex.align-items-start
                    i.fas.fa-clock.mt-1
                    span
                      | Lun - Vie: #{setting.schedule.weekdays}
                      if setting.schedule.saturday
                        br
                        | Sáb: #{setting.schedule.saturday}

        .footer-bottom
          .d-flex.flex-wrap.justify-content-between.align-items-center.gap-2
            small
              | © #{new Date().getFullYear()} #{setting && setting.siteName ? setting.siteName : 'JP Security'}
              if setting && setting.company && setting.company.legalName
                |  · #{setting.company.legalName}
            if setting && setting.company && setting.company.ruc
              small RUC: #{setting.company.ruc}

    //- ============================================
    //- CARRITO LATERAL
    //- ============================================
    .cart-overlay#cartOverlay
    aside.cart-sidebar#cartSidebar(aria-hidden="true")

      .cart-header
        h5.mb-0.fw-bold
          i.fas.fa-shopping-cart.me-2.text-primary
          | Mi Carrito
        button.btn.btn-sm.btn-light.rounded-circle(
          type="button"
          id="cartClose"
          aria-label="Cerrar carrito"
        )
          i.fas.fa-times

      .cart-body#cartBody
        .text-center.py-5#cartEmpty
          i.fas.fa-shopping-cart.fa-3x.text-muted.mb-3.opacity-50
          p.text-muted.mb-0 Tu carrito está vacío
          small.text-muted Explora el catálogo para agregar productos

      .cart-footer
        .d-flex.justify-content-between.mb-2
          span.text-muted.small Subtotal
          strong#cartSubtotal S/. 0.00
        .d-flex.justify-content-between.mb-2
          span.text-muted.small Envío
          strong.text-success.small Gratis
        hr.my-2
        .d-flex.justify-content-between.mb-3
          span.fw-bold Total
          strong.text-primary.fs-5#cartTotal S/. 0.00
        a.btn.btn-primary.w-100.rounded-pill.py-2.fw-semibold(href="/checkout")
          i.fas.fa-credit-card.me-2
          | Pagar Contra entrega

    //- ============================================
    //- WHATSAPP FLOTANTE
    //- ============================================
    - const waNumber = (setting && setting.social && setting.social.whatsapp) ? setting.social.whatsapp : '51935909756'
    a.whatsapp-float(
      href=`https://wa.me/${waNumber}`
      target="_blank"
      rel="noopener"
      title="Escríbenos por WhatsApp"
    )
      i.fab.fa-whatsapp

    //- ============================================
    //- TOASTS
    //- ============================================
    .toast-container-jp#toastContainer

    //- ============================================
    //- SCRIPTS
    //- ============================================
    script(src="/bootstrap/js/bootstrap.bundle.min.js")
    script(src="/js/main.js")

    script.
      // ================================================
      // CARRITO CON LOCALSTORAGE
      // ================================================
      const CART_KEY = 'jp_cart';

      function getCart() {
        try { return JSON.parse(localStorage.getItem(CART_KEY)) || []; }
        catch(e) { return []; }
      }

      function saveCart(cart) {
        localStorage.setItem(CART_KEY, JSON.stringify(cart));
        updateCartUI();
      }

      function addToCart(product) {
        const cart = getCart();
        const id = String(product.id);
        const existing = cart.find(i => String(i.id) === id);
        if (existing) {
          existing.qty += 1;
        } else {
          cart.push({
            id: id,
            name: product.name,
            price: Number(product.price),
            image: product.image || '',
            qty: 1
          });
        }
        saveCart(cart);
        showToast(`"${product.name}" agregado al carrito`, 'success');
        openCart();
      }

      function removeFromCart(id) {
        const cleanId = String(id);
        saveCart(getCart().filter(i => String(i.id) !== cleanId));
      }

      function updateQty(id, delta) {
        const cleanId = String(id);
        const cart = getCart();
        const item = cart.find(i => String(i.id) === cleanId);
        if (!item) return;
        item.qty += delta;
        if (item.qty <= 0) return removeFromCart(cleanId);
        saveCart(cart);
      }

      function updateCartUI() {
        const cart = getCart();
        const count = cart.reduce((s, i) => s + i.qty, 0);
        const subtotal = cart.reduce((s, i) => s + (i.price * i.qty), 0);

        const cartCount = document.getElementById('cartCount');
        const cartSubtotal = document.getElementById('cartSubtotal');
        const cartTotal = document.getElementById('cartTotal');

        if (cartCount) cartCount.textContent = count;
        if (cartSubtotal) cartSubtotal.textContent = 'S/. ' + subtotal.toFixed(2);
        if (cartTotal) cartTotal.textContent = 'S/. ' + subtotal.toFixed(2);

        const body = document.getElementById('cartBody');
        const empty = document.getElementById('cartEmpty');
        if (!body) return;

        body.querySelectorAll('.cart-item').forEach(el => el.remove());

        if (cart.length === 0) {
          if (empty) empty.style.display = '';
          return;
        }
        if (empty) empty.style.display = 'none';

        cart.forEach(item => {
          const div = document.createElement('div');
          div.className = 'cart-item';
          div.innerHTML = `
            <img src="${item.image || 'https://via.placeholder.com/60'}" alt="${item.name}">
            <div class="cart-item-info">
              <div class="cart-item-title">${item.name}</div>
              <div class="text-primary fw-bold small mt-1">S/. ${Number(item.price).toFixed(2)}</div>
              <div class="d-flex align-items-center gap-2 mt-2">
                <button
                  type="button"
                  class="btn btn-sm btn-outline-secondary rounded-circle p-0 cart-qty-btn"
                  style="width:26px;height:26px;"
                  data-action="decrease"
                  data-id="${item.id}"
                >−</button>
                <span class="small fw-bold">${item.qty}</span>
                <button
                  type="button"
                  class="btn btn-sm btn-outline-secondary rounded-circle p-0 cart-qty-btn"
                  style="width:26px;height:26px;"
                  data-action="increase"
                  data-id="${item.id}"
                >+</button>
                <button
                  type="button"
                  class="btn btn-sm btn-link text-danger ms-auto p-0 cart-remove-btn"
                  data-id="${item.id}"
                  aria-label="Eliminar"
                >
                  <i class="fas fa-trash"></i>
                </button>
              </div>
            </div>
          `;
          body.appendChild(div);
        });
      }

      function openCart() {
        const s = document.getElementById('cartSidebar');
        const o = document.getElementById('cartOverlay');
        if (s) s.classList.add('open');
        if (o) o.classList.add('open');
        document.body.style.overflow = 'hidden';
      }

      function closeCart() {
        const s = document.getElementById('cartSidebar');
        const o = document.getElementById('cartOverlay');
        if (s) s.classList.remove('open');
        if (o) o.classList.remove('open');
        document.body.style.overflow = '';
      }

      // ================================================
      // TOAST notifications
      // ================================================
      function showToast(message, type = 'success') {
        const container = document.getElementById('toastContainer');
        if (!container) return;
        const icon = type === 'success' ? 'fa-check-circle text-success'
                  : type === 'error' ? 'fa-exclamation-circle text-danger'
                  : 'fa-info-circle text-primary';
        const toast = document.createElement('div');
        toast.className = `toast-jp ${type}`;
        toast.innerHTML = `
          <i class="fas ${icon} fa-lg"></i>
          <div class="flex-grow-1 small fw-semibold">${message}</div>
        `;
        container.appendChild(toast);
        setTimeout(() => {
          toast.style.opacity = '0';
          toast.style.transform = 'translateX(120%)';
          setTimeout(() => toast.remove(), 300);
        }, 2500);
      }

      // ================================================
      // EVENT DELEGATION PARA EL CARRITO
      // ================================================
      document.addEventListener('click', function(e) {
        // Botón de disminuir / aumentar
        const qtyBtn = e.target.closest('.cart-qty-btn');
        if (qtyBtn) {
          e.preventDefault();
          const id = qtyBtn.dataset.id;
          const action = qtyBtn.dataset.action;
          updateQty(id, action === 'increase' ? 1 : -1);
          return;
        }

        // Botón de eliminar
        const removeBtn = e.target.closest('.cart-remove-btn');
        if (removeBtn) {
          e.preventDefault();
          removeFromCart(removeBtn.dataset.id);
          return;
        }
      });

      // ================================================
      // EVENTOS GLOBALES
      // ================================================
      document.addEventListener('DOMContentLoaded', function() {
        updateCartUI();

        const cartBtn = document.getElementById('cartBtn');
        if (cartBtn) cartBtn.addEventListener('click', openCart);

        const cartClose = document.getElementById('cartClose');
        if (cartClose) cartClose.addEventListener('click', closeCart);

        const cartOverlay = document.getElementById('cartOverlay');
        if (cartOverlay) cartOverlay.addEventListener('click', closeCart);

        // Botones "Agregar al carrito"
        document.querySelectorAll('.btn-add-cart').forEach(btn => {
          btn.addEventListener('click', function() {
            addToCart({
              id: this.dataset.id,
              name: this.dataset.name,
              price: parseFloat(this.dataset.price),
              image: this.dataset.image
            });
          });
        });

        // Dropdown hover (desktop)
        if (window.innerWidth >= 992) {
          document.querySelectorAll('.dropdown').forEach(function(dropdown) {
            dropdown.addEventListener('mouseenter', function() {
              const toggle = this.querySelector('.dropdown-toggle');
              if (toggle) bootstrap.Dropdown.getOrCreateInstance(toggle).show();
            });
            dropdown.addEventListener('mouseleave', function() {
              const toggle = this.querySelector('.dropdown-toggle');
              if (toggle) bootstrap.Dropdown.getOrCreateInstance(toggle).hide();
            });
          });
        }
      });