doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")

    //- ============================================
    //- SEO
    //- ============================================
    - const siteNameSafe = (setting && setting.siteName) ? setting.siteName : 'JP Security'
    - const pageTitle = (typeof title !== 'undefined' && title) ? (title + ' | ' + siteNameSafe) : (setting && setting.siteTagline ? siteNameSafe + ' - ' + setting.siteTagline : siteNameSafe)
    - const pageDescription = (typeof metaDescription !== 'undefined' && metaDescription) ? metaDescription : ((setting && setting.metaDescription) ? setting.metaDescription : 'Sistemas de seguridad, cámaras, alarmas e instalación profesional.')
    - const pageKeywords = (setting && setting.metaKeywords) ? setting.metaKeywords : 'seguridad, cámaras, alarmas, Lima, Perú'

    title= pageTitle
    meta(name="description" content=pageDescription)
    meta(name="keywords" content=pageKeywords)
    meta(property="og:title" content=pageTitle)
    meta(property="og:description" content=pageDescription)

    if setting && setting.favicon
      link(rel="icon" href=setting.favicon)

    //- ============================================
    //- CSS GLOBAL
    //- ============================================
    link(rel="stylesheet" href="/bootstrap/css/bootstrap.min.css")
    link(rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css")
    link(rel="stylesheet" href="/css/styles.css")
    link(rel="stylesheet" href="/css/landing.css")

    //- ============================================
    //- VARIABLES DE MARCA
    //- ============================================
    - const brandPrimary = (setting && setting.colors && setting.colors.primary) ? setting.colors.primary : '#0d6efd'
    - const brandSecondary = (setting && setting.colors && setting.colors.secondary) ? setting.colors.secondary : '#0a58ca'

    style.
      /* ================================================
         VARIABLES GLOBALES
         ================================================ */
      :root {
        --brand: #{brandPrimary};
        --brand-dark: #{brandSecondary};
        --dark: #0f172a;
        --navbar-height: 64px;
        --sidebar-width: 400px;
        --drawer-width: 320px;
      }

      html, body { height: 100%; }

      body {
        font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
        color: #1f2937;
        background: #f8fafc;
        display: flex;
        flex-direction: column;
        min-height: 100vh;
        overflow-x: hidden;
      }

      main {
        flex: 1 0 auto;
        padding-top: calc(var(--navbar-height) + 24px);
        padding-bottom: 40px;
      }

      /* Colores de marca sobre Bootstrap */
      .btn-primary { background: var(--brand); border-color: var(--brand); }
      .btn-primary:hover,
      .btn-primary:focus { background: var(--brand-dark); border-color: var(--brand-dark); }
      .btn-outline-primary { color: var(--brand); border-color: var(--brand); }
      .btn-outline-primary:hover { background: var(--brand); border-color: var(--brand); color: #fff; }
      .text-primary { color: var(--brand) !important; }
      .bg-primary { background: var(--brand) !important; }
      .min-w-0 { min-width: 0; }

      /* ================================================
         NAVBAR
         ================================================ */
      .navbar-public {
        height: var(--navbar-height);
        padding: 0;
        background: #0f172a !important;
        box-shadow: 0 2px 12px rgba(0,0,0,0.15);
        z-index: 1040;
      }
      .navbar-public .container-fluid {
        height: 100%;
        display: flex;
        align-items: center;
        gap: 0.75rem;
      }
      .navbar-public .navbar-brand {
        font-weight: 700;
        font-size: 1.15rem;
        letter-spacing: -0.3px;
        padding: 0;
        margin: 0;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        color: #fff !important;
      }
      .navbar-public .navbar-brand img { max-height: 42px; width: auto; }
      .navbar-public .brand-name {
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        max-width: 200px;
      }

      .btn-hamburger {
        width: 42px; height: 42px;
        border-radius: 10px;
        background: rgba(255,255,255,0.08);
        border: none;
        color: #fff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
        transition: all 0.2s;
        flex-shrink: 0;
      }
      .btn-hamburger:hover,
      .btn-hamburger:focus { background: var(--brand); color: #fff; }

      .navbar-actions {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-left: auto;
        flex-shrink: 0;
      }
      .btn-nav-ghost {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        height: 40px;
        padding: 0 0.9rem;
        border-radius: 10px;
        background: rgba(255,255,255,0.08);
        border: none;
        color: #fff;
        font-size: 0.875rem;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.2s;
        white-space: nowrap;
      }
      .btn-nav-ghost:hover { background: var(--brand); color: #fff; }

      .btn-cart-public {
        position: relative;
        width: 42px; height: 42px;
        border-radius: 50%;
        background: rgba(255,255,255,0.1);
        border: none;
        color: white;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s;
      }
      .btn-cart-public:hover { background: var(--brand); color: white; }

      .cart-badge-count {
        position: absolute;
        top: -2px; right: -2px;
        background: #dc3545;
        color: white;
        font-size: 0.65rem;
        min-width: 20px; height: 20px;
        border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        font-weight: 700; padding: 0 5px;
        border: 2px solid #0f172a;
      }

      /* ================================================
         BUSCADOR (navbar + drawer)
         ================================================ */
      .nav-search {
        flex: 1;
        max-width: 520px;
        margin: 0 auto;
        position: relative;
      }
      .nav-search-bar {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        background: rgba(255,255,255,0.1);
        border-radius: 50rem;
        padding: 0 0.35rem 0 1rem;
        height: 42px;
        margin: 0;
        transition: background 0.2s;
      }
      .nav-search-bar:focus-within { background: rgba(255,255,255,0.18); }
      .nav-search-bar > i { color: #94a3b8; font-size: 0.85rem; }
      .nav-search-bar input {
        flex: 1;
        min-width: 0;
        border: none;
        outline: none;
        background: transparent;
        color: #fff;
        font-size: 0.9rem;
      }
      .nav-search-bar input::placeholder { color: #94a3b8; }
      .nav-search-bar button {
        width: 34px; height: 34px;
        border-radius: 50%;
        border: none;
        background: var(--brand);
        color: #fff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 0.8rem;
        transition: background 0.2s;
      }
      .nav-search-bar button:hover { background: var(--brand-dark); }

      .search-results {
        position: absolute;
        top: calc(100% + 8px);
        left: 0;
        right: 0;
        background: white;
        color: #1f2937;
        border-radius: 1rem;
        box-shadow: 0 12px 32px rgba(0, 0, 0, 0.2);
        max-height: 420px;
        overflow-y: auto;
        z-index: 1050;
        display: none;
        padding: 0.5rem;
      }
      .search-results.show { display: block; }
      .search-result-item {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.6rem 0.75rem;
        border-radius: 0.75rem;
        text-decoration: none;
        color: inherit;
        transition: background 0.15s;
      }
      .search-result-item:hover { background: #f1f5f9; color: inherit; }
      .search-result-img {
        width: 48px; height: 48px;
        border-radius: 0.5rem;
        background: #f8fafc;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        overflow: hidden;
      }
      .search-result-img img { max-width: 100%; max-height: 100%; object-fit: contain; }
      .search-result-info { flex: 1; min-width: 0; }
      .search-result-title {
        font-weight: 600;
        font-size: 0.875rem;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      .search-result-meta { font-size: 0.75rem; color: #64748b; }
      .search-result-price { font-weight: 700; color: var(--brand); font-size: 0.875rem; white-space: nowrap; }
      .search-footer { border-top: 1px solid #e5e7eb; padding: 0.5rem; text-align: center; }
      .search-footer a { font-size: 0.8rem; color: var(--brand); text-decoration: none; font-weight: 600; }
      .search-footer a:hover { text-decoration: underline; }

      .drawer-search {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin: 0.75rem 1.25rem 0.25rem;
        padding: 0 0.35rem 0 0.9rem;
        height: 42px;
        border-radius: 50rem;
        background: rgba(255,255,255,0.08);
      }
      .drawer-search i { color: #94a3b8; font-size: 0.85rem; }
      .drawer-search input {
        flex: 1;
        min-width: 0;
        border: none;
        outline: none;
        background: transparent;
        color: #fff;
        font-size: 0.9rem;
      }
      .drawer-search input::placeholder { color: #94a3b8; }
      .drawer-search button {
        width: 34px; height: 34px;
        border-radius: 50%;
        border: none;
        background: var(--brand);
        color: #fff;
      }

      /* ================================================
         DRAWER LATERAL (IZQUIERDA)
         ================================================ */
      .drawer-backdrop {
        position: fixed;
        inset: 0;
        background: rgba(15,23,42,0.55);
        backdrop-filter: blur(3px);
        -webkit-backdrop-filter: blur(3px);
        z-index: 1050;
        opacity: 0;
        visibility: hidden;
        transition: opacity 0.3s ease, visibility 0.3s ease;
      }
      .drawer-backdrop.show { opacity: 1; visibility: visible; }

      .side-drawer {
        position: fixed;
        top: 0;
        left: 0;
        width: var(--drawer-width);
        max-width: 88vw;
        height: 100vh;
        height: 100dvh;
        background: #0f172a;
        color: #e2e8f0;
        z-index: 1055;
        transform: translateX(-100%);
        visibility: hidden;
        transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1), visibility 0.35s;
        display: flex;
        flex-direction: column;
        box-shadow: 8px 0 32px rgba(0,0,0,0.35);
        overflow: hidden;
      }
      .side-drawer.open { transform: translateX(0); visibility: visible; }

      .drawer-header {
        padding: 1rem 1.25rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-bottom: 1px solid rgba(255,255,255,0.08);
        flex-shrink: 0;
        background: #0f172a;
      }
      .drawer-brand {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        color: #fff;
        font-weight: 700;
        font-size: 1.05rem;
        text-decoration: none;
      }
      .drawer-brand:hover { color: #fff; }
      .drawer-brand img { max-height: 34px; }

      .drawer-close {
        width: 36px; height: 36px;
        border-radius: 10px;
        background: rgba(255,255,255,0.08);
        border: none;
        color: #fff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s;
      }
      .drawer-close:hover { background: #dc3545; }

      .drawer-body {
        flex: 1 1 auto;
        overflow-y: auto;
        overflow-x: hidden;
        padding: 0.5rem 0;
        -webkit-overflow-scrolling: touch;
        overscroll-behavior: contain;
      }
      .drawer-body::-webkit-scrollbar { width: 6px; }
      .drawer-body::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.15); border-radius: 3px; }

      .drawer-nav { list-style: none; padding: 0; margin: 0; }
      .drawer-nav li { list-style: none; }

      .drawer-link {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.85rem 1.25rem;
        color: #cbd5e1;
        text-decoration: none;
        font-size: 0.925rem;
        font-weight: 500;
        border: none;
        background: transparent;
        width: 100%;
        text-align: left;
        transition: all 0.2s;
        cursor: pointer;
        position: relative;
      }
      .drawer-link:hover,
      .drawer-link:focus {
        background: rgba(255,255,255,0.06);
        color: #fff;
        padding-left: 1.5rem;
      }
      .drawer-link.active {
        background: rgba(255,255,255,0.08);
        color: #fff;
        box-shadow: inset 3px 0 0 var(--brand);
      }
      .drawer-link i.drawer-icon {
        width: 22px;
        text-align: center;
        font-size: 1rem;
        color: var(--brand);
        flex-shrink: 0;
      }
      .drawer-link .drawer-label {
        flex: 1;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      .drawer-link .drawer-chevron {
        font-size: 0.7rem;
        transition: transform 0.25s;
        color: #64748b;
      }
      .drawer-link[aria-expanded="true"] .drawer-chevron { transform: rotate(90deg); }

      .drawer-section-label {
        padding: 1rem 1.25rem 0.5rem;
        font-size: 0.7rem;
        text-transform: uppercase;
        letter-spacing: 1.2px;
        font-weight: 700;
        color: #64748b;
      }

      .drawer-submenu {
        list-style: none;
        padding: 0;
        margin: 0;
        background: rgba(0,0,0,0.25);
        overflow: hidden;
      }
      .drawer-submenu .drawer-sub-link {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        padding: 0.65rem 1.25rem 0.65rem 3.25rem;
        color: #94a3b8;
        text-decoration: none;
        font-size: 0.875rem;
        transition: all 0.2s;
      }
      .drawer-submenu .drawer-sub-link:hover {
        background: rgba(255,255,255,0.05);
        color: #fff;
        padding-left: 3.5rem;
      }
      .drawer-submenu .drawer-sub-link i {
        font-size: 0.75rem;
        color: #64748b;
        width: 14px;
        text-align: center;
      }

      .drawer-footer {
        flex-shrink: 0;
        border-top: 1px solid rgba(255,255,255,0.08);
        padding: 1rem 1.25rem;
        background: #0b1220;
      }
      .drawer-footer .drawer-user {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        margin-bottom: 0.75rem;
      }
      .drawer-footer .drawer-avatar {
        width: 40px; height: 40px;
        border-radius: 50%;
        background: linear-gradient(135deg, var(--brand), var(--brand-dark));
        color: #fff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        flex-shrink: 0;
      }
      .drawer-footer .drawer-user-info { min-width: 0; flex: 1; }
      .drawer-footer .drawer-user-name {
        font-weight: 700;
        color: #fff;
        font-size: 0.9rem;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      .drawer-footer .drawer-user-email {
        font-size: 0.75rem;
        color: #94a3b8;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      .drawer-footer .btn-drawer-primary,
      .drawer-footer .btn-drawer-outline {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        width: 100%;
        padding: 0.7rem;
        border-radius: 10px;
        border: none;
        color: #fff;
        font-weight: 600;
        font-size: 0.9rem;
        text-decoration: none;
        transition: all 0.2s;
      }
      .drawer-footer .btn-drawer-primary { background: var(--brand); }
      .drawer-footer .btn-drawer-primary:hover { background: var(--brand-dark); color: #fff; }
      .drawer-footer .btn-drawer-outline { background: rgba(255,255,255,0.08); }
      .drawer-footer .btn-drawer-outline:hover { background: rgba(255,255,255,0.16); color: #fff; }

      /* ================================================
         BOTÓN AGREGAR AL CARRITO (genérico; el home lo ajusta en sus tarjetas)
         ================================================ */
      .btn-add-cart {
        border-radius: 50rem;
        font-weight: 600;
        transition: all 0.2s;
      }
      .btn-add-cart:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 16px rgba(13,110,253,0.3);
      }

      /* ================================================
         CARRITO LATERAL
         ================================================ */
      .cart-sidebar {
        position: fixed;
        top: 0;
        right: calc(-1 * var(--sidebar-width));
        width: var(--sidebar-width);
        max-width: 100%;
        height: 100vh;
        height: 100dvh;
        background: white;
        box-shadow: -8px 0 24px rgba(0,0,0,0.15);
        z-index: 1060;
        transition: right 0.35s cubic-bezier(0.4, 0, 0.2, 1);
        display: flex;
        flex-direction: column;
        overflow: hidden;
      }
      .cart-sidebar.open { right: 0; }

      .cart-header {
        padding: 1rem 1.25rem;
        border-bottom: 1px solid #e5e7eb;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-shrink: 0;
        background: white;
      }
      .cart-body {
        flex: 1 1 auto;
        overflow-y: auto;
        overflow-x: hidden;
        padding: 1rem;
        -webkit-overflow-scrolling: touch;
      }
      .cart-footer {
        padding: 1rem 1.25rem;
        border-top: 1px solid #e5e7eb;
        background: #f8fafc;
        flex-shrink: 0;
      }
      .cart-item {
        display: flex;
        gap: 0.75rem;
        padding: 0.75rem;
        border-radius: 0.75rem;
        background: #f8fafc;
        margin-bottom: 0.75rem;
        align-items: flex-start;
      }
      .cart-item img {
        width: 60px; height: 60px;
        object-fit: contain;
        background: white;
        border-radius: 0.5rem;
        padding: 0.25rem;
        flex-shrink: 0;
      }
      .cart-item .cart-item-info { flex: 1; min-width: 0; }
      .cart-item .cart-item-info .cart-item-title {
        font-weight: 600;
        font-size: 0.85rem;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }

      .cart-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.5);
        z-index: 1055;
        opacity: 0;
        visibility: hidden;
        transition: all 0.3s;
      }
      .cart-overlay.open { opacity: 1; visibility: visible; }

      /* ================================================
         FOOTER
         ================================================ */
      .footer-public {
        background: #0f172a;
        color: #94a3b8;
        padding: 3rem 0 1rem;
        margin-top: auto;
        flex-shrink: 0;
      }
      .footer-public h6 {
        color: white;
        font-weight: 700;
        text-transform: uppercase;
        font-size: 0.72rem;
        letter-spacing: 1.2px;
        margin-bottom: 1.25rem;
      }
      .footer-public .footer-brand {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 1.15rem;
        font-weight: 700;
        color: white;
        margin-bottom: 0.75rem;
      }
      .footer-public .footer-brand img { max-height: 32px; }
      .footer-public p { font-size: 0.88rem; line-height: 1.6; margin-bottom: 0.75rem; }
      .footer-public ul { padding: 0; margin: 0; list-style: none; }
      .footer-public ul li { margin-bottom: 0.5rem; font-size: 0.88rem; }
      .footer-public a {
        color: #94a3b8;
        text-decoration: none;
        transition: color 0.15s;
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
      }
      .footer-public a:hover { color: white; }

      .footer-social {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-top: 0.75rem;
      }
      .footer-social a {
        width: 38px; height: 38px;
        border-radius: 50%;
        background: rgba(255,255,255,0.08);
        color: #94a3b8;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s;
        text-decoration: none;
      }
      .footer-social a:hover {
        background: var(--brand);
        color: white;
        transform: translateY(-3px);
      }

      .footer-bottom {
        border-top: 1px solid rgba(255,255,255,0.08);
        margin-top: 2.5rem;
        padding-top: 1.25rem;
        font-size: 0.82rem;
        color: #64748b;
      }

      /* ================================================
         FLOTANTES: WHATSAPP + IR ARRIBA
         ================================================ */
      .whatsapp-float {
        position: fixed;
        bottom: 24px; left: 24px;
        width: 52px; height: 52px;
        border-radius: 50%;
        background: #25d366;
        color: white;
        display: flex; align-items: center; justify-content: center;
        font-size: 1.6rem;
        box-shadow: 0 4px 16px rgba(37,211,102,0.45);
        z-index: 1040;
        transition: all 0.25s;
      }
      .whatsapp-float:hover {
        color: white;
        transform: scale(1.1);
        box-shadow: 0 6px 20px rgba(37,211,102,0.6);
      }
      .scroll-top {
        position: fixed;
        bottom: 24px; right: 24px;
        width: 48px; height: 48px;
        border-radius: 50%;
        background: var(--brand);
        color: white;
        border: none;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 4px 12px rgba(13,110,253,0.4);
        opacity: 0;
        visibility: hidden;
        transition: all 0.3s;
        z-index: 1040;
      }
      .scroll-top.visible { opacity: 1; visibility: visible; }
      .scroll-top:hover { background: var(--brand-dark); transform: translateY(-3px); }

      /* ================================================
         TOASTS
         ================================================ */
      .toast-container-jp {
        position: fixed;
        top: calc(var(--navbar-height) + 16px);
        right: 16px;
        z-index: 1070;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        max-width: calc(100vw - 32px);
        pointer-events: none;
      }
      .toast-jp {
        pointer-events: auto;
        background: white;
        border-radius: 0.75rem;
        box-shadow: 0 8px 24px rgba(0,0,0,0.15);
        padding: 0.75rem 1rem;
        display: flex;
        align-items: center;
        gap: 0.75rem;
        min-width: 260px;
        max-width: 100%;
        animation: toastSlideIn 0.3s ease;
        border-left: 4px solid var(--brand);
        transition: opacity 0.3s, transform 0.3s;
      }
      .toast-jp.success { border-left-color: #10b981; }
      .toast-jp.error { border-left-color: #dc3545; }
      @keyframes toastSlideIn {
        from { transform: translateX(120%); opacity: 0; }
        to { transform: translateX(0); opacity: 1; }
      }

      /* ================================================
         RESPONSIVE
         ================================================ */
      @media (max-width: 991px) {
        .navbar-public .brand-name { max-width: 140px; }
      }
      @media (max-width: 576px) {
        :root {
          --navbar-height: 60px;
          --sidebar-width: 100vw;
          --drawer-width: 300px;
        }
        .footer-public { padding: 2rem 0 1rem; }
        .footer-public h6 { margin-bottom: 0.75rem; margin-top: 0.5rem; }
        .whatsapp-float { width: 48px; height: 48px; font-size: 1.4rem; bottom: 16px; left: 16px; }
        .scroll-top { width: 44px; height: 44px; bottom: 16px; right: 16px; }
        .toast-container-jp { top: calc(var(--navbar-height) + 12px); right: 12px; left: 12px; }
        .toast-jp { min-width: auto; width: 100%; }
        .btn-nav-ghost .btn-label { display: none; }
        .navbar-public .brand-name { max-width: 120px; }
      }
      @media (prefers-reduced-motion: reduce) {
        .side-drawer, .cart-sidebar, .drawer-backdrop, .cart-overlay, .toast-jp { transition: none; animation: none; }
      }

