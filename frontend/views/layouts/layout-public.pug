    script.
      // ================================================
      // UTILIDADES
      // ================================================
      function esc(value) {
        return String(value == null ? '' : value).replace(/[&<>"']/g, function (c) {
          return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
        });
      }
      const PLACEHOLDER_IMG = "data:image/svg+xml;charset=utf-8,%3Csvg xmlns='http://www.w3.org/2000/svg' width='60' height='60'%3E%3Crect width='60' height='60' fill='%23f1f5f9'/%3E%3C/svg%3E";

      // ================================================
      // DRAWER LATERAL (IZQUIERDA)
      // ================================================
      const drawerEl = document.getElementById('sideDrawer');
      const drawerBackdrop = document.getElementById('drawerBackdrop');
      const drawerToggleBtn = document.getElementById('drawerToggle');

      function openDrawer() {
        if (!drawerEl) return;
        drawerEl.classList.add('open');
        drawerBackdrop.classList.add('show');
        drawerEl.setAttribute('aria-hidden', 'false');
        if (drawerToggleBtn) drawerToggleBtn.setAttribute('aria-expanded', 'true');
        document.body.style.overflow = 'hidden';
      }

      function closeDrawer() {
        if (!drawerEl) return;
        drawerEl.classList.remove('open');
        drawerBackdrop.classList.remove('show');
        drawerEl.setAttribute('aria-hidden', 'true');
        if (drawerToggleBtn) drawerToggleBtn.setAttribute('aria-expanded', 'false');
        document.body.style.overflow = '';
      }

      (function initDrawer() {
        const closeBtn = document.getElementById('drawerClose');

        if (drawerToggleBtn) drawerToggleBtn.addEventListener('click', openDrawer);
        if (closeBtn) closeBtn.addEventListener('click', closeDrawer);
        if (drawerBackdrop) drawerBackdrop.addEventListener('click', closeDrawer);

        if (drawerEl) {
          drawerEl.querySelectorAll('a.drawer-link, a.drawer-sub-link, a.btn-drawer-primary, a.btn-drawer-outline')
            .forEach(function (link) {
              link.addEventListener('click', function () { setTimeout(closeDrawer, 120); });
            });

          // Marcar enlace activo según la URL
          drawerEl.querySelectorAll('a.drawer-link[href]').forEach(function (a) {
            const href = a.getAttribute('href');
            if (!href || href.indexOf('?') !== -1) return;
            const isActive = href === '/' ? location.pathname === '/' : location.pathname.startsWith(href);
            if (isActive) a.classList.add('active');
          });
        }
      })();

      // ================================================
      // BUSCADOR EN VIVO
      // ================================================
      (function initLiveSearch() {
        const liveSearch = document.getElementById('liveSearch');
        const searchResults = document.getElementById('searchResults');
        const searchList = document.getElementById('searchList');
        const searchLoading = document.querySelector('.search-loading');
        const searchEmpty = document.querySelector('.search-empty');
        let searchTimeout = null;
        let requestId = 0;

        if (!liveSearch || !searchResults) return;

        liveSearch.addEventListener('input', function () {
          const q = this.value.trim();
          clearTimeout(searchTimeout);

          if (q.length < 2) {
            searchResults.classList.remove('show');
            return;
          }

          searchResults.classList.add('show');
          searchLoading.classList.remove('d-none');
          searchEmpty.classList.add('d-none');
          searchList.innerHTML = '';

          searchTimeout = setTimeout(function () {
            const currentRequest = ++requestId;
            fetch('/api/products/search?q=' + encodeURIComponent(q))
              .then(function (r) { return r.json(); })
              .then(function (data) {
                if (currentRequest !== requestId) return;
                searchLoading.classList.add('d-none');

                if (!data.products || data.products.length === 0) {
                  searchEmpty.classList.remove('d-none');
                  return;
                }

                searchList.innerHTML = data.products.slice(0, 8).map(function (p) {
                  const price = Number(p.finalPrice != null ? p.finalPrice : p.customerPrice) || 0;
                  const meta = [p.category ? p.category.name : '', p.model || ''].filter(Boolean).map(esc).join(' · ');
                  return '' +
                    '<a href="/products/' + encodeURIComponent(p._id) + '" class="search-result-item">' +
                      '<div class="search-result-img">' +
                        (p.image
                          ? '<img src="' + esc(p.image) + '" alt="' + esc(p.name) + '">'
                          : '<i class="fas fa-image text-muted"></i>') +
                      '</div>' +
                      '<div class="search-result-info">' +
                        '<div class="search-result-title">' + esc(p.name) + '</div>' +
                        '<div class="search-result-meta">' + meta + '</div>' +
                      '</div>' +
                      '<div class="search-result-price">S/. ' + price.toFixed(2) + '</div>' +
                    '</a>';
                }).join('') +
                  '<div class="search-footer">' +
                    '<a href="/products?q=' + encodeURIComponent(q) + '">Ver todos los resultados →</a>' +
                  '</div>';
              })
              .catch(function (err) {
                console.error('Error buscando:', err);
                searchLoading.classList.add('d-none');
                searchEmpty.classList.remove('d-none');
              });
          }, 300);
        });

        document.addEventListener('click', function (e) {
          if (!e.target.closest('.nav-search')) searchResults.classList.remove('show');
        });

        liveSearch.addEventListener('keydown', function (e) {
          if (e.key === 'Escape') {
            searchResults.classList.remove('show');
            this.blur();
          }
        });
      })();

      // ================================================
      // CARRITO CON LOCALSTORAGE
      // ================================================
      const CART_KEY = 'jp_cart';

      function getCart() {
        try { return JSON.parse(localStorage.getItem(CART_KEY)) || []; }
        catch (e) { return []; }
      }

      function saveCart(cart) {
        try { localStorage.setItem(CART_KEY, JSON.stringify(cart)); } catch (e) {}
        updateCartUI();
      }

      function addToCart(product) {
        const cart = getCart();
        const id = String(product.id);
        const existing = cart.find(function (i) { return String(i.id) === id; });
        if (existing) {
          existing.qty += 1;
        } else {
          cart.push({
            id: id,
            name: product.name,
            price: Number(product.price) || 0,
            image: product.image || '',
            qty: 1
          });
        }
        saveCart(cart);
        showToast('"' + esc(product.name) + '" agregado al carrito', 'success');
        openCart();
      }

      function removeFromCart(id) {
        const cleanId = String(id);
        saveCart(getCart().filter(function (i) { return String(i.id) !== cleanId; }));
      }

      function updateQty(id, delta) {
        const cleanId = String(id);
        const cart = getCart();
        const item = cart.find(function (i) { return String(i.id) === cleanId; });
        if (!item) return;
        item.qty += delta;
        if (item.qty <= 0) return removeFromCart(cleanId);
        saveCart(cart);
      }

      function updateCartUI() {
        const cart = getCart();
        const count = cart.reduce(function (s, i) { return s + i.qty; }, 0);
        const subtotal = cart.reduce(function (s, i) { return s + (i.price * i.qty); }, 0);

        const cartCount = document.getElementById('cartCount');
        const cartSubtotal = document.getElementById('cartSubtotal');
        const cartTotal = document.getElementById('cartTotal');

        if (cartCount) cartCount.textContent = count;
        if (cartSubtotal) cartSubtotal.textContent = 'S/. ' + subtotal.toFixed(2);
        if (cartTotal) cartTotal.textContent = 'S/. ' + subtotal.toFixed(2);

        const body = document.getElementById('cartBody');
        const empty = document.getElementById('cartEmpty');
        if (!body) return;

        body.querySelectorAll('.cart-item').forEach(function (el) { el.remove(); });

        if (cart.length === 0) {
          if (empty) empty.style.display = '';
          return;
        }
        if (empty) empty.style.display = 'none';

        cart.forEach(function (item) {
          const div = document.createElement('div');
          div.className = 'cart-item';
          div.innerHTML =
            '<img src="' + esc(item.image || PLACEHOLDER_IMG) + '" alt="' + esc(item.name) + '">' +
            '<div class="cart-item-info">' +
              '<div class="cart-item-title">' + esc(item.name) + '</div>' +
              '<div class="text-primary fw-bold small mt-1">S/. ' + Number(item.price).toFixed(2) + '</div>' +
              '<div class="d-flex align-items-center gap-2 mt-2">' +
                '<button type="button" class="btn btn-sm btn-outline-secondary rounded-circle p-0 cart-qty-btn" style="width:26px;height:26px;" data-action="decrease" data-id="' + esc(item.id) + '" aria-label="Quitar uno">−</button>' +
                '<span class="small fw-bold">' + item.qty + '</span>' +
                '<button type="button" class="btn btn-sm btn-outline-secondary rounded-circle p-0 cart-qty-btn" style="width:26px;height:26px;" data-action="increase" data-id="' + esc(item.id) + '" aria-label="Agregar uno">+</button>' +
                '<button type="button" class="btn btn-sm btn-link text-danger ms-auto p-0 cart-remove-btn" data-id="' + esc(item.id) + '" aria-label="Eliminar">' +
                  '<i class="fas fa-trash"></i>' +
                '</button>' +
              '</div>' +
            '</div>';
          body.appendChild(div);
        });
      }

      function openCart() {
        const s = document.getElementById('cartSidebar');
        const o = document.getElementById('cartOverlay');
        if (s) { s.classList.add('open'); s.setAttribute('aria-hidden', 'false'); }
        if (o) o.classList.add('open');
        document.body.style.overflow = 'hidden';
      }

      function closeCart() {
        const s = document.getElementById('cartSidebar');
        const o = document.getElementById('cartOverlay');
        if (s) { s.classList.remove('open'); s.setAttribute('aria-hidden', 'true'); }
        if (o) o.classList.remove('open');
        document.body.style.overflow = '';
      }

      // ================================================
      // TOAST (el mensaje debe llegar ya escapado si viene de datos)
      // ================================================
      function showToast(message, type) {
        type = type || 'success';
        const container = document.getElementById('toastContainer');
        if (!container) return;
        const icon = type === 'success' ? 'fa-check-circle text-success'
                  : type === 'error' ? 'fa-exclamation-circle text-danger'
                  : 'fa-info-circle text-primary';
        const toast = document.createElement('div');
        toast.className = 'toast-jp ' + type;
        toast.innerHTML =
          '<i class="fas ' + icon + ' fa-lg"></i>' +
          '<div class="flex-grow-1 small fw-semibold">' + message + '</div>';
        container.appendChild(toast);
        setTimeout(function () {
          toast.style.opacity = '0';
          toast.style.transform = 'translateX(120%)';
          setTimeout(function () { toast.remove(); }, 300);
        }, 2500);
      }

      // ================================================
      // EVENTOS GLOBALES
      // ================================================
      document.addEventListener('click', function (e) {
        const qtyBtn = e.target.closest('.cart-qty-btn');
        if (qtyBtn) {
          e.preventDefault();
          updateQty(qtyBtn.dataset.id, qtyBtn.dataset.action === 'increase' ? 1 : -1);
          return;
        }
        const removeBtn = e.target.closest('.cart-remove-btn');
        if (removeBtn) {
          e.preventDefault();
          removeFromCart(removeBtn.dataset.id);
        }
      });

      document.addEventListener('keydown', function (e) {
        if (e.key !== 'Escape') return;
        if (drawerEl && drawerEl.classList.contains('open')) closeDrawer();
        const cs = document.getElementById('cartSidebar');
        if (cs && cs.classList.contains('open')) closeCart();
      });

      document.addEventListener('DOMContentLoaded', function () {
        updateCartUI();

        const cartBtn = document.getElementById('cartBtn');
        if (cartBtn) cartBtn.addEventListener('click', openCart);

        const cartClose = document.getElementById('cartClose');
        if (cartClose) cartClose.addEventListener('click', closeCart);

        const cartOverlay = document.getElementById('cartOverlay');
        if (cartOverlay) cartOverlay.addEventListener('click', closeCart);

        // Botones "Agregar al carrito" (de cualquier página que extienda este layout)
        document.querySelectorAll('.btn-add-cart').forEach(function (btn) {
          btn.addEventListener('click', function () {
            addToCart({
              id: this.dataset.id,
              name: this.dataset.name,
              price: parseFloat(this.dataset.price),
              image: this.dataset.image
            });
          });
        });

        // Ir arriba
        const scrollTop = document.getElementById('scrollTop');
        if (scrollTop) {
          window.addEventListener('scroll', function () {
            scrollTop.classList.toggle('visible', window.scrollY > 300);
          }, { passive: true });
          scrollTop.addEventListener('click', function () {
            window.scrollTo({ top: 0, behavior: 'smooth' });
          });
        }
      });

    //- JS específico de cada página
    block scripts
