              li.mb-2: a(href="/settings") Configuración
              li.mb-2: a(href="/logout") Cerrar Sesión

          .col-md-4
            h6 Contacto
            ul.list-unstyled.mb-0.small
              if setting && setting.company && setting.company.phone
                li.mb-2
                  i.fas.fa-phone.me-2
                  = setting.company.phone
              if setting && setting.company && setting.company.email
                li.mb-2
                  i.fas.fa-envelope.me-2
                  = setting.company.email
              if setting && setting.company && setting.company.address
                li.mb-2
                  i.fas.fa-map-location-dot.me-2
                  = setting.company.address
              if setting && setting.schedule && setting.schedule.weekdays
                li.mb-2
                  i.fas.fa-clock.me-2
                  | Lun - Vie: #{setting.schedule.weekdays}

        .footer-bottom
          .d-flex.flex-wrap.justify-content-between.align-items-center.gap-2
