            .d-flex.gap-2
              if setting && setting.social && setting.social.facebook
                a(href=setting.social.facebook target="_blank" title="Facebook").text-decoration-none
                  i.fab.fa-facebook-f.fa-lg
              if setting && setting.social && setting.social.instagram
                a(href=setting.social.instagram target="_blank" title="Instagram").text-decoration-none
                  i.fab.fa-instagram.fa-lg
              if setting && setting.social && setting.social.youtube
                a(href=setting.social.youtube target="_blank" title="YouTube").text-decoration-none
                  i.fab.fa-youtube.fa-lg
              if setting && setting.social && setting.social.whatsapp
                a(href=`https://wa.me/${setting.social.whatsapp}` target="_blank" title="WhatsApp").text-decoration-none
                  i.fab.fa-whatsapp.fa-lg

          .col-md-2.col-6
