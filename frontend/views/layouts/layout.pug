doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")

    //- ============================================
    //- SEO
    //- ============================================
    - const pageTitle = (typeof title !== 'undefined' && title) ? (title + ' | ' + (setting && setting.siteName ? setting.siteName : 'JP Security')) : ((setting && setting.siteName) ? setting.siteName : 'JP Security')
    title= pageTitle

    if setting && setting.favicon
      link(rel="icon" href=setting.favicon)

    //- ============================================
    //- CSS GLOBAL
    //- ============================================
    link(rel="stylesheet" href="/bootstrap/css/bootstrap.min.css")
    link(rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css")
    link(rel="stylesheet" href="/css/styles.css")

    //- ============================================
    //- VARIABLES DE MARCA
    //- ============================================
    - const brandPrimary = (setting && setting.colors && setting.colors.primary) ? setting.colors.primary : '#0d6efd'
    - const brandSecondary = (setting && setting.colors && setting.colors.secondary) ? setting.colors.secondary : '#0a58ca'
    - const brandAccent = (setting && setting.colors && setting.colors.accent) ? setting.colors.accent : '#ffc107'

    style.
      :root {
        --brand: #{brandPrimary};
        --brand-dark: #{brandSecondary};
        --brand-accent: #{brandAccent};
        --navbar-height: 64px;
        --drawer-width: 320px;
      }

      html, body { height: 100%; }

      body {
        font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
        color: #1f2937;
        background: #f8fafc;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        overflow-x: hidden;
      }

      main {
        flex: 1 0 auto;
        padding-top: calc(var(--navbar-height) + 24px);
        padding-bottom: 40px;
      }

      /* ================================================
         NAVBAR
         ================================================ */
      .navbar-admin {
        height: var(--navbar-height);
        padding: 0;
        background: #0f172a !important;
        box-shadow: 0 2px 12px rgba(0,0,0,0.15);
        z-index: 1040;
      }
      .navbar-admin .container-fluid {
        height: 100%;
        display: flex;
        align-items: center;
        gap: 0.75rem;
      }
      .navbar-admin .navbar-brand {
        font-weight: 700;
        font-size: 1.15rem;
        letter-spacing: -0.3px;
        padding: 0;
        margin: 0;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        color: #fff !important;
      }
      .navbar-admin .navbar-brand img { max-height: 42px; width: auto; }
      .navbar-admin .brand-name {
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        max-width: 200px;
      }

      /* Botón hamburguesa */
      .btn-hamburger {
        width: 42px; height: 42px;
        border-radius: 10px;
        background: rgba(255,255,255,0.08);
        border: none;
        color: #fff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
        transition: all 0.2s;
        flex-shrink: 0;
      }
      .btn-hamburger:hover,
      .btn-hamburger:focus { background: var(--brand); color: #fff; }

      .navbar-actions {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-left: auto;
        flex-shrink: 0;
      }
      .btn-nav-ghost {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        height: 40px;
        padding: 0 0.9rem;
        border-radius: 10px;
        background: rgba(255,255,255,0.08);
        border: none;
        color: #fff;
        font-size: 0.875rem;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.2s;
        white-space: nowrap;
      }
      .btn-nav-ghost:hover { background: var(--brand); color: #fff; }

      /* Campana de notificaciones */
      .btn-icon-nav {
        position: relative;
        width: 42px; height: 42px;
        border-radius: 50%;
        background: rgba(255,255,255,0.1);
        border: none;
        color: white;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s;
      }
      .btn-icon-nav:hover { background: var(--brand); color: white; }
      .btn-icon-nav .badge-notif {
        position: absolute;
        top: -2px; right: -2px;
        background: #dc3545;
        color: white;
        font-size: 0.65rem;
        min-width: 20px; height: 20px;
        border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        font-weight: 700; padding: 0 5px;
        border: 2px solid #0f172a;
      }

      /* Avatar navbar */
      .avatar-nav {
        width: 38px; height: 38px;
        border-radius: 50%;
        background: linear-gradient(135deg, var(--brand), var(--brand-dark));
        color: #fff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 0.9rem;
        flex-shrink: 0;
      }

      /* ================================================
         DRAWER LATERAL (IZQUIERDA)
         ================================================ */
      .drawer-backdrop {
        position: fixed;
        inset: 0;
        background: rgba(15,23,42,0.55);
        backdrop-filter: blur(3px);
        -webkit-backdrop-filter: blur(3px);
        z-index: 1050;
        opacity: 0;
        visibility: hidden;
        transition: opacity 0.3s ease, visibility 0.3s ease;
      }
      .drawer-backdrop.show { opacity: 1; visibility: visible; }

      .side-drawer {
        position: fixed;
        top: 0;
        left: 0;
        width: var(--drawer-width);
        max-width: 88vw;
        height: 100vh;
        height: 100dvh;
        background: #0f172a;
        color: #e2e8f0;
        z-index: 1055;
        transform: translateX(-100%);
        transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1);
        display: flex;
        flex-direction: column;
        box-shadow: 8px 0 32px rgba(0,0,0,0.35);
        overflow: hidden;
      }
      .side-drawer.open { transform: translateX(0); }

      .drawer-header {
        padding: 1rem 1.25rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-bottom: 1px solid rgba(255,255,255,0.08);
        flex-shrink: 0;
        background: #0f172a;
      }
      .drawer-brand {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        color: #fff;
        font-weight: 700;
        font-size: 1.05rem;
        text-decoration: none;
      }
      .drawer-brand:hover { color: #fff; }
      .drawer-brand img { max-height: 34px; }

      .drawer-close {
        width: 36px; height: 36px;
        border-radius: 10px;
        background: rgba(255,255,255,0.08);
        border: none;
        color: #fff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s;
      }
      .drawer-close:hover { background: #dc3545; }

      .drawer-body {
        flex: 1 1 auto;
        overflow-y: auto;
        overflow-x: hidden;
        padding: 0.5rem 0;
        -webkit-overflow-scrolling: touch;
        overscroll-behavior: contain;
      }
      .drawer-body::-webkit-scrollbar { width: 6px; }
      .drawer-body::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.15); border-radius: 3px; }

      .drawer-nav { list-style: none; padding: 0; margin: 0; }
      .drawer-nav li { list-style: none; }

      .drawer-link {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.85rem 1.25rem;
        color: #cbd5e1;
        text-decoration: none;
        font-size: 0.925rem;
        font-weight: 500;
        border: none;
        background: transparent;
        width: 100%;
        text-align: left;
        transition: all 0.2s;
        cursor: pointer;
        position: relative;
      }
      .drawer-link:hover,
      .drawer-link:focus {
        background: rgba(255,255,255,0.06);
        color: #fff;
        padding-left: 1.5rem;
      }
      .drawer-link i.drawer-icon {
        width: 22px;
        text-align: center;
        font-size: 1rem;
        color: var(--brand);
        flex-shrink: 0;
      }
      .drawer-link .drawer-label {
        flex: 1;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      .drawer-link .drawer-chevron {
        font-size: 0.7rem;
        transition: transform 0.25s;
        color: #64748b;
      }
      .drawer-link[aria-expanded="true"] .drawer-chevron { transform: rotate(90deg); }

      .drawer-section-label {
        padding: 1rem 1.25rem 0.5rem;
        font-size: 0.7rem;
        text-transform: uppercase;
        letter-spacing: 1.2px;
        font-weight: 700;
        color: #64748b;
      }

      .drawer-submenu {
        list-style: none;
        padding: 0;
        margin: 0;
        background: rgba(0,0,0,0.25);
        overflow: hidden;
      }
      .drawer-submenu .drawer-sub-link {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        padding: 0.65rem 1.25rem 0.65rem 3.25rem;
        color: #94a3b8;
        text-decoration: none;
        font-size: 0.875rem;
        transition: all 0.2s;
      }
      .drawer-submenu .drawer-sub-link:hover {
        background: rgba(255,255,255,0.05);
        color: #fff;
        padding-left: 3.5rem;
      }
      .drawer-submenu .drawer-sub-link i {
        font-size: 0.75rem;
        color: #64748b;
        width: 14px;
        text-align: center;
      }

      /* Footer del drawer */
      .drawer-footer {
        flex-shrink: 0;
        border-top: 1px solid rgba(255,255,255,0.08);
        padding: 1rem 1.25rem;
        background: #0b1220;
      }
      .drawer-footer .drawer-user {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        margin-bottom: 0.75rem;
      }
      .drawer-footer .drawer-avatar {
        width: 40px; height: 40px;
        border-radius: 50%;
        background: linear-gradient(135deg, var(--brand), var(--brand-dark));
        color: #fff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        flex-shrink: 0;
      }
      .drawer-footer .drawer-user-info { min-width: 0; flex: 1; }
      .drawer-footer .drawer-user-name {
        font-weight: 700;
        color: #fff;
        font-size: 0.9rem;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      .drawer-footer .drawer-user-email {
        font-size: 0.75rem;
        color: #94a3b8;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      .drawer-footer .btn-drawer-primary {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        width: 100%;
        padding: 0.7rem;
        border-radius: 10px;
        background: var(--brand);
        border: none;
        color: #fff;
        font-weight: 600;
        font-size: 0.9rem;
        text-decoration: none;
        transition: all 0.2s;
      }
      .drawer-footer .btn-drawer-primary:hover { background: var(--brand-dark); color: #fff; }
      .drawer-footer .btn-drawer-outline {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        width: 100%;
        padding: 0.7rem;
        border-radius: 10px;
        background: rgba(255,255,255,0.08);
        border: none;
        color: #fff;
        font-weight: 600;
        font-size: 0.9rem;
        text-decoration: none;
        transition: all 0.2s;
      }
      .drawer-footer .btn-drawer-outline:hover { background: rgba(255,255,255,0.16); color: #fff; }

      /* ================================================
         FOOTER
         ================================================ */
      .footer-main {
        background: #0f172a;
        color: #94a3b8;
        padding: 3rem 0 1.5rem;
        margin-top: auto;
        flex-shrink: 0;
      }
      .footer-main h6 {
        color: white;
        font-weight: 600;
        text-transform: uppercase;
        font-size: 0.75rem;
        letter-spacing: 1px;
        margin-bottom: 1rem;
      }
      .footer-main a {
        color: #94a3b8;
        text-decoration: none;
        transition: color 0.15s;
        font-size: 0.9rem;
      }
      .footer-main a:hover { color: white; }
      .footer-main .footer-bottom {
        border-top: 1px solid rgba(255,255,255,0.1);
        padding-top: 1.5rem;
        margin-top: 2rem;
      }

      /* ================================================
         FLASH MESSAGES
         ================================================ */
      .flash-wrapper { padding-top: calc(var(--navbar-height) + 16px); }

      /* ================================================
         RESPONSIVE
         ================================================ */
      @media (max-width: 991px) {
        .navbar-admin .brand-name { max-width: 140px; }
      }
      @media (max-width: 576px) {
        :root {
          --navbar-height: 60px;
          --drawer-width: 300px;
        }
        .footer-main { padding: 2rem 0 1rem; }
        .footer-main h6 { margin-bottom: 0.75rem; margin-top: 0.5rem; }
        .btn-nav-ghost .btn-label { display: none; }
        .navbar-admin .brand-name { max-width: 120px; }
      }

  body

    //- ============================================
    //- NAVBAR ADMIN
    //- ============================================
    nav.navbar.navbar-dark.navbar-admin.fixed-top
      .container-fluid.px-2.px-md-3

        //- Hamburguesa
        button.btn-hamburger#drawerToggle(
          type="button"
          aria-label="Abrir menú"
          aria-controls="sideDrawer"
          aria-expanded="false"
        )
          i.fas.fa-bars

        //- Logo
        a.navbar-brand.ms-2(href="/")
          if setting && setting.logo
            img(src=setting.logo alt=(setting.siteName || 'Logo'))
          else
            i.fas.fa-shield-alt.me-2
          span.brand-name.d-none.d-sm-inline= setting && setting.siteName ? setting.siteName : 'JP Security'

        //- Acciones
        .navbar-actions

          //- Ver tienda
          a.btn-nav-ghost.d-none.d-md-inline-flex(
            href="/landing"
            target="_blank"
            title="Ver tienda pública"
          )
            i.fas.fa-store
            span.btn-label Tienda

          //- Campana de notificaciones
          .dropdown.notification-dropdown
            button.btn-icon-nav#notifBellBtn(
              type="button"
              data-bs-toggle="dropdown"
              data-bs-auto-close="outside"
              aria-expanded="false"
              title="Notificaciones"
            )
              i.fas.fa-bell
              span.badge-notif#notificationBadge(
                class=(pendingOrdersCount > 0 ? '' : 'd-none')
              )= pendingOrdersCount || 0

            ul.dropdown-menu.dropdown-menu-end.shadow-lg.rounded-3.border-0.p-0.notif-menu
              li.px-3.py-3.border-bottom.d-flex.justify-content-between.align-items-center
                div
                  h6.mb-0.fw-bold
                    i.fas.fa-bell.me-2.text-primary
                    | Notificaciones
                  small.text-muted#notifSubtitle
                    = (pendingOrdersCount || 0) + ' pedidos pendientes'
                a.btn.btn-sm.btn-link.text-decoration-none.p-0(
                  href="/orders?status=pendiente"
                  title="Ver todos"
                )
                  i.fas.fa-arrow-right

              li
                #notificationList.notif-list
                  li.text-center.py-5.text-muted
                    i.fas.fa-spinner.fa-spin.fa-2x.mb-3.opacity-50.d-block
                    p.mb-0 Cargando notificaciones...

          //- Usuario
          if user
            .dropdown
              button.btn-icon-nav(
                type="button"
                data-bs-toggle="dropdown"
                aria-expanded="false"
                title=user.name
              )
                .avatar-nav= (user.name || 'U').charAt(0).toUpperCase()

              ul.dropdown-menu.dropdown-menu-end.shadow-lg.rounded-3.border-0
                li
                  h6.dropdown-header.mb-0
                    .d-flex.align-items-center.gap-2
                      .avatar-nav= (user.name || 'U').charAt(0).toUpperCase()
                      div
                        div.fw-bold= user.name
                        small.text-muted= user.email || ''
                li: hr.dropdown-divider
                li
                  a.dropdown-item(href="/profile")
                    i.fas.fa-id-card.me-2.text-primary
                    | Mi Perfil
                li
                  a.dropdown-item(href="/landing" target="_blank")
                    i.fas.fa-store.me-2.text-primary
                    | Ver tienda
                li
                  a.dropdown-item(href="/settings")
                    i.fas.fa-cog.me-2.text-primary
                    | Configuración
                li: hr.dropdown-divider
                li
                  a.dropdown-item.text-danger(href="/logout")
                    i.fas.fa-sign-out-alt.me-2
                    | Cerrar Sesión

    //- ============================================
    //- DRAWER LATERAL (IZQUIERDA)
    //- ============================================
    .drawer-backdrop#drawerBackdrop
    aside.side-drawer#sideDrawer(aria-hidden="true" role="navigation")

      //- Header del drawer
      .drawer-header
        a.drawer-brand(href="/")
          if setting && setting.logo
            img(src=setting.logo alt=(setting.siteName || 'Logo'))
          else
            i.fas.fa-shield-alt
          span= setting && setting.siteName ? setting.siteName : 'JP Security'

        button.drawer-close#drawerClose(type="button" aria-label="Cerrar menú")
          i.fas.fa-times

      //- Body scrolleable
      .drawer-body

        .drawer-section-label Principal
        ul.drawer-nav
          li
            a.drawer-link(href="/")
              i.fas.fa-home.drawer-icon
              span.drawer-label Dashboard

          li
            a.drawer-link(href="/landing" target="_blank")
              i.fas.fa-store.drawer-icon
              span.drawer-label Ver Tienda

        //- SEGURIDAD
        .drawer-section-label Seguridad
        ul.drawer-nav
          li
            a.drawer-link(href="/users")
              i.fas.fa-users.drawer-icon
              span.drawer-label Usuarios
          li
            a.drawer-link(href="/clients")
              i.fas.fa-building.drawer-icon
              span.drawer-label Clientes
          li
            a.drawer-link(href="/suppliers")
              i.fas.fa-handshake.drawer-icon
              span.drawer-label Proveedores

        //- INVENTARIO (colapsable)
        .drawer-section-label Inventario
        ul.drawer-nav
          li
            button.drawer-link(
              type="button"
              data-bs-toggle="collapse"
              data-bs-target="#drawerInv"
              aria-expanded="false"
              aria-controls="drawerInv"
            )
              i.fas.fa-boxes-stacked.drawer-icon
              span.drawer-label Inventario
              i.fas.fa-chevron-right.drawer-chevron

            .collapse#drawerInv
              ul.drawer-submenu
                li
                  a.drawer-sub-link(href="/products")
                    i.fas.fa-box
                    span Productos
                li
                  a.drawer-sub-link(href="/categories")
                    i.fas.fa-tags
                    span Categorías
                li
                  a.drawer-sub-link(href="/brands")
                    i.fas.fa-trademark
                    span Marcas
                li
                  a.drawer-sub-link(href="/warehouses")
                    i.fas.fa-warehouse
                    span Almacenes

        //- VENTAS (colapsable)
        .drawer-section-label Ventas
        ul.drawer-nav
          li
            button.drawer-link(
              type="button"
              data-bs-toggle="collapse"
              data-bs-target="#drawerVentas"
              aria-expanded="false"
              aria-controls="drawerVentas"
            )
              i.fas.fa-shopping-cart.drawer-icon
              span.drawer-label Ventas
              i.fas.fa-chevron-right.drawer-chevron

            .collapse#drawerVentas
              ul.drawer-submenu
                li
                  a.drawer-sub-link(href="/quotations")
                    i.fas.fa-file-invoice
                    span Cotizaciones
                li
                  a.drawer-sub-link(href="/orders")
                    i.fas.fa-clipboard-list
                    span Pedidos
                li
                  a.drawer-sub-link(href="/sales")
                    i.fas.fa-cart-plus
                    span Ventas
                li
                  a.drawer-sub-link(href="/vouchers")
                    i.fas.fa-file-pdf
                    span Comprobantes

        //- SERVICIOS (colapsable)
        .drawer-section-label Servicios
        ul.drawer-nav
          li
            button.drawer-link(
              type="button"
              data-bs-toggle="collapse"
              data-bs-target="#drawerServ"
              aria-expanded="false"
              aria-controls="drawerServ"
            )
              i.fas.fa-tools.drawer-icon
              span.drawer-label Servicios
              i.fas.fa-chevron-right.drawer-chevron

            .collapse#drawerServ
              ul.drawer-submenu
                li
                  a.drawer-sub-link(href="/installations")
                    i.fas.fa-wrench
                    span Instalaciones
                li
                  a.drawer-sub-link(href="/maintenances")
                    i.fas.fa-sync-alt
                    span Mantenimientos
                li
                  a.drawer-sub-link(href="/visits")
                    i.fas.fa-clipboard-check
                    span Visitas
                li
                  a.drawer-sub-link(href="/work-orders")
                    i.fas.fa-tasks
                    span Órdenes de Trabajo
                li
                  a.drawer-sub-link(href="/projects")
                    i.fas.fa-project-diagram
                    span Proyectos

        //- ANALÍTICA
        .drawer-section-label Analítica
        ul.drawer-nav
          li
            a.drawer-link(href="/reports/sales")
              i.fas.fa-chart-line.drawer-icon
              span.drawer-label Reportes

        //- SISTEMA
        .drawer-section-label Sistema
        ul.drawer-nav
          li
            a.drawer-link(href="/settings")
              i.fas.fa-cog.drawer-icon
              span.drawer-label Configuración
          li
            a.drawer-link(href="/about/admin")
              i.fas.fa-building.drawer-icon
              span.drawer-label Nosotros

      //- Footer del drawer
      .drawer-footer
        if user
          .drawer-user
            .drawer-avatar= (user.name || 'U').charAt(0).toUpperCase()
            .drawer-user-info
              .drawer-user-name= user.name
              .drawer-user-email= user.email || ''
          a.btn-drawer-outline(href="/logout")
            i.fas.fa-sign-out-alt
            | Cerrar Sesión

    //- ============================================
    //- FLASH MESSAGES
    //- ============================================
    if (success && success.length) || (error && error.length)
      .container.flash-wrapper
        if success && success.length
          .alert.alert-success.alert-dismissible.fade.show.rounded-3.shadow-sm(role="alert")
            i.fas.fa-check-circle.me-2
            = success
            button.btn-close(type="button" data-bs-dismiss="alert" aria-label="Cerrar")
        if error && error.length
          .alert.alert-danger.alert-dismissible.fade.show.rounded-3.shadow-sm(role="alert")
            i.fas.fa-exclamation-circle.me-2
            = error
            button.btn-close(type="button" data-bs-dismiss="alert" aria-label="Cerrar")

    //- ============================================
