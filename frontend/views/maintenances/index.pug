extends ../layouts/layout

block content

  //- ============================================
  //- HEADER
  //- ============================================
  .mnt-page-header.mb-3.mb-md-4
    .d-flex.flex-wrap.justify-content-between.align-items-center.gap-2.gap-md-3
      div.min-w-0
        nav.d-none.d-md-block(aria-label="breadcrumb")
          ol.breadcrumb.mb-1
            li.breadcrumb-item
              a.text-decoration-none(href="/") Inicio
            li.breadcrumb-item.active(aria-current="page") Mantenimientos

        h1.h4.h3-md.fw-bold.mb-1.text-dark.text-truncate
          i.fas.fa-sync-alt.me-2.text-primary
          | Mantenimientos

        p.text-muted.mb-0.small.d-none.d-sm-block
          | Gestiona los mantenimientos programados de tus equipos

      a.btn.btn-primary.rounded-pill.px-3.px-md-4.fw-semibold.d-inline-flex.align-items-center.gap-2.mnt-new-btn(
        href="/maintenances/create"
      )
        i.fas.fa-plus-circle
        span.d-none.d-sm-inline Nuevo Mantenimiento
        span.d-sm-none Nuevo

  //- ============================================
  //- BARRA DE BÚSQUEDA Y FILTROS
  //- ============================================
  .card.border-0.shadow-sm.rounded-3.mb-3
    .card-body.p-2.p-md-3
      .row.g-2.align-items-center

        .col-12.col-md-5
          .input-group
            span.input-group-text.bg-transparent.border-end-0
              i.fas.fa-search.text-muted
            input.form-control.border-start-0#searchInput(
              type="text"
              placeholder="Buscar cliente, equipo o técnico..."
              autocomplete="off"
            )

        .col-6.col-md-3
          select.form-select#statusFilter
            option(value="") Estado
            option(value="Pendiente") Pendiente
            option(value="En proceso") En proceso
            option(value="Completado") Completado
            option(value="Cancelado") Cancelado

        .col-6.col-md-2
          select.form-select#typeFilter
            option(value="") Tipo
            option(value="Preventivo") Preventivo
            option(value="Correctivo") Correctivo
            option(value="Predictivo") Predictivo

        .col-12.col-md-2.text-md-end
          span.badge.bg-primary-subtle.text-primary.rounded-pill.px-3.py-2.w-100.mnt-count-badge
            i.fas.fa-list.me-1
            span#resultCount= (maintenances && maintenances.length) || 0

  //- ============================================
  //- TABLA (desktop/tablet)
  //- ============================================
  .card.border-0.shadow-sm.rounded-3.d-none.d-md-block#tableCard
    .card-body.p-0
      .table-responsive
        table.table.table-hover.align-middle.mb-0.mnt-table
          thead.table-light
            tr
              th Cliente
              th Equipo
              th Tipo
              th Fecha prog.
              th Técnico
              th Estado
              th.text-end Acciones
          tbody#maintenancesTableBody
            if maintenances && maintenances.length
              each maintenance in maintenances
                - const statusClass = maintenance.status === 'Completado' ? 'mnt-badge-success' : maintenance.status === 'Cancelado' ? 'mnt-badge-danger' : maintenance.status === 'En proceso' ? 'mnt-badge-info' : 'mnt-badge-warning'
                - const statusIcon = maintenance.status === 'Completado' ? 'fa-check-circle' : maintenance.status === 'Cancelado' ? 'fa-times-circle' : maintenance.status === 'En proceso' ? 'fa-spinner' : 'fa-clock'
                - const typeClass = maintenance.type === 'Correctivo' ? 'mnt-type-danger' : maintenance.type === 'Predictivo' ? 'mnt-type-purple' : 'mnt-type-info'
                - const searchData = ((maintenance.client ? maintenance.client.businessName : '') + ' ' + (maintenance.equipment || '') + ' ' + (maintenance.technician || '')).toLowerCase()

                tr.mnt-row(
                  data-search=searchData
                  data-status=maintenance.status
                  data-type=maintenance.type
                )
                  td
                    .d-flex.align-items-center.gap-2
                      .mnt-avatar
                        i.fas.fa-user
                      div.min-w-0
                        .fw-semibold.text-truncate= maintenance.client ? maintenance.client.businessName : '-'

                  td
                    div.small.fw-semibold.text-truncate= maintenance.equipment

                  td
                    span.mnt-type-badge(class=typeClass)
                      = maintenance.type

                  td
                    div.small.fw-semibold
                      = new Date(maintenance.scheduledDate).toLocaleDateString('es-ES', { day: '2-digit', month: 'short', year: 'numeric' })

                  td
                    div.small.text-truncate= maintenance.technician

                  td
                    span.mnt-badge(class=statusClass)
                      i.fas(class=statusIcon)
                      span= maintenance.status

                  td.text-end
                    .btn-group.btn-group-sm
                      a.btn.btn-outline-info.mnt-action-btn(
                        href=`/maintenances/${maintenance._id}`
                        title="Ver"
                      )
                        i.fas.fa-eye
                      a.btn.btn-outline-warning.mnt-action-btn(
                        href=`/maintenances/${maintenance._id}/edit`
                        title="Editar"
                      )
                        i.fas.fa-edit
                      form.d-inline(
                        method="POST"
                        action=`/maintenances/${maintenance._id}?_method=DELETE`
                        onsubmit="return confirm('¿Eliminar este mantenimiento?')"
                      )
                        button.btn.btn-outline-danger.mnt-action-btn(
                          type="submit"
                          title="Eliminar"
                        )
                          i.fas.fa-trash
            else
              tr
                td(colspan="7").text-center.py-5
                  .mnt-empty
                    i.fas.fa-sync-alt.fa-3x.mb-3.opacity-25.d-block
                    p.text-muted.mb-3 No hay mantenimientos registrados
                    a.btn.btn-sm.btn-primary.rounded-pill(href="/maintenances/create")
                      i.fas.fa-plus-circle.me-1
                      | Registrar primer mantenimiento

  //- ============================================
  //- CARDS (móvil)
  //- ============================================
  .d-md-none#cardsView
    if maintenances && maintenances.length
      each maintenance in maintenances
        - const statusClass = maintenance.status === 'Completado' ? 'mnt-badge-success' : maintenance.status === 'Cancelado' ? 'mnt-badge-danger' : maintenance.status === 'En proceso' ? 'mnt-badge-info' : 'mnt-badge-warning'
        - const statusIcon = maintenance.status === 'Completado' ? 'fa-check-circle' : maintenance.status === 'Cancelado' ? 'fa-times-circle' : maintenance.status === 'En proceso' ? 'fa-spinner' : 'fa-clock'
        - const typeClass = maintenance.type === 'Correctivo' ? 'mnt-type-danger' : maintenance.type === 'Predictivo' ? 'mnt-type-purple' : 'mnt-type-info'
        - const searchData = ((maintenance.client ? maintenance.client.businessName : '') + ' ' + (maintenance.equipment || '') + ' ' + (maintenance.technician || '')).toLowerCase()

        .card.mnt-mobile-card.border-0.shadow-sm.rounded-4.mb-2.mnt-row(
          data-search=searchData
          data-status=maintenance.status
          data-type=maintenance.type
        )
          .card-body.p-3

            .d-flex.justify-content-between.align-items-start.gap-2.mb-2
              .d-flex.align-items-center.gap-2.min-w-0
                .mnt-avatar
                  i.fas.fa-user
                div.min-w-0
                  .fw-bold.text-dark.text-truncate
                    = maintenance.client ? maintenance.client.businessName : '-'
                  small.text-muted.text-truncate.d-block= maintenance.equipment

              span.mnt-badge.flex-shrink-0(class=statusClass)
                i.fas(class=statusIcon)
                span= maintenance.status

            .d-flex.align-items-center.gap-2.mb-3
              span.mnt-type-badge(class=typeClass)
                i.fas.fa-tag.me-1
                = maintenance.type

            .mnt-mobile-info.mb-3
              .d-flex.align-items-center.gap-2.mb-1
                i.fas.fa-calendar.text-primary.fa-sm
                small.text-muted
                  = new Date(maintenance.scheduledDate).toLocaleDateString('es-ES', { day: '2-digit', month: 'short', year: 'numeric' })
              .d-flex.align-items-center.gap-2
                i.fas.fa-user-cog.text-primary.fa-sm
                small.text-muted.text-truncate= maintenance.technician

            .d-flex.gap-2
              a.btn.btn-sm.btn-outline-info.flex-fill.rounded-pill(
                href=`/maintenances/${maintenance._id}`
              )
                i.fas.fa-eye.me-1
                | Ver
              a.btn.btn-sm.btn-outline-warning.flex-fill.rounded-pill(
                href=`/maintenances/${maintenance._id}/edit`
              )
                i.fas.fa-edit.me-1
                | Editar
              form.d-inline.flex-fill(
                method="POST"
                action=`/maintenances/${maintenance._id}?_method=DELETE`
                onsubmit="return confirm('¿Eliminar este mantenimiento?')"
              )
                button.btn.btn-sm.btn-outline-danger.w-100.rounded-pill(type="submit")
                  i.fas.fa-trash.me-1
                  | Borrar
    else
      .card.border-0.shadow-sm.rounded-4
        .card-body.text-center.py-5
          .mnt-empty
            i.fas.fa-sync-alt.fa-3x.mb-3.opacity-25.d-block
            p.text-muted.mb-3 No hay mantenimientos registrados
            a.btn.btn-primary.rounded-pill(href="/maintenances/create")
              i.fas.fa-plus-circle.me-1
              | Registrar primer mantenimiento

  //- ============================================
  //- SIN RESULTADOS (filtros)
  //- ============================================
  .card.border-0.shadow-sm.rounded-3.d-none#noResultsCard
    .card-body.text-center.py-5
      i.fas.fa-search.fa-3x.mb-3.opacity-25.d-block.text-muted
      p.text-muted.mb-0 No se encontraron mantenimientos con esos filtros

  //- ============================================
  //- ESTILOS
  //- ============================================
  style.
    .mnt-page-header { padding-bottom: 0; }
    .mnt-new-btn { white-space: nowrap; }

    .mnt-count-badge {
      font-size: 0.85rem;
      font-weight: 700;
    }

    .mnt-avatar {
      width: 38px; height: 38px;
      border-radius: 10px;
      background: #fef3c7;
      color: #b45309;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 0.9rem;
      flex-shrink: 0;
    }

    .mnt-table thead th {
      font-size: 0.72rem;
      text-transform: uppercase;
      letter-spacing: 0.7px;
      font-weight: 700;
      color: #64748b;
      border-bottom: 2px solid #e2e8f0;
      padding: 0.9rem 0.75rem;
      white-space: nowrap;
    }
    .mnt-table tbody td {
      padding: 0.85rem 0.75rem;
      vertical-align: middle;
      border-bottom: 1px solid #f1f5f9;
    }
    .mnt-table tbody tr:hover {
      background: #f8fafc;
    }
    .mnt-table tbody tr:last-child td {
      border-bottom: none;
    }

    .mnt-action-btn {
      width: 34px;
      height: 34px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: 8px !important;
      font-size: 0.85rem;
      transition: all 0.2s;
    }
    .mnt-action-btn:hover {
      transform: translateY(-1px);
    }

    /* Badges estado */
    .mnt-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      padding: 0.35rem 0.75rem;
      border-radius: 999px;
      font-size: 0.75rem;
      font-weight: 700;
      white-space: nowrap;
    }
    .mnt-badge i { font-size: 0.7rem; }
    .mnt-badge-success { background: #dcfce7; color: #15803d; }
    .mnt-badge-danger  { background: #fee2e2; color: #b91c1c; }
    .mnt-badge-warning { background: #fef3c7; color: #b45309; }
    .mnt-badge-info    { background: #dbeafe; color: #1d4ed8; }

    /* Badges tipo */
    .mnt-type-badge {
      display: inline-flex;
      align-items: center;
      padding: 0.25rem 0.65rem;
      border-radius: 6px;
      font-size: 0.72rem;
      font-weight: 700;
      white-space: nowrap;
      text-transform: uppercase;
      letter-spacing: 0.3px;
    }
    .mnt-type-info   { background: #e0f2fe; color: #0369a1; }
    .mnt-type-danger { background: #fee2e2; color: #b91c1c; }
    .mnt-type-purple { background: #f3e8ff; color: #7c3aed; }

    .mnt-empty i { color: #cbd5e1; }

    .mnt-mobile-card {
      transition: all 0.2s ease;
      border: 1px solid #eef2f7 !important;
    }
    .mnt-mobile-card:active {
      transform: scale(0.99);
      box-shadow: 0 2px 8px rgba(0,0,0,0.06) !important;
    }
    .mnt-mobile-info {
      background: #f8fafc;
      border-radius: 10px;
      padding: 0.6rem 0.75rem;
    }

    @media (max-width: 575.98px) {
      .mnt-page-header h1 { font-size: 1.15rem; }
      .mnt-new-btn { padding: 0.5rem 0.9rem; font-size: 0.85rem; }
      .mnt-mobile-card .card-body { padding: 0.85rem !important; }
      .mnt-badge { font-size: 0.7rem; padding: 0.3rem 0.6rem; }
      .mnt-type-badge { font-size: 0.68rem; }
    }

    @media (min-width: 768px) and (max-width: 991.98px) {
      .mnt-table thead th,
      .mnt-table tbody td { padding: 0.7rem 0.5rem; }
      .mnt-table { font-size: 0.85rem; }
    }

  //- ============================================
  //- SCRIPT
  //- ============================================
  script.
    document.addEventListener('DOMContentLoaded', function() {
      var searchInput = document.getElementById('searchInput');
      var statusFilter = document.getElementById('statusFilter');
      var typeFilter = document.getElementById('typeFilter');
      var resultCount = document.getElementById('resultCount');
      var tableCard = document.getElementById('tableCard');
      var cardsView = document.getElementById('cardsView');
      var noResultsCard = document.getElementById('noResultsCard');

      function applyFilters() {
        var term = searchInput ? searchInput.value.toLowerCase().trim() : '';
        var status = statusFilter ? statusFilter.value : '';
        var type = typeFilter ? typeFilter.value : '';
        var rows = document.querySelectorAll('.mnt-row');
        var visible = 0;

        rows.forEach(function(row) {
          var searchData = row.getAttribute('data-search') || '';
          var rowStatus = row.getAttribute('data-status') || '';
          var rowType = row.getAttribute('data-type') || '';

          var matchSearch = !term || searchData.indexOf(term) !== -1;
          var matchStatus = !status || rowStatus === status;
          var matchType = !type || rowType === type;

          if (matchSearch && matchStatus && matchType) {
            row.style.display = '';
            visible++;
          } else {
            row.style.display = 'none';
          }
        });

        if (resultCount) resultCount.textContent = visible;

        if (visible === 0) {
          if (tableCard) tableCard.classList.add('d-none');
          if (cardsView) cardsView.classList.add('d-none');
          if (noResultsCard) noResultsCard.classList.remove('d-none');
        } else {
          if (noResultsCard) noResultsCard.classList.add('d-none');
          if (tableCard) tableCard.classList.remove('d-none');
          if (cardsView) cardsView.classList.remove('d-none');
        }
      }

      if (searchInput) searchInput.addEventListener('input', applyFilters);
      if (statusFilter) statusFilter.addEventListener('change', applyFilters);
      if (typeFilter) typeFilter.addEventListener('change', applyFilters);

      document.addEventListener('keydown', function(e) {
        if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
          e.preventDefault();
          if (searchInput) searchInput.focus();
        }
      });
    });