extends ../layouts/layout

block content

  //- ============================================
  //- BREADCRUMB
  //- ============================================
  nav(aria-label="breadcrumb").mb-3
    ol.breadcrumb.mb-1
      li.breadcrumb-item
        a.text-decoration-none(href="/") Dashboard
      li.breadcrumb-item
        a.text-decoration-none(href="/orders") Pedidos
      li.breadcrumb-item.active= order.orderNumber

  //- ============================================
  //- HEADER CON ACCIONES
  //- ============================================
  .d-flex.flex-wrap.justify-content-between.align-items-center.gap-3.mb-4
    div
      h1.h3.fw-bold.mb-1
        i.fas.fa-receipt.me-2.text-primary
        = order.orderNumber
      p.text-muted.mb-0
        i.fas.fa-calendar.me-1
        = new Date(order.createdAt).toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric', hour: '2-digit', minute: '2-digit' })

    .d-flex.gap-2.flex-wrap
      a.btn.btn-outline-secondary.rounded-pill.px-3(href="/orders")
        i.fas.fa-arrow-left.me-1
        | Volver

      button.btn.btn-outline-primary.rounded-pill.px-3(
        type="button"
        onclick="window.print()"
      )
        i.fas.fa-print.me-1
        | Imprimir

      form.d-inline(
        method="POST"
        action=`/orders/${order._id}?_method=DELETE`
        onsubmit="return confirm('¿Eliminar este pedido permanentemente?')"
      )
        button.btn.btn-outline-danger.rounded-pill.px-3(type="submit")
          i.fas.fa-trash.me-1
          | Eliminar

  //- ============================================
  //- CONTENIDO
  //- ============================================
  .row.g-4

    //- ========== COLUMNA IZQUIERDA: DATOS ==========
    .col-lg-7

      //- ============================================
      //- ESTADO DEL PEDIDO
      //- ============================================
      .card.border-0.shadow-sm.rounded-3.mb-3
        .card-header.bg-transparent.border-0.py-3.d-flex.justify-content-between.align-items-center
          h6.mb-0.fw-bold
            i.fas.fa-info-circle.me-2.text-primary
            | Estado del pedido
          if order.paid
            span.badge.bg-success.rounded-pill.px-3.py-2
              i.fas.fa-check-double.me-1
              | PAGADO
          else if order.status === 'entregado'
            span.badge.bg-warning.rounded-pill.px-3.py-2
              i.fas.fa-clock.me-1
              | Pendiente de pago

        .card-body.pt-0

          //- Si ya está pagado: mostrar info, no permitir cambios
          if order.paid
            .alert.alert-success.rounded-3.mb-0
              .d-flex.align-items-center.gap-3
                i.fas.fa-check-double.fa-2x
                div
                  strong PEDIDO PAGADO Y CERRADO
                  br
                  small
                    | Marcado como pagado el 
                    = new Date(order.paidAt).toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric', hour: '2-digit', minute: '2-digit' })
                  br
                  small.text-muted No se puede modificar el estado de un pedido pagado.

          //- Si no está pagado: mostrar formulario
          else
            form(method="POST" action=`/orders/${order._id}/status?_method=PUT`)
              .row.g-3.align-items-end
                .col-md-7
                  label.form-label.fw-semibold Estado actual
                  select.form-select(name="status")
                    option(value="pendiente" selected=(order.status === 'pendiente')) 🕐 Pendiente
                    option(value="confirmado" selected=(order.status === 'confirmado')) ✅ Confirmado
                    option(value="enviado" selected=(order.status === 'enviado')) 🚚 Enviado
                    option(value="entregado" selected=(order.status === 'entregado')) 📦 Entregado
                    option(value="cancelado" selected=(order.status === 'cancelado')) ❌ Cancelado

                .col-md-5
                  button.btn.btn-primary.w-100(type="submit")
                    i.fas.fa-save.me-1
                    | Actualizar estado

              //- Checkbox "Marcar como pagado" — solo si estado es entregado
              #markAsPaidBlock.mt-3(
                style=(order.status === 'entregado' ? 'display: block;' : 'display: none;')
              )
                .card.bg-success-subtle.border-0.rounded-3
                  .card-body.p-3
                    .form-check.mb-0
                      input#markAsPaid.form-check-input(
                        type="checkbox"
                        name="markAsPaid"
                        value="on"
                      )
                      label.form-check-label.fw-bold.text-success(for="markAsPaid")
                        i.fas.fa-money-bill-wave.me-1
                        | Marcar pedido como PAGADO
                      small.d-block.text-muted.ms-4
                        | Una vez marcado, no se podrá cambiar el estado ni desmarcarlo.

            //- Script para mostrar/ocultar el checkbox
            script.
              document.addEventListener('DOMContentLoaded', function() {
                const statusSelect = document.querySelector('select[name="status"]');
                const markAsPaidBlock = document.getElementById('markAsPaidBlock');

                if (statusSelect && markAsPaidBlock) {
                  statusSelect.addEventListener('change', function() {
                    if (this.value === 'entregado') {
                      markAsPaidBlock.style.display = 'block';
                    } else {
                      markAsPaidBlock.style.display = 'none';
                      const checkbox = document.getElementById('markAsPaid');
                      if (checkbox) checkbox.checked = false;
                    }
                  });
                }
              });

      //- ============================================
      //- DATOS DEL CLIENTE
      //- ============================================
      .card.border-0.shadow-sm.rounded-3.mb-3
        .card-header.bg-transparent.border-0.py-3
          h6.mb-0.fw-bold
            i.fas.fa-user.me-2.text-primary
            | Datos del cliente
        .card-body.pt-0
          .row.g-3
            .col-md-6
              small.text-muted.d-block Nombre
              div.fw-semibold= order.customer.name
            .col-md-6
              small.text-muted.d-block Teléfono
              a.fw-semibold.text-decoration-none(href=`tel:${order.customer.phone}`)
                i.fas.fa-phone.me-1
                = order.customer.phone
            if order.customer.email
              .col-md-6
                small.text-muted.d-block Email
                a.fw-semibold.text-decoration-none(href=`mailto:${order.customer.email}`)
                  i.fas.fa-envelope.me-1
                  = order.customer.email
            .col-md-6
              small.text-muted.d-block Distrito
              div.fw-semibold= order.customer.district
            .col-12
              small.text-muted.d-block Dirección
              div.fw-semibold= order.customer.address
            if order.customer.reference
              .col-12
                small.text-muted.d-block Referencia
                div.text-muted= order.customer.reference

      //- ============================================
      //- MODO DE PAGO
      //- ============================================
      .card.border-0.shadow-sm.rounded-3.mb-3
        .card-header.bg-transparent.border-0.py-3
          h6.mb-0.fw-bold
            i.fas.fa-credit-card.me-2.text-primary
            | Modo de pago
        .card-body.pt-0
          .d-flex.align-items-center.gap-3
            case order.paymentMethod
              when 'yape'
                .rounded-circle.bg-purple-subtle.text-purple.d-flex.align-items-center.justify-content-center(
                  style="width: 48px; height: 48px;"
                )
                  i.fas.fa-mobile-alt.fa-lg
                div
                  div.fw-bold Yape
                  small.text-muted Pago móvil instantáneo
              when 'plin'
                .rounded-circle.bg-teal-subtle.text-teal.d-flex.align-items-center.justify-content-center(
                  style="width: 48px; height: 48px;"
                )
                  i.fas.fa-mobile-alt.fa-lg
                div
                  div.fw-bold Plin
                  small.text-muted Pago móvil instantáneo
              when 'transferencia'
                .rounded-circle.bg-primary-subtle.text-primary.d-flex.align-items-center.justify-content-center(
                  style="width: 48px; height: 48px;"
                )
                  i.fas.fa-university.fa-lg
                div
                  div.fw-bold Transferencia bancaria
                  small.text-muted BCP, Interbank, BBVA
              when 'efectivo'
                .rounded-circle.bg-success-subtle.text-success.d-flex.align-items-center.justify-content-center(
                  style="width: 48px; height: 48px;"
                )
                  i.fas.fa-money-bill-wave.fa-lg
                div
                  div.fw-bold Efectivo
                  small.text-muted Pago contra entrega

          if order.paymentReference
            hr.my-3
            small.text-muted.d-block Número de operación
            div.fw-semibold= order.paymentReference

      //- ============================================
      //- NOTAS DEL CLIENTE
      //- ============================================
      if order.notes
        .card.border-0.shadow-sm.rounded-3.mb-3
          .card-header.bg-transparent.border-0.py-3
            h6.mb-0.fw-bold
              i.fas.fa-comment-alt.me-2.text-primary
              | Notas del cliente
          .card-body.pt-0
            p.mb-0(style="white-space: pre-line;")= order.notes

      //- ============================================
      //- HISTORIAL DE CAMBIOS (si existe)
      //- ============================================
      if order.statusHistory && order.statusHistory.length
        .card.border-0.shadow-sm.rounded-3.mb-3
          .card-header.bg-transparent.border-0.py-3
            h6.mb-0.fw-bold
              i.fas.fa-history.me-2.text-primary
              | Historial de cambios
          .card-body.pt-0
            .timeline
              each entry in order.statusHistory.reverse()
                .timeline-item
                  .timeline-dot
                  .timeline-content
                    .d-flex.justify-content-between.align-items-center.mb-1
                      span.fw-semibold.text-capitalize= entry.status
                      small.text-muted
                        = new Date(entry.changedAt).toLocaleDateString('es-ES', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' })
                    if entry.note
                      small.text-muted= entry.note

    //- ========== COLUMNA DERECHA: PRODUCTOS ==========
    .col-lg-5

      .card.border-0.shadow-sm.rounded-3.sticky-top(style="top: 100px;")
        .card-header.bg-transparent.border-0.py-3
          h6.mb-0.fw-bold
            i.fas.fa-box.me-2.text-primary
            | Productos del pedido

        .card-body.pt-0
          each item in order.items
            .d-flex.gap-3.py-3(style="border-bottom: 1px solid #f1f5f9;")
              if item.image
                img(
                  src=item.image
                  alt=item.name
                  style="width: 60px; height: 60px; object-fit: contain; background: #f8fafc; border-radius: 8px; padding: 4px;"
                )
              else
                .d-flex.align-items-center.justify-content-center.bg-light.rounded(
                  style="width: 60px; height: 60px;"
                )
                  i.fas.fa-image.text-muted
              div.flex-grow-1.min-w-0
                div.fw-semibold.small= item.name
                small.text-muted S/. #{item.price.toFixed(2)} × #{item.qty}
              div.fw-bold.text-primary.align-self-center S/. #{item.subtotal.toFixed(2)}

        .card-footer.bg-transparent.border-top.pt-3
          .d-flex.justify-content-between.mb-2
            span.text-muted Subtotal
            strong S/. #{order.subtotal.toFixed(2)}
          .d-flex.justify-content-between.mb-3
            span.text-muted Envío
            strong.text-success Gratis
          .d-flex.justify-content-between.fs-5.pt-3(style="border-top: 2px solid #e5e7eb;")
            span.fw-bold Total
            strong.text-primary S/. #{order.total.toFixed(2)}

  //- ============================================
  //- ESTILOS
  //- ============================================
  style.
    /* Badges con variantes -subtle */
    .badge.bg-primary-subtle   { background: rgba(13,110,253,0.12)  !important; }
    .badge.bg-success-subtle   { background: rgba(25,135,84,0.12)   !important; }
    .badge.bg-warning-subtle   { background: rgba(217,119,6,0.12)   !important; }
    .badge.bg-info-subtle      { background: rgba(8,145,178,0.12)   !important; }
    .badge.bg-danger-subtle    { background: rgba(220,53,69,0.12)   !important; }
    .badge.bg-purple-subtle    { background: rgba(147,51,234,0.12)  !important; }
    .badge.bg-teal-subtle      { background: rgba(13,148,136,0.12)  !important; }

    .text-purple { color: #9333ea !important; }
    .text-teal   { color: #0d9488 !important; }

    /* Timeline de historial */
    .timeline {
      position: relative;
      padding-left: 20px;
    }
    .timeline::before {
      content: '';
      position: absolute;
      left: 5px;
      top: 8px;
      bottom: 8px;
      width: 2px;
      background: #e5e7eb;
    }
    .timeline-item {
      position: relative;
      padding-bottom: 16px;
    }
    .timeline-item:last-child {
      padding-bottom: 0;
    }
    .timeline-dot {
      position: absolute;
      left: -20px;
      top: 6px;
      width: 12px;
      height: 12px;
      border-radius: 50%;
      background: var(--brand);
      border: 2px solid white;
      box-shadow: 0 0 0 2px var(--brand);
    }
    .timeline-content {
      padding-left: 8px;
    }

    @media print {
      .navbar, footer, .btn, nav[aria-label="breadcrumb"], .sticky-top {
        display: none !important;
      }
    }