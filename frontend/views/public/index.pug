            //- Precio con fallback: finalPrice, o customerPrice * (1 - discount/100)
            - const hasDiscount = product.discount && product.discount > 0
            - const basePrice = Number(product.customerPrice) || 0
            - const computedFinal = hasDiscount ? (basePrice * (1 - product.discount / 100)) : basePrice
            - const finalPrice = (product.finalPrice != null && !isNaN(product.finalPrice)) ? Number(product.finalPrice) : computedFinal
            - const displayFinal = finalPrice.toFixed(2)
            - const displayOld = basePrice.toFixed(2)
            - const showOld = hasDiscount && basePrice > finalPrice
