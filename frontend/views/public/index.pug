//- ============================================
//- JS ESPECÍFICO DEL HOME (el carrito, drawer y buscador ya están en el layout)
//- ============================================
block scripts
  script.
    /* CARRUSEL DE CATEGORÍAS */
    (function initCategoryCarousel() {
      const carousel = document.getElementById('categoryCarousel');
      const btnPrev = document.getElementById('catPrev');
      const btnNext = document.getElementById('catNext');

      if (!carousel) return;

      const getScrollAmount = function () {
        const card = carousel.querySelector('.category-slide-card');
        if (!card) return 300;
        return card.offsetWidth + 16; // ancho + gap
      };

      function updateNavButtons() {
        if (!btnPrev || !btnNext) return;
        btnPrev.disabled = carousel.scrollLeft <= 5;
        btnNext.disabled = carousel.scrollLeft + carousel.clientWidth >= carousel.scrollWidth - 5;
      }

      if (btnPrev) {
        btnPrev.addEventListener('click', function () {
          carousel.scrollBy({ left: -getScrollAmount() * 2, behavior: 'smooth' });
        });
      }
      if (btnNext) {
        btnNext.addEventListener('click', function () {
          carousel.scrollBy({ left: getScrollAmount() * 2, behavior: 'smooth' });
        });
      }

      carousel.addEventListener('scroll', updateNavButtons, { passive: true });
      window.addEventListener('resize', updateNavButtons);
      updateNavButtons();

      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      let autoScrollTimer = null;
      let isUserInteracting = false;

      function startAutoScroll() {
        if (autoScrollTimer || reduceMotion) return;
        autoScrollTimer = setInterval(function () {
          if (isUserInteracting) return;
          const atEnd = carousel.scrollLeft + carousel.clientWidth >= carousel.scrollWidth - 5;
          if (atEnd) {
            carousel.scrollTo({ left: 0, behavior: 'smooth' });
          } else {
            carousel.scrollBy({ left: getScrollAmount(), behavior: 'smooth' });
          }
        }, 5000);
      }

      function stopAutoScroll() {
        if (autoScrollTimer) {
          clearInterval(autoScrollTimer);
          autoScrollTimer = null;
        }
      }

      ['mouseenter', 'touchstart', 'focusin'].forEach(function (evt) {
        carousel.addEventListener(evt, function () {
          isUserInteracting = true;
          stopAutoScroll();
        }, { passive: true });
      });

      ['mouseleave', 'touchend', 'focusout'].forEach(function (evt) {
        carousel.addEventListener(evt, function () {
          isUserInteracting = false;
          startAutoScroll();
        }, { passive: true });
      });

      if (carousel.querySelectorAll('.category-slide-card').length > 4) {
        startAutoScroll();
      }
    })();
