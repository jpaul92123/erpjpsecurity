extends ../layouts/layout

block content
  .d-flex.justify-content-between.flex-wrap.flex-md-nowrap.align-items-center.pb-2.mb-3.border-bottom
    h1.h2
      i.fas.fa-plus-circle.me-2
      | Nueva Cotización
    a.btn.btn-outline-secondary(href="/quotations")
      i.fas.fa-arrow-left.me-1
      | Volver

  .card.border-0.shadow-sm
    .card-body
      form(method="POST" action="/quotations" id="quotationForm")
        //- DATOS DEL CLIENTE
        .row
          .col-md-6
            .mb-3
              label.form-label Cliente
              .d-flex
                select.form-control(name="client" id="clientSelect")
                  option(value="") Cliente Anónimo
                  each client in clients
                    option(value=client._id) #{client.businessName} - #{client.ruc}
                button.btn.btn-success.ms-2(type="button" id="btnNuevoCliente")
                  i.fas.fa-user-plus
          .col-md-6
            .mb-3
              label.form-label Válido hasta
              input.form-control(type="date" name="validUntil" id="validUntil", required)

        //- BUSCADOR DE PRODUCTOS
        .mb-3
          label.form-label Buscar productos
          .input-group
            input.form-control(type="text" id="buscadorProductos" placeholder="Buscar por nombre o modelo...")
            button.btn.btn-primary(type="button" id="btnBuscar")
              i.fas.fa-search
          #resultadosBusqueda.mt-2(style="max-height: 300px; overflow-y: auto; display: none;")
            table.table.table-sm.table-hover
              thead
                tr
                  th Imagen
                  th Nombre
                  th Modelo
                  th Precio
                  th Acción
              tbody#tablaResultados

        //- TABLA DE ITEMS AGREGADOS
        h5.mt-4 Productos Agregados
        .table-responsive
          table.table.table-bordered.table-hover
            thead
              tr
                th Imagen
                th Descripción
                th Cantidad
                th P. Unitario
                th Total
                th Acciones
            tbody#tablaItems
              tr#emptyRow
                td(colspan="6").text-center No hay productos agregados.

        .row.mt-3
          .col-md-12.text-end
            button.btn.btn-sm.btn-success(type="button" id="btnAgregarManual")
              i.fas.fa-plus-circle
              | Agregar Manual

        //- CAMPOS ADICIONALES
        hr
        .row
          .col-md-6
            .mb-3
              label.form-label RUC / DNI
              input.form-control(type="text" name="rucDni" placeholder="Número de documento")
          .col-md-6
            .mb-3
              label.form-label Celular
              input.form-control(type="text" name="celular" placeholder="Número de celular")
        .row
          .col-md-6
            .mb-3
              label.form-label Modalidad de Pago
              select.form-control(name="modalidadPago")
                option(value="Contado") Contado
                option(value="Crédito") Crédito
                option(value="Transferencia") Transferencia
                option(value="Depósito") Depósito
                option(value="Otro") Otro
          .col-md-6
            .mb-3
              label.form-label Garantía (meses)
              input.form-control(type="number" name="garantiaMeses" min="0" value="0")

        .mb-3
          label.form-label Notas
          textarea.form-control(name="notas" rows="2")

        //- IGV Y DESCUENTO
        .row
          .col-md-6
            .form-check
              input.form-check-input(type="checkbox" id="incluyeIgv", checked , name="includeIgv")
              label.form-check-label(for="incluyeIgv") Los precios incluyen IGV
          .col-md-6
            .mb-3
              label.form-label Descuento (S/.)
              input.form-control(type="number" name="discount" id="descuentoMonto" min="0" step="0.01" value="0")

        //- TOTALES
        #totalProforma.mt-3

        //- BOTONES
        button.btn.btn-primary(type="submit")
          i.fas.fa-save.me-1
          | Guardar
        a.btn.btn-outline-secondary.ms-2(href="/quotations") Cancelar

  //- MODALES (igual que antes)
  .modal.fade#modalNuevoCliente(tabindex="-1")
    .modal-dialog
      .modal-content
        .modal-header
          h5.modal-title
            i.fas.fa-user-plus.me-2
            | Nuevo Cliente
          button.btn-close(type="button" data-bs-dismiss="modal")
        .modal-body
          .mb-3
            label.form-label Nombre / Razón Social *
            input.form-control#clienteNombre(type="text", required)
          .mb-3
            label.form-label RUC
            input.form-control#clienteRuc(type="text")
          .mb-3
            label.form-label Email
            input.form-control#clienteEmail(type="email")
          .mb-3
            label.form-label Teléfono
            input.form-control#clientePhone(type="text")
        .modal-footer
          button.btn.btn-secondary(type="button" data-bs-dismiss="modal") Cancelar
          button.btn.btn-primary#btnGuardarCliente(type="button")
            i.fas.fa-save.me-1
            | Guardar

  .modal.fade#modalAgregarManual(tabindex="-1")
    .modal-dialog
      .modal-content
        .modal-header
          h5.modal-title
            i.fas.fa-hand-holding.me-2
            | Agregar Producto Manual
          button.btn-close(type="button" data-bs-dismiss="modal")
        .modal-body
          .mb-3
            label.form-label Descripción *
            input.form-control#manualDescripcion(type="text", required)
          .mb-3
            label.form-label Precio Unitario (S/.) *
            input.form-control#manualPrecio(type="number" step="0.01" min="0", required)
          .mb-3
            label.form-label Cantidad *
            input.form-control#manualCantidad(type="number" min="1" value="1", required)
        .modal-footer
          button.btn.btn-secondary(type="button" data-bs-dismiss="modal") Cancelar
          button.btn.btn-success#btnAgregarManualModal(type="button")
            i.fas.fa-plus-circle.me-1
            | Agregar

  //- SCRIPTS (con el arreglo)
  script.
    // ========== FECHA AUTOMÁTICA ==========
    document.addEventListener('DOMContentLoaded', function() {
      const today = new Date();
      const validUntil = new Date(today);
      validUntil.setDate(today.getDate() + 15);
      document.getElementById('validUntil').value = validUntil.toISOString().split('T')[0];
    });

    // ========== VARIABLES GLOBALES ==========
    let items = [];

    // ========== NUEVO CLIENTE ==========
    document.getElementById('btnNuevoCliente').addEventListener('click', function() {
      const modal = new bootstrap.Modal(document.getElementById('modalNuevoCliente'));
      modal.show();
    });

    document.getElementById('btnGuardarCliente').addEventListener('click', function() {
      const businessName = document.getElementById('clienteNombre').value.trim();
      const ruc = document.getElementById('clienteRuc').value.trim();
      const email = document.getElementById('clienteEmail').value.trim();
      const phone = document.getElementById('clientePhone').value.trim();

      if (!businessName) {
        alert('El nombre del cliente es obligatorio.');
        return;
      }

      fetch('/quotations/api/client', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ businessName, ruc, email, phone })
      })
      .then(res => res.json())
      .then(data => {
        if (data.success) {
          const select = document.getElementById('clientSelect');
          const option = document.createElement('option');
          option.value = data.client._id;
          option.text = data.client.businessName + ' - ' + data.client.ruc;
          select.appendChild(option);
          select.value = data.client._id;
          bootstrap.Modal.getInstance(document.getElementById('modalNuevoCliente')).hide();
          document.getElementById('clienteNombre').value = '';
          document.getElementById('clienteRuc').value = '';
          document.getElementById('clienteEmail').value = '';
          document.getElementById('clientePhone').value = '';
        } else {
          alert('Error al crear cliente: ' + data.error);
        }
      })
      .catch(err => alert('Error de conexión: ' + err.message));
    });

    // ========== AGREGAR MANUAL ==========
    document.getElementById('btnAgregarManual').addEventListener('click', function() {
      const modal = new bootstrap.Modal(document.getElementById('modalAgregarManual'));
      modal.show();
    });

    document.getElementById('btnAgregarManualModal').addEventListener('click', function() {
      const desc = document.getElementById('manualDescripcion').value.trim();
      const price = parseFloat(document.getElementById('manualPrecio').value);
      const qty = parseInt(document.getElementById('manualCantidad').value) || 1;

      if (!desc || isNaN(price) || price < 0) {
        alert('Completa todos los campos correctamente.');
        return;
      }

      const item = {
        product: null,
        description: desc,
        quantity: qty,
        unitPrice: price,
        total: qty * price,
        image: '/img/product-default.png'
      };
      items.push(item);
      renderItems();
      actualizarTotales();

      document.getElementById('manualDescripcion').value = '';
      document.getElementById('manualPrecio').value = '';
      document.getElementById('manualCantidad').value = '1';
      bootstrap.Modal.getInstance(document.getElementById('modalAgregarManual')).hide();
    });

    // ========== BUSCADOR AUTOMÁTICO ==========
    const buscadorInput = document.getElementById('buscadorProductos');
    let timeoutId;

    function buscarProductos() {
      const term = buscadorInput.value.trim();
      if (term.length < 2) {
        document.getElementById('resultadosBusqueda').style.display = 'none';
        return;
      }

      console.log('🔍 Buscando:', term);
      const url = '/quotations/api/products/search?q=' + encodeURIComponent(term);
      fetch(url)
        .then(response => {
          if (!response.ok) throw new Error('HTTP ' + response.status);
          return response.json();
        })
        .then(data => {
          const tbody = document.getElementById('tablaResultados');
          tbody.innerHTML = '';
          if (!data || data.length === 0) {
            tbody.innerHTML = '<tr><td colspan="5" class="text-muted">No se encontraron productos.</td></tr>';
          } else {
            data.forEach(p => {
              const price = p.customerPrice || 0;
              const image = p.image || '/img/product-default.png';
              const tr = document.createElement('tr');
              // ✅ CORRECCIÓN: type="button" para evitar envío del formulario
              tr.innerHTML = `
                <td><img src="${image}" width="40" height="40" style="object-fit:contain;"></td>
                <td>${p.name}</td>
                <td>${p.model || '-'}</td>
                <td>S/. ${price.toFixed(2)}</td>
                <td>
                  <button type="button" class="btn btn-sm btn-success" onclick="agregarItem('${p._id}', '${p.name.replace(/'/g, "\\'")}', ${price}, '${image}')">
                    <i class="fas fa-plus"></i>
                  </button>
                </td>
              `;
              tbody.appendChild(tr);
            });
          }
          document.getElementById('resultadosBusqueda').style.display = 'block';
        })
        .catch(error => {
          console.error('Error:', error);
          alert('Error al buscar productos: ' + error.message);
        });
    }

    // Eventos del buscador
    buscadorInput.addEventListener('input', function() {
      clearTimeout(timeoutId);
      timeoutId = setTimeout(buscarProductos, 300);
    });
    document.getElementById('btnBuscar').addEventListener('click', buscarProductos);
    buscadorInput.addEventListener('keypress', function(e) {
      if (e.key === 'Enter') { e.preventDefault(); buscarProductos(); }
    });

    // ========== AGREGAR ITEM ==========
    function agregarItem(productId, description, price, image) {
      const existente = items.find(item => item.description === description && item.product === productId);
      if (existente) {
        existente.quantity += 1;
        existente.total = existente.quantity * existente.unitPrice;
      } else {
        items.push({
          product: productId,
          description: description,
          quantity: 1,
          unitPrice: price,
          total: price,
          image: image || '/img/product-default.png'
        });
      }
      renderItems();
      actualizarTotales();
      document.getElementById('resultadosBusqueda').style.display = 'none';
      buscadorInput.value = '';
    }

    // ========== RENDERIZAR TABLA ==========
    function renderItems() {
      const tbody = document.getElementById('tablaItems');
      tbody.innerHTML = '';
      if (items.length === 0) {
        tbody.innerHTML = `<tr id="emptyRow"><td colspan="6" class="text-center">No hay productos agregados.</td></tr>`;
        return;
      }
      items.forEach((item, index) => {
        const tr = document.createElement('tr');
        tr.innerHTML = `
          <td><img src="${item.image || '/img/product-default.png'}" width="40" height="40" style="object-fit:contain;"></td>
          <td>${item.description}</td>
          <td><input type="number" class="form-control form-control-sm cantidad-input" data-index="${index}" value="${item.quantity}" min="1" style="width:80px;"></td>
          <td><input type="number" class="form-control form-control-sm precio-input" data-index="${index}" value="${item.unitPrice.toFixed(2)}" step="0.01" min="0" style="width:100px;"></td>
          <td>S/. ${item.total.toFixed(2)}</td>
          <td><button class="btn btn-sm btn-danger" onclick="eliminarItem(${index})"><i class="fas fa-trash"></i></button></td>
        `;
        tbody.appendChild(tr);
      });
      document.querySelectorAll('.cantidad-input').forEach(input => {
        input.addEventListener('change', function() {
          const idx = parseInt(this.dataset.index);
          const qty = parseFloat(this.value) || 1;
          items[idx].quantity = qty;
          items[idx].total = qty * items[idx].unitPrice;
          renderItems();
          actualizarTotales();
        });
      });
      document.querySelectorAll('.precio-input').forEach(input => {
        input.addEventListener('change', function() {
          const idx = parseInt(this.dataset.index);
          const price = parseFloat(this.value) || 0;
          items[idx].unitPrice = price;
          items[idx].total = items[idx].quantity * price;
          renderItems();
          actualizarTotales();
        });
      });
    }

    function eliminarItem(index) {
      items.splice(index, 1);
      renderItems();
      actualizarTotales();
    }

    // ========== TOTALES ==========
    function actualizarTotales() {
      const subtotal = items.reduce((acc, item) => acc + item.total, 0);
      const igv = document.getElementById('incluyeIgv').checked ? 0 : subtotal * 0.18;
      const descuento = parseFloat(document.getElementById('descuentoMonto').value) || 0;
      const total = subtotal + igv - descuento;

      document.getElementById('totalProforma').innerHTML = `
        <div class="alert alert-success total-proforma">
          <div class="d-flex justify-content-between">
            <span>Subtotal:</span>
            <span>S/. ${subtotal.toFixed(2)}</span>
          </div>
          ${!document.getElementById('incluyeIgv').checked ? `
          <div class="d-flex justify-content-between">
            <span>IGV (18%):</span>
            <span>S/. ${igv.toFixed(2)}</span>
          </div>` : ''}
          ${descuento > 0 ? `
          <div class="d-flex justify-content-between text-danger">
            <span>Descuento:</span>
            <span>- S/. ${descuento.toFixed(2)}</span>
          </div>` : ''}
          <hr>
          <div class="d-flex justify-content-between fw-bold fs-5">
            <span>TOTAL:</span>
            <span>S/. ${total.toFixed(2)}</span>
          </div>
        </div>
      `;
    }

    // ========== EVENTOS ==========
    document.getElementById('incluyeIgv').addEventListener('change', actualizarTotales);
    document.getElementById('descuentoMonto').addEventListener('input', actualizarTotales);

    // ========== ENVÍO FORM ==========
    document.getElementById('quotationForm').addEventListener('submit', function(e) {
      // No se previene el envío, solo se agregan los items ocultos.
      const container = document.createElement('div');
      items.forEach((item, idx) => {
        const prefix = `items[${idx}]`;
        const fields = [
          { name: 'product', value: item.product || '' },
          { name: 'description', value: item.description },
          { name: 'quantity', value: item.quantity },
          { name: 'unitPrice', value: item.unitPrice },
          { name: 'image', value: item.image || '' }
        ];
        fields.forEach(f => {
          const input = document.createElement('input');
          input.type = 'hidden';
          input.name = `${prefix}[${f.name}]`;
          input.value = f.value;
          container.appendChild(input);
        });
      });
      this.appendChild(container);
    });

    // ========== INICIALIZAR TOTALES ==========
    actualizarTotales();