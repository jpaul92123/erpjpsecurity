extends ../layouts/layout

block content

  //- ============================================
  //- HEADER
  //- ============================================
  .d-flex.flex-wrap.flex-md-nowrap.align-items-center.justify-content-between.pb-3.mb-4.border-bottom
    .d-flex.align-items-center
      .bg-success.bg-opacity-10.rounded-3.p-3.me-3
        i.fas.fa-receipt.text-success.fa-2x
      div
        h1.h2.mb-0.fw-bold Ventas
        p.text-muted.mb-0
          i.fas.fa-info-circle.me-1
          | Gestión de ventas registradas
    div.d-flex.gap-2
      a.btn.btn-success.rounded-pill.px-4.shadow-sm(href="/sales/create")
        i.fas.fa-plus-circle.me-1
        | Nueva Venta

  //- ============================================
  //- TARJETAS DE ESTADÍSTICAS
  //- ============================================
  .row.g-3.mb-4
    .col-sm-6.col-lg-3
      .card.border-0.shadow-sm.rounded-3.stat-card.h-100
        .card-body.d-flex.justify-content-between.align-items-center
          div
            h6.card-title.mb-1.small.text-uppercase.text-muted.fw-semibold Total Ventas
            h2.card-text.mb-0.fw-bold.text-dark #{sales.length}
            small.text-success
              i.fas.fa-arrow-up.me-1
              | Registradas
          .stat-icon.bg-success.bg-opacity-10.text-success.rounded-3
            i.fas.fa-shopping-cart.fa-lg

    .col-sm-6.col-lg-3
      .card.border-0.shadow-sm.rounded-3.stat-card.h-100
        .card-body.d-flex.justify-content-between.align-items-center
          div
            h6.card-title.mb-1.small.text-uppercase.text-muted.fw-semibold Monto Total
            h2.card-text.mb-0.fw-bold.text-primary S/. #{sales.reduce((acc, s) => acc + (s.total || 0), 0).toFixed(2)}
            small.text-muted
              i.fas.fa-coins.me-1
              | En soles
          .stat-icon.bg-primary.bg-opacity-10.text-primary.rounded-3
            i.fas.fa-money-bill-wave.fa-lg

    .col-sm-6.col-lg-3
      .card.border-0.shadow-sm.rounded-3.stat-card.h-100
        .card-body.d-flex.justify-content-between.align-items-center
          div
            h6.card-title.mb-1.small.text-uppercase.text-muted.fw-semibold Pagadas
            h2.card-text.mb-0.fw-bold.text-success #{sales.filter(s => s.status === 'Pagado').length}
            small.text-success
              i.fas.fa-check-circle.me-1
              | Confirmadas
          .stat-icon.bg-success.bg-opacity-10.text-success.rounded-3
            i.fas.fa-check-double.fa-lg

    .col-sm-6.col-lg-3
      .card.border-0.shadow-sm.rounded-3.stat-card.h-100
        .card-body.d-flex.justify-content-between.align-items-center
          div
            h6.card-title.mb-1.small.text-uppercase.text-muted.fw-semibold Anuladas
            h2.card-text.mb-0.fw-bold.text-danger #{sales.filter(s => s.status === 'Anulado').length}
            small.text-danger
              i.fas.fa-times-circle.me-1
              | Canceladas
          .stat-icon.bg-danger.bg-opacity-10.text-danger.rounded-3
            i.fas.fa-ban.fa-lg

  //- ============================================
  //- FILTROS
  //- ============================================
  .card.border-0.shadow-sm.rounded-3.mb-3
    .card-body.p-3
      .row.g-3.align-items-center
        .col-md-5
          .input-group
            span.input-group-text.bg-white.border-end-0
              i.fas.fa-search.text-muted
            input.form-control.border-start-0(
              type="text"
              id="searchSale"
              placeholder="Buscar por número, cliente o RUC..."
            )
        .col-md-4
          select.form-select#filterStatus
            option(value="") Todos los estados
            option(value="Pagado") ✅ Pagadas
            option(value="Anulado") ❌ Anuladas
        .col-md-3.text-md-end
          span.text-muted.small
            i.fas.fa-filter.me-1
            span#resultsCount #{sales.length} resultados

  //- ============================================
  //- TABLA
  //- ============================================
  .card.border-0.shadow-sm.rounded-3.overflow-hidden
    .card-body.p-0
      .table-responsive
        table.table.table-hover.align-middle.mb-0#salesTable
          thead.bg-light
            tr
              th(style="min-width: 130px;") N° Venta
              th(style="min-width: 200px;") Cliente
              th(style="min-width: 130px;") Fecha
              th.text-end(style="min-width: 130px;") Total
              th.text-center(style="min-width: 130px;") Estado
              th.text-center(style="min-width: 130px;") Pago
              th.text-center(style="min-width: 100px;") Acciones
          tbody
            if sales.length
              each sale in sales
                tr(data-status=sale.status)
                  td
                    div.d-flex.align-items-center
                      .bg-primary.bg-opacity-10.text-primary.rounded-2.p-2.me-2
                        i.fas.fa-file-invoice
                      div
                        strong.text-primary.d-block #{sale.number || sale._id.toString().slice(-6).toUpperCase()}
                        small.text-muted #{sale.items ? sale.items.length : 0} item(s)
                  td
                    if sale.client
                      div.d-flex.align-items-center
                        .bg-secondary.bg-opacity-10.rounded-circle.p-2.me-2(
                          style="width: 36px; height: 36px; display: flex; align-items: center; justify-content: center;"
                        )
                          i.fas.fa-user.text-secondary
                        div
                          div.fw-semibold #{sale.client.businessName}
                          small.text-muted #{sale.client.ruc || 'Sin RUC'}
                    else
                      span.text-muted.fst-italic Cliente Anónimo
                  td
                    div.fw-semibold #{new Date(sale.createdAt).toLocaleDateString('es-PE', { day: '2-digit', month: 'short', year: 'numeric' })}
                    small.text-muted
                      i.fas.fa-clock.me-1
                      | #{new Date(sale.createdAt).toLocaleTimeString('es-PE', { hour: '2-digit', minute: '2-digit' })}
                  td.text-end
                    strong.text-success.fs-6 S/. #{sale.total.toFixed(2)}
                  td.text-center
                    if sale.status === 'Pagado'
                      span.badge.bg-success-subtle.text-success.px-3.py-2.rounded-pill.border.border-success-subtle
                        i.fas.fa-check-circle.me-1
                        | Pagado
                    else if sale.status === 'Anulado'
                      span.badge.bg-danger-subtle.text-danger.px-3.py-2.rounded-pill.border.border-danger-subtle
                        i.fas.fa-times-circle.me-1
                        | Anulado
                    else
                      span.badge.bg-secondary-subtle.text-secondary.px-3.py-2.rounded-pill.border.border-secondary-subtle
                        i.fas.fa-question-circle.me-1
                        | #{sale.status || 'N/A'}
                  td.text-center
                    span.badge.rounded-pill.px-3.py-2(
                      class={
                        'bg-success-subtle text-success': sale.paymentMethod === 'Efectivo',
                        'bg-primary-subtle text-primary': sale.paymentMethod === 'Transferencia',
                        'bg-info-subtle text-info': sale.paymentMethod === 'Tarjeta',
                        'bg-warning-subtle text-warning': sale.paymentMethod === 'Yape' || sale.paymentMethod === 'Plin',
                        'bg-secondary-subtle text-secondary': !sale.paymentMethod || sale.paymentMethod === 'Otro'
                      }
                    )
                      i.fas.me-1(class={
                        'fa-money-bill': sale.paymentMethod === 'Efectivo',
                        'fa-university': sale.paymentMethod === 'Transferencia',
                        'fa-credit-card': sale.paymentMethod === 'Tarjeta',
                        'fa-mobile-alt': sale.paymentMethod === 'Yape' || sale.paymentMethod === 'Plin',
                        'fa-wallet': !sale.paymentMethod || sale.paymentMethod === 'Otro'
                      })
                      | #{sale.paymentMethod || 'N/A'}
                  td
                    .d-flex.justify-content-center
                      a.btn.btn-sm.btn-outline-primary.rounded-circle.action-btn(
                        href=`/sales/${sale._id}`
                        title="Ver detalle"
                      )
                        i.fas.fa-eye
            else
              tr#emptyRow
                td(colspan="7").text-center.py-5
                  .mb-3
                    i.fas.fa-receipt.fa-4x.text-muted.opacity-25
                  h5.text-muted.fw-semibold No hay ventas registradas
                  p.text-muted.mb-4 Comienza registrando tu primera venta
                  a.btn.btn-success.rounded-pill.px-4(href="/sales/create")
                    i.fas.fa-plus-circle.me-1
                    | Crear Primera Venta

  //- ============================================
  //- ESTILOS
  //- ============================================
  style.
    .stat-card {
      transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .stat-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 12px 24px rgba(0,0,0,0.08) !important;
    }
    .stat-icon {
      width: 52px;
      height: 52px;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .table th {
      font-weight: 600;
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      background: #f8fafc;
      color: #64748b;
      padding: 1rem 0.75rem;
      border-bottom: 2px solid #e2e8f0;
      white-space: nowrap;
    }
    .table td {
      vertical-align: middle;
      padding: 0.9rem 0.75rem;
    }
    .table tbody tr {
      transition: background 0.15s ease;
    }
    .table tbody tr:hover {
      background: #f8fafc;
    }

    .badge {
      font-size: 0.75rem;
      font-weight: 600;
      letter-spacing: 0.2px;
    }

    .action-btn {
      width: 34px;
      height: 34px;
      padding: 0;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      transition: all 0.2s ease;
    }
    .action-btn:hover {
      transform: scale(1.1);
    }

    .input-group-text {
      background-color: #fff !important;
    }
    .input-group:focus-within .input-group-text,
    .input-group:focus-within .form-control {
      border-color: #86b7fe;
      box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.1);
    }

    .form-select:focus, .form-control:focus {
      border-color: #86b7fe;
      box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.1);
    }

    @media (max-width: 768px) {
      .table-responsive {
        font-size: 0.85rem;
      }
      .stat-icon {
        width: 44px;
        height: 44px;
      }
    }

  //- ============================================
  //- SCRIPT
  //- ============================================
  script.
    document.addEventListener('DOMContentLoaded', function() {
      const searchInput = document.getElementById('searchSale');
      const filterStatus = document.getElementById('filterStatus');
      const table = document.getElementById('salesTable');
      const resultsCount = document.getElementById('resultsCount');

      function filterTable() {
        const term = searchInput.value.toLowerCase().trim();
        const status = filterStatus.value;
        const rows = table.querySelectorAll('tbody tr');
        let visible = 0;

        rows.forEach(row => {
          if (row.id === 'emptyRow') return;

          const text = row.textContent.toLowerCase();
          const rowStatus = row.dataset.status || '';

          let show = text.includes(term);
          if (status) show = show && (rowStatus === status);

          row.style.display = show ? '' : 'none';
          if (show) visible++;
        });

        if (resultsCount) {
          resultsCount.textContent = visible + (visible === 1 ? ' resultado' : ' resultados');
        }
      }

      if (searchInput) searchInput.addEventListener('input', filterTable);
      if (filterStatus) filterStatus.addEventListener('change', filterTable);

      if (searchInput) {
        searchInput.addEventListener('keypress', function(e) {
          if (e.key === 'Enter') {
            e.preventDefault();
            filterTable();
          }
        });
      }
    });