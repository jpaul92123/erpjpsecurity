extends ../layouts/layout

block content

  //- ============================================
  //- HEADER
  //- ============================================
  .d-flex.flex-wrap.flex-md-nowrap.align-items-center.justify-content-between.pb-3.mb-4.border-bottom
    .d-flex.align-items-center
      .bg-warning.bg-opacity-10.rounded-3.p-3.me-3
        i.fas.fa-pen.text-warning.fa-2x
      div
        nav(aria-label="breadcrumb")
          ol.breadcrumb.mb-1
            li.breadcrumb-item
              a.text-decoration-none(href="/suppliers") Proveedores
            li.breadcrumb-item
              a.text-decoration-none(href=`/suppliers/${supplier._id}`)= supplier.businessName
            li.breadcrumb-item.active Editar
        h1.h2.mb-0.fw-bold Editar Proveedor
        p.text-muted.mb-0
          i.fas.fa-info-circle.me-1
          | Modifica los datos del proveedor
    div.d-flex.gap-2
      a.btn.btn-outline-secondary.rounded-pill.px-4(href=`/suppliers/${supplier._id}`)
        i.fas.fa-arrow-left.me-1
        | Volver

  //- ============================================
  //- FORMULARIO
  //- ============================================
  .row
    .col-lg-8.mx-auto
      form(
        action=`/suppliers/${supplier._id}?_method=PUT`
        method="POST"
        id="formEditSupplier"
        novalidate
      )

        //- ============================================
        //- DATOS PRINCIPALES
        //- ============================================
        .card.border-0.shadow-sm.rounded-3.mb-3
          .card-header.bg-white.border-bottom.py-3
            h6.mb-0.fw-bold
              i.fas.fa-building.me-2.text-warning
              | Datos Principales
          .card-body.p-4

            .row.g-3
              .col-md-12
                label.form-label.fw-semibold
                  | Razón Social / Nombre
                  span.text-danger.ms-1 *
                .input-group
                  span.input-group-text.bg-white
                    i.fas.fa-building.text-muted
                  input.form-control(
                    type="text"
                    name="businessName"
                    id="businessName"
                    value=supplier.businessName
                    placeholder="Ej: Distribuidora XYZ S.A.C."
                    required
                    maxlength="200"
                  )
                .invalid-feedback Ingresa el nombre del proveedor

              .col-md-6
                label.form-label.fw-semibold
                  | RUC
                  span.text-danger.ms-1 *
                .input-group
                  span.input-group-text.bg-white
                    i.fas.fa-id-card.text-muted
                  input.form-control(
                    type="text"
                    name="ruc"
                    id="ruc"
                    value=supplier.ruc
                    placeholder="20123456789"
                    required
                    maxlength="11"
                    pattern="[0-9]{11}"
                  )
                small.text-muted 11 dígitos
                .invalid-feedback Ingresa un RUC válido (11 dígitos)

              .col-md-6
                label.form-label.fw-semibold
                  | Persona de Contacto
                .input-group
                  span.input-group-text.bg-white
                    i.fas.fa-user-tie.text-muted
                  input.form-control(
                    type="text"
                    name="contactPerson"
                    id="contactPerson"
                    value=supplier.contactPerson
                    placeholder="Ej: Juan Pérez"
                    maxlength="100"
                  )

        //- ============================================
        //- CONTACTO
        //- ============================================
        .card.border-0.shadow-sm.rounded-3.mb-3
          .card-header.bg-white.border-bottom.py-3
            h6.mb-0.fw-bold
              i.fas.fa-address-book.me-2.text-warning
              | Información de Contacto
          .card-body.p-4

            .row.g-3
              .col-md-6
                label.form-label.fw-semibold
                  | Email
                  span.text-danger.ms-1 *
                .input-group
                  span.input-group-text.bg-white
                    i.fas.fa-envelope-at.text-muted
                  input.form-control(
                    type="email"
                    name="email"
                    id="email"
                    value=supplier.email
                    placeholder="proveedor@email.com"
                    required
                  )
                .invalid-feedback Ingresa un email válido

              .col-md-6
                label.form-label.fw-semibold
                  | Teléfono
                  span.text-danger.ms-1 *
                .input-group
                  span.input-group-text.bg-white
                    i.fas.fa-phone.text-muted
                  input.form-control(
                    type="text"
                    name="phone"
                    id="phone"
                    value=supplier.phone
                    placeholder="987654321"
                    required
                    maxlength="15"
                  )
                .invalid-feedback Ingresa un teléfono

              .col-md-12
                label.form-label.fw-semibold Dirección
                .input-group
                  span.input-group-text.bg-white
                    i.fas.fa-map-marker-alt.text-muted
                  input.form-control(
                    type="text"
                    name="address"
                    id="address"
                    value=supplier.address
                    placeholder="Av. Ejemplo 123, Lima"
                    maxlength="200"
                  )

        //- ============================================
        //- ESTADO
        //- ============================================
        .card.border-0.shadow-sm.rounded-3.mb-3
          .card-header.bg-white.border-bottom.py-3
            h6.mb-0.fw-bold
              i.fas.fa-toggle-on.me-2.text-warning
              | Estado del Proveedor
          .card-body.p-4

            .form-check.form-switch
              input.form-check-input(
                type="checkbox"
                name="isActive"
                id="isActive"
                checked=supplier.isActive
              )
              label.form-check-label.fw-semibold(for="isActive")
                | Proveedor Activo
                small.text-muted.d-block.ms-0
                  | Si está desactivado, no aparecerá en las listas de selección

        //- ============================================
        //- BOTONES
        //- ============================================
        .card.border-0.shadow-sm.rounded-3
          .card-body.p-3
            .d-flex.flex-wrap.justify-content-between.align-items-center.gap-2

              //- Info de auditoría
              if supplier.createdAt
                small.text-muted
                  i.fas.fa-clock.me-1
                  | Creado el #{new Date(supplier.createdAt).toLocaleDateString('es-PE', { day: '2-digit', month: 'long', year: 'numeric' })}

              div.d-flex.gap-2
                a.btn.btn-outline-secondary.rounded-pill.px-4(href=`/suppliers/${supplier._id}`)
                  i.fas.fa-times.me-1
                  | Cancelar
                button.btn.btn-warning.rounded-pill.px-4(
                  type="submit"
                  id="btnSubmit"
                )
                  i.fas.fa-save.me-1
                  | Guardar Cambios

  //- ============================================
  //- ESTILOS
  //- ============================================
  style.
    .form-control, .form-select {
      border-color: #e2e8f0;
      padding: 0.65rem 0.9rem;
    }
    .form-control:focus, .form-select:focus {
      border-color: #ffc107;
      box-shadow: 0 0 0 3px rgba(255, 193, 7, 0.15);
    }
    .input-group-text {
      border-color: #e2e8f0;
    }
    .input-group:focus-within .input-group-text {
      border-color: #ffc107;
    }
    .form-label {
      font-size: 0.9rem;
      margin-bottom: 0.4rem;
      color: #334155;
    }

    .form-check-input:checked {
      background-color: #ffc107;
      border-color: #ffc107;
    }
    .form-check-input:focus {
      border-color: #ffc107;
      box-shadow: 0 0 0 3px rgba(255, 193, 7, 0.15);
    }

  //- ============================================
  //- SCRIPT
  //- ============================================
  script.
    document.addEventListener('DOMContentLoaded', function() {
      const form = document.getElementById('formEditSupplier');
      const btnSubmit = document.getElementById('btnSubmit');

      if (form) {
        form.addEventListener('submit', function(e) {
          e.preventDefault();
          e.stopPropagation();

          // Validar campos requeridos
          const businessName = document.getElementById('businessName');
          const ruc = document.getElementById('ruc');
          const email = document.getElementById('email');
          const phone = document.getElementById('phone');

          let hasError = false;

          // Razón Social
          if (!businessName.value.trim()) {
            businessName.classList.add('is-invalid');
            hasError = true;
          } else {
            businessName.classList.remove('is-invalid');
          }

          // RUC
          if (!ruc.value.trim() || !/^[0-9]{11}$/.test(ruc.value.trim())) {
            ruc.classList.add('is-invalid');
            hasError = true;
          } else {
            ruc.classList.remove('is-invalid');
          }

          // Email
          if (!email.value.trim() || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email.value.trim())) {
            email.classList.add('is-invalid');
            hasError = true;
          } else {
            email.classList.remove('is-invalid');
          }

          // Teléfono
          if (!phone.value.trim()) {
            phone.classList.add('is-invalid');
            hasError = true;
          } else {
            phone.classList.remove('is-invalid');
          }

          if (hasError) {
            const firstError = form.querySelector('.is-invalid');
            if (firstError) {
              firstError.focus();
              firstError.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }
            return false;
          }

          // Loading
          btnSubmit.disabled = true;
          btnSubmit.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Guardando...';

          form.submit();
        });

        // Limpiar validación al escribir
        form.querySelectorAll('.form-control').forEach(input => {
          input.addEventListener('input', function() {
            this.classList.remove('is-invalid');
          });
        });
      }
    });