extends ../layouts/layout

block content

  //- ============================================
  //- HEADER
  //- ============================================
  .sup-page-header.mb-3.mb-md-4
    .d-flex.flex-wrap.justify-content-between.align-items-center.gap-2.gap-md-3
      div.min-w-0
        nav.d-none.d-md-block(aria-label="breadcrumb")
          ol.breadcrumb.mb-1
            li.breadcrumb-item
              a.text-decoration-none(href="/") Inicio
            li.breadcrumb-item.active(aria-current="page") Proveedores

        h1.h4.h3-md.fw-bold.mb-1.text-dark.text-truncate
          i.fas.fa-handshake.me-2.text-primary
          | Proveedores

        p.text-muted.mb-0.small.d-none.d-sm-block
          | Gestiona los proveedores registrados en el sistema

      a.btn.btn-primary.rounded-pill.px-3.px-md-4.fw-semibold.d-inline-flex.align-items-center.gap-2.sup-new-btn(
        href="/suppliers/create"
      )
        i.fas.fa-plus-circle
        span.d-none.d-sm-inline Nuevo Proveedor
        span.d-sm-none Nuevo

  //- ============================================
  //- ESTADÍSTICAS (4 cards compactas)
  //- ============================================
  .row.g-2.g-md-3.mb-3.mb-md-4
    .col-6.col-lg-3
      .card.sup-stat-card.border-0.shadow-sm.rounded-3.h-100
        .card-body.p-2.p-md-3
          .d-flex.justify-content-between.align-items-center
            div.min-w-0
              p.sup-stat-label.mb-1.text-muted Total
              h3.sup-stat-value.mb-0.text-primary #{suppliers ? suppliers.length : 0}
            .sup-stat-icon.sup-stat-icon-primary
              i.fas.fa-handshake

    .col-6.col-lg-3
      .card.sup-stat-card.border-0.shadow-sm.rounded-3.h-100
        .card-body.p-2.p-md-3
          .d-flex.justify-content-between.align-items-center
            div.min-w-0
              p.sup-stat-label.mb-1.text-muted Activos
              h3.sup-stat-value.mb-0.text-success #{suppliers ? suppliers.filter(function(s){ return s.isActive; }).length : 0}
            .sup-stat-icon.sup-stat-icon-success
              i.fas.fa-check-circle

    .col-6.col-lg-3
      .card.sup-stat-card.border-0.shadow-sm.rounded-3.h-100
        .card-body.p-2.p-md-3
          .d-flex.justify-content-between.align-items-center
            div.min-w-0
              p.sup-stat-label.mb-1.text-muted Inactivos
              h3.sup-stat-value.mb-0.text-danger #{suppliers ? suppliers.filter(function(s){ return !s.isActive; }).length : 0}
            .sup-stat-icon.sup-stat-icon-danger
              i.fas.fa-ban

    .col-6.col-lg-3
      .card.sup-stat-card.border-0.shadow-sm.rounded-3.h-100
        .card-body.p-2.p-md-3
          .d-flex.justify-content-between.align-items-center
            div.min-w-0
              p.sup-stat-label.mb-1.text-muted Con RUC
              h3.sup-stat-value.mb-0.text-info #{suppliers ? suppliers.filter(function(s){ return s.ruc; }).length : 0}
            .sup-stat-icon.sup-stat-icon-info
              i.fas.fa-id-card

  //- ============================================
  //- BÚSQUEDA Y FILTROS
  //- ============================================
  .card.border-0.shadow-sm.rounded-3.mb-3
    .card-body.p-2.p-md-3
      .row.g-2.align-items-center

        .col-12.col-md-6
          .input-group
            span.input-group-text.bg-transparent.border-end-0
              i.fas.fa-search.text-muted
            input.form-control.border-start-0#searchSupplier(
              type="text"
              placeholder="Buscar por nombre, RUC o email..."
              autocomplete="off"
            )

        .col-8.col-md-4
          select.form-select#filterStatus
            option(value="") Todos los estados
            option(value="active") Solo activos
            option(value="inactive") Solo inactivos

        .col-4.col-md-2.text-end
          span.badge.bg-primary-subtle.text-primary.rounded-pill.px-3.py-2.w-100.sup-count-badge
            i.fas.fa-list.me-1
            span#resultsCount= (suppliers && suppliers.length) || 0

  //- ============================================
  //- TABLA (desktop/tablet)
  //- ============================================
  .card.border-0.shadow-sm.rounded-3.d-none.d-md-block#tableCard
    .card-body.p-0
      .table-responsive
        table.table.table-hover.align-middle.mb-0.sup-table
          thead.table-light
            tr
              th Proveedor
              th RUC
              th Contacto
              th.text-center Estado
              th.text-end Acciones
          tbody#suppliersTableBody
            if suppliers && suppliers.length
              each supplier in suppliers
                - const statusClass = supplier.isActive ? 'sup-badge-success' : 'sup-badge-danger'
                - const statusText = supplier.isActive ? 'Activo' : 'Inactivo'
                - const statusIcon = supplier.isActive ? 'fa-check-circle' : 'fa-times-circle'
                - const searchData = ((supplier.businessName || '') + ' ' + (supplier.ruc || '') + ' ' + (supplier.email || '') + ' ' + (supplier.phone || '')).toLowerCase()

                tr.sup-row(
                  data-search=searchData
                  data-status=supplier.isActive ? 'active' : 'inactive'
                )
                  td
                    .d-flex.align-items-center.gap-2
                      .sup-avatar
                        i.fas.fa-truck
                      div.min-w-0
                        a.text-decoration-none.fw-semibold.text-dark.text-truncate.d-block(
                          href=`/suppliers/${supplier._id}`
                        )= supplier.businessName
                        small.text-muted
                          i.fas.fa-hashtag.me-1
                          | #{supplier._id.toString().slice(-6).toUpperCase()}

                  td
                    if supplier.ruc
                      div.small.fw-semibold= supplier.ruc
                      small.text-muted RUC
                    else
                      span.text-muted.fst-italic.small Sin RUC

                  td
                    if supplier.phone
                      div.small
                        i.fas.fa-phone.text-success.me-1
                        | #{supplier.phone}
                    if supplier.email
                      div.small.text-muted.text-truncate
                        i.fas.fa-envelope.me-1
                        | #{supplier.email}
                    if !supplier.phone && !supplier.email
                      span.text-muted.fst-italic.small Sin contacto

                  td.text-center
                    span.sup-badge(class=statusClass)
                      i.fas(class=statusIcon)
                      span= statusText

                  td.text-end
                    .btn-group.btn-group-sm
                      a.btn.btn-outline-info.sup-action-btn(
                        href=`/suppliers/${supplier._id}`
                        title="Ver"
                      )
                        i.fas.fa-eye
                      a.btn.btn-outline-warning.sup-action-btn(
                        href=`/suppliers/${supplier._id}/edit`
                        title="Editar"
                      )
                        i.fas.fa-pen
                      button.btn.btn-outline-danger.sup-action-btn.btn-delete-supplier(
                        type="button"
                        title="Eliminar"
                        data-supplier-id=supplier._id
                        data-supplier-name=supplier.businessName
                      )
                        i.fas.fa-trash
            else
              tr
                td(colspan="5").text-center.py-5
                  .sup-empty
                    i.fas.fa-handshake.fa-3x.mb-3.opacity-25.d-block
                    p.text-muted.mb-3 No hay proveedores registrados
                    a.btn.btn-sm.btn-primary.rounded-pill(href="/suppliers/create")
                      i.fas.fa-plus-circle.me-1
                      | Crear primer proveedor

  //- ============================================
  //- CARDS (móvil)
  //- ============================================
  .d-md-none#cardsView
    if suppliers && suppliers.length
      each supplier in suppliers
        - const statusClass = supplier.isActive ? 'sup-badge-success' : 'sup-badge-danger'
        - const statusText = supplier.isActive ? 'Activo' : 'Inactivo'
        - const statusIcon = supplier.isActive ? 'fa-check-circle' : 'fa-times-circle'
        - const searchData = ((supplier.businessName || '') + ' ' + (supplier.ruc || '') + ' ' + (supplier.email || '') + ' ' + (supplier.phone || '')).toLowerCase()

        .card.sup-mobile-card.border-0.shadow-sm.rounded-4.mb-2.sup-row(
          data-search=searchData
          data-status=supplier.isActive ? 'active' : 'inactive'
        )
          .card-body.p-3

            .d-flex.justify-content-between.align-items-start.gap-2.mb-2
              .d-flex.align-items-center.gap-2.min-w-0
                .sup-avatar.sup-avatar-lg
                  i.fas.fa-truck
                div.min-w-0
                  .fw-bold.text-dark.text-truncate= supplier.businessName
                  small.text-muted
                    i.fas.fa-hashtag.me-1
                    | #{supplier._id.toString().slice(-6).toUpperCase()}

              span.sup-badge.flex-shrink-0(class=statusClass)
                i.fas(class=statusIcon)
                span= statusText

            .sup-mobile-info.mb-3
              if supplier.ruc
                .d-flex.align-items-center.gap-2.mb-1
                  i.fas.fa-id-card.text-primary.fa-sm
                  small.text-muted= supplier.ruc
              if supplier.phone
                .d-flex.align-items-center.gap-2.mb-1
                  i.fas.fa-phone.text-primary.fa-sm
                  small.text-muted= supplier.phone
              if supplier.email
                .d-flex.align-items-center.gap-2
                  i.fas.fa-envelope.text-primary.fa-sm
                  small.text-muted.text-truncate= supplier.email
              if !supplier.ruc && !supplier.phone && !supplier.email
                small.text-muted.fst-italic Sin datos de contacto

            .d-flex.gap-2
              a.btn.btn-sm.btn-outline-info.flex-fill.rounded-pill(
                href=`/suppliers/${supplier._id}`
              )
                i.fas.fa-eye.me-1
                | Ver
              a.btn.btn-sm.btn-outline-warning.flex-fill.rounded-pill(
                href=`/suppliers/${supplier._id}/edit`
              )
                i.fas.fa-pen.me-1
                | Editar
              button.btn.btn-sm.btn-outline-danger.flex-fill.rounded-pill.btn-delete-supplier(
                type="button"
                data-supplier-id=supplier._id
                data-supplier-name=supplier.businessName
              )
                i.fas.fa-trash.me-1
                | Borrar
    else
      .card.border-0.shadow-sm.rounded-4
        .card-body.text-center.py-5
          .sup-empty
            i.fas.fa-handshake.fa-3x.mb-3.opacity-25.d-block
            p.text-muted.mb-3 No hay proveedores registrados
            a.btn.btn-primary.rounded-pill(href="/suppliers/create")
              i.fas.fa-plus-circle.me-1
              | Crear primer proveedor

  //- ============================================
  //- SIN RESULTADOS
  //- ============================================
  .card.border-0.shadow-sm.rounded-3.d-none#noResultsCard
    .card-body.text-center.py-5
      i.fas.fa-search.fa-3x.mb-3.opacity-25.d-block.text-muted
      p.text-muted.mb-0 No se encontraron proveedores con esos filtros

  //- ============================================
  //- MODAL CONFIRMAR ELIMINACIÓN
  //- ============================================
  .modal.fade#modalDeleteSupplier(tabindex="-1")
    .modal-dialog.modal-dialog-centered
      .modal-content.rounded-4.border-0.shadow-lg

        .modal-header.bg-danger.text-white.rounded-top-4
          h5.modal-title
            i.fas.fa-exclamation-triangle.me-2
            | Eliminar Proveedor
          button.btn-close.btn-close-white(type="button" data-bs-dismiss="modal")

        .modal-body.p-4
          .text-center.mb-4
            .bg-danger.bg-opacity-10.rounded-circle.d-inline-flex.align-items-center.justify-content-center.mb-3(
              style="width: 80px; height: 80px;"
            )
              i.fas.fa-trash.text-danger.fa-2x

            h5.fw-bold.mb-2 ¿Estás seguro de eliminar este proveedor?
            p.text-muted.mb-0
              | Se eliminará el proveedor 
              strong#deleteSupplierName.text-primary -
              | . Esta acción no se puede deshacer.

          .alert.alert-warning.rounded-3.mb-0
            i.fas.fa-info-circle.me-2
            small
              strong Nota:
              |  Si el proveedor tiene productos asociados, no se podrá eliminar.

        .modal-footer.border-top-0.p-3
          button.btn.btn-outline-secondary.rounded-pill.px-4(
            type="button"
            data-bs-dismiss="modal"
          )
            i.fas.fa-times.me-1
            | Cancelar
          form#formDeleteSupplier(method="POST" action="")
            input(type="hidden" name="_method" value="DELETE")
            button.btn.btn-danger.rounded-pill.px-4(
              type="submit"
              id="btnConfirmarDelete"
            )
              i.fas.fa-trash.me-1
              | Sí, eliminar

  //- ============================================
  //- ESTILOS
  //- ============================================
  style.
    .sup-page-header { padding-bottom: 0; }
    .sup-new-btn { white-space: nowrap; }

    /* ---- Stats ---- */
    .sup-stat-card { transition: transform 0.2s ease, box-shadow 0.2s ease; }
    .sup-stat-card:hover {
      transform: translateY(-3px);
      box-shadow: 0 10px 22px rgba(0,0,0,0.08) !important;
    }
    .sup-stat-label {
      font-size: 0.72rem;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      font-weight: 700;
      margin: 0;
    }
    .sup-stat-value {
      font-size: 1.5rem;
      line-height: 1.1;
      font-weight: 700;
    }
    .sup-stat-icon {
      width: 44px; height: 44px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: 12px;
      font-size: 1rem;
      flex-shrink: 0;
    }
    .sup-stat-icon-primary { background: #e0e7ff; color: #4f46e5; }
    .sup-stat-icon-success { background: #dcfce7; color: #15803d; }
    .sup-stat-icon-danger  { background: #fee2e2; color: #b91c1c; }
    .sup-stat-icon-info    { background: #cffafe; color: #0e7490; }

    /* ---- Contador ---- */
    .sup-count-badge { font-size: 0.85rem; font-weight: 700; }

    /* ---- Avatar ---- */
    .sup-avatar {
      width: 38px; height: 38px;
      border-radius: 10px;
      background: #eff6ff;
      color: #2563eb;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 0.9rem;
      flex-shrink: 0;
    }
    .sup-avatar-lg {
      width: 46px; height: 46px;
      font-size: 1.05rem;
    }

    /* ---- Tabla ---- */
    .sup-table thead th {
      font-size: 0.72rem;
      text-transform: uppercase;
      letter-spacing: 0.7px;
      font-weight: 700;
      color: #64748b;
      border-bottom: 2px solid #e2e8f0;
      padding: 0.9rem 0.75rem;
      white-space: nowrap;
    }
    .sup-table tbody td {
      padding: 0.85rem 0.75rem;
      vertical-align: middle;
      border-bottom: 1px solid #f1f5f9;
    }
    .sup-table tbody tr:hover { background: #f8fafc; }
    .sup-table tbody tr:last-child td { border-bottom: none; }

    /* ---- Action buttons ---- */
    .sup-action-btn {
      width: 34px; height: 34px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: 8px !important;
      font-size: 0.85rem;
      transition: all 0.2s;
    }
    .sup-action-btn:hover { transform: translateY(-1px); }

    /* ---- Badges ---- */
    .sup-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      padding: 0.35rem 0.75rem;
      border-radius: 999px;
      font-size: 0.75rem;
      font-weight: 700;
      white-space: nowrap;
    }
    .sup-badge i { font-size: 0.7rem; }
    .sup-badge-success { background: #dcfce7; color: #15803d; }
    .sup-badge-danger  { background: #fee2e2; color: #b91c1c; }

    /* ---- Empty ---- */
    .sup-empty i { color: #cbd5e1; }

    /* ---- Mobile cards ---- */
    .sup-mobile-card {
      transition: all 0.2s ease;
      border: 1px solid #eef2f7 !important;
    }
    .sup-mobile-card:active {
      transform: scale(0.99);
      box-shadow: 0 2px 8px rgba(0,0,0,0.06) !important;
    }
    .sup-mobile-info {
      background: #f8fafc;
      border-radius: 10px;
      padding: 0.6rem 0.75rem;
    }

    /* ---- Responsive ---- */
    @media (max-width: 575.98px) {
      .sup-page-header h1 { font-size: 1.15rem; }
      .sup-new-btn { padding: 0.5rem 0.9rem; font-size: 0.85rem; }
      .sup-mobile-card .card-body { padding: 0.85rem !important; }
      .sup-badge { font-size: 0.7rem; padding: 0.3rem 0.6rem; }
      .sup-stat-value { font-size: 1.25rem; }
      .sup-stat-icon { width: 38px; height: 38px; font-size: 0.9rem; }
    }

    @media (min-width: 768px) and (max-width: 991.98px) {
      .sup-table thead th,
      .sup-table tbody td { padding: 0.7rem 0.5rem; }
      .sup-table { font-size: 0.85rem; }
    }

  //- ============================================
  //- SCRIPT
  //- ============================================
  script.
    document.addEventListener('DOMContentLoaded', function() {
      var searchInput = document.getElementById('searchSupplier');
      var filterStatus = document.getElementById('filterStatus');
      var resultsCount = document.getElementById('resultsCount');
      var tableCard = document.getElementById('tableCard');
      var cardsView = document.getElementById('cardsView');
      var noResultsCard = document.getElementById('noResultsCard');

      // ============================================
      // FILTROS
      // ============================================
      function filterTable() {
        var term = searchInput ? searchInput.value.toLowerCase().trim() : '';
        var status = filterStatus ? filterStatus.value : '';
        var rows = document.querySelectorAll('.sup-row');
        var visible = 0;

        rows.forEach(function(row) {
          var searchData = row.getAttribute('data-search') || '';
          var rowStatus = row.getAttribute('data-status') || '';

          var matchSearch = !term || searchData.indexOf(term) !== -1;
          var matchStatus = !status || rowStatus === status;

          if (matchSearch && matchStatus) {
            row.style.display = '';
            visible++;
          } else {
            row.style.display = 'none';
          }
        });

        if (resultsCount) resultsCount.textContent = visible;

        if (visible === 0) {
          if (tableCard) tableCard.classList.add('d-none');
          if (cardsView) cardsView.classList.add('d-none');
          if (noResultsCard) noResultsCard.classList.remove('d-none');
        } else {
          if (noResultsCard) noResultsCard.classList.add('d-none');
          if (tableCard) tableCard.classList.remove('d-none');
          if (cardsView) cardsView.classList.remove('d-none');
        }
      }

      if (searchInput) searchInput.addEventListener('input', filterTable);
      if (filterStatus) filterStatus.addEventListener('change', filterTable);

      // ============================================
      // ELIMINAR PROVEEDOR
      // ============================================
      var modalEl = document.getElementById('modalDeleteSupplier');
      var modalDelete = modalEl ? new bootstrap.Modal(modalEl) : null;
      var deleteSupplierName = document.getElementById('deleteSupplierName');
      var formDeleteSupplier = document.getElementById('formDeleteSupplier');
      var btnConfirmarDelete = document.getElementById('btnConfirmarDelete');

      document.querySelectorAll('.btn-delete-supplier').forEach(function(btn) {
        btn.addEventListener('click', function() {
          var supplierId = this.dataset.supplierId;
          var supplierName = this.dataset.supplierName;

          if (deleteSupplierName) deleteSupplierName.textContent = supplierName;
          if (formDeleteSupplier) formDeleteSupplier.action = '/suppliers/' + supplierId + '?_method=DELETE';

          if (modalDelete) modalDelete.show();
        });
      });

      if (formDeleteSupplier) {
        formDeleteSupplier.addEventListener('submit', function() {
          if (btnConfirmarDelete) {
            btnConfirmarDelete.disabled = true;
            btnConfirmarDelete.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Eliminando...';
          }
        });
      }

      // Atajo Ctrl+K
      document.addEventListener('keydown', function(e) {
        if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
          e.preventDefault();
          if (searchInput) searchInput.focus();
        }
      });
    });