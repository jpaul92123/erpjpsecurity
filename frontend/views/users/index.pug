extends ../layouts/layout

block content
  .d-flex.justify-content-between.align-items-center.mb-3
    h1 Usuarios
    a.btn.btn-primary(href="/users/create") + Nuevo Usuario

  table.table.table-striped
    thead
      tr
        th Nombre
        th Email
        th Rol
        th Estado
        th Acciones
    tbody
      each user in users
        tr
          td= user.name
          td= user.email
          td= user.role.name
          td
            if user.isActive
              span.badge.bg-success Activo
            else
              span.badge.bg-danger Inactivo
          td
            a.btn.btn-sm.btn-warning(href=`/users/${user.id}/edit`) Editar
            form.d-inline(action=`/users/${user.id}?_method=DELETE`, method="POST")
              button.btn.btn-sm.btn-danger(type="submit") Eliminar