extends ../layouts/layout

block content

  //- ============================================
  //- HEADER
  //- ============================================
  .usr-page-header.mb-3.mb-md-4
    .d-flex.flex-wrap.justify-content-between.align-items-center.gap-2.gap-md-3
      div.min-w-0
        nav.d-none.d-md-block(aria-label="breadcrumb")
          ol.breadcrumb.mb-1
            li.breadcrumb-item
              a.text-decoration-none(href="/") Inicio
            li.breadcrumb-item.active(aria-current="page") Usuarios

        h1.h4.h3-md.fw-bold.mb-1.text-dark.text-truncate
          i.fas.fa-users.me-2.text-primary
          | Usuarios

        p.text-muted.mb-0.small.d-none.d-sm-block
          | Administra los usuarios del sistema y sus roles

      a.btn.btn-primary.rounded-pill.px-3.px-md-4.fw-semibold.d-inline-flex.align-items-center.gap-2.usr-new-btn(
        href="/users/create"
      )
        i.fas.fa-plus-circle
        span.d-none.d-sm-inline Nuevo Usuario
        span.d-sm-none Nuevo

  //- ============================================
  //- BARRA DE BÚSQUEDA Y FILTROS
  //- ============================================
  .card.border-0.shadow-sm.rounded-3.mb-3
    .card-body.p-2.p-md-3
      .row.g-2.align-items-center

        .col-12.col-md-5
          .input-group
            span.input-group-text.bg-transparent.border-end-0
              i.fas.fa-search.text-muted
            input.form-control.border-start-0#searchInput(
              type="text"
              placeholder="Buscar por nombre o email..."
              autocomplete="off"
            )

        .col-6.col-md-3
          select.form-select#statusFilter
            option(value="") Todos los estados
            option(value="active") Activos
            option(value="inactive") Inactivos

        .col-6.col-md-2
          select.form-select#roleFilter
            option(value="") Todos los roles

        .col-12.col-md-2.text-md-end
          span.badge.bg-primary-subtle.text-primary.rounded-pill.px-3.py-2.w-100.usr-count-badge
            i.fas.fa-list.me-1
            span#resultCount= (users && users.length) || 0

  //- ============================================
  //- TABLA (desktop/tablet)
  //- ============================================
  .card.border-0.shadow-sm.rounded-3.d-none.d-md-block#tableCard
    .card-body.p-0
      .table-responsive
        table.table.table-hover.align-middle.mb-0.usr-table
          thead.table-light
            tr
              th Usuario
              th Email
              th Rol
              th.text-center Estado
              th.text-end Acciones
          tbody#usersTableBody
            if users && users.length
              each userItem in users
                - const isActive = userItem.isActive
                - const statusClass = isActive ? 'usr-badge-success' : 'usr-badge-danger'
                - const statusText = isActive ? 'Activo' : 'Inactivo'
                - const statusIcon = isActive ? 'fa-check-circle' : 'fa-times-circle'
                - const roleName = userItem.role ? userItem.role.name : '—'
                - const searchData = ((userItem.name || '') + ' ' + (userItem.email || '')).toLowerCase()

                tr.usr-row(
                  data-search=searchData
                  data-status=isActive ? 'active' : 'inactive'
                  data-role=roleName
                )
                  td
                    .d-flex.align-items-center.gap-2
                      .usr-avatar= (userItem.name || 'U').charAt(0).toUpperCase()
                      div.min-w-0
                        .fw-semibold.text-truncate= userItem.name

                  td
                    div.small.text-muted.text-truncate= userItem.email

                  td
                    span.usr-role-badge(class=roleName === 'admin' ? 'usr-role-admin' : 'usr-role-user')
                      i.fas(
                        class=roleName === 'admin' ? 'fa-crown' : 'fa-user'
                        class='fa-xs me-1'
                      )
                      = roleName

                  td.text-center
                    span.usr-badge(class=statusClass)
                      i.fas(class=statusIcon)
                      span= statusText

                  td.text-end
                    .btn-group.btn-group-sm
                      a.btn.btn-outline-warning.usr-action-btn(
                        href=`/users/${userItem.id}/edit`
                        title="Editar"
                      )
                        i.fas.fa-edit
                      form.d-inline(
                        method="POST"
                        action=`/users/${userItem.id}?_method=DELETE`
                        onsubmit="return confirm('¿Eliminar este usuario?')"
                      )
                        button.btn.btn-outline-danger.usr-action-btn(
                          type="submit"
                          title="Eliminar"
                        )
                          i.fas.fa-trash
            else
              tr
                td(colspan="5").text-center.py-5
                  .usr-empty
                    i.fas.fa-users.fa-3x.mb-3.opacity-25.d-block
                    p.text-muted.mb-3 No hay usuarios registrados
                    a.btn.btn-sm.btn-primary.rounded-pill(href="/users/create")
                      i.fas.fa-plus-circle.me-1
                      | Crear primer usuario

  //- ============================================
  //- CARDS (móvil)
  //- ============================================
  .d-md-none#cardsView
    if users && users.length
      each userItem in users
        - const isActive = userItem.isActive
        - const statusClass = isActive ? 'usr-badge-success' : 'usr-badge-danger'
        - const statusText = isActive ? 'Activo' : 'Inactivo'
        - const statusIcon = isActive ? 'fa-check-circle' : 'fa-times-circle'
        - const roleName = userItem.role ? userItem.role.name : '—'
        - const searchData = ((userItem.name || '') + ' ' + (userItem.email || '')).toLowerCase()

        .card.usr-mobile-card.border-0.shadow-sm.rounded-4.mb-2.usr-row(
          data-search=searchData
          data-status=isActive ? 'active' : 'inactive'
          data-role=roleName
        )
          .card-body.p-3

            //- Header: avatar + nombre + estado
            .d-flex.justify-content-between.align-items-start.gap-2.mb-2
              .d-flex.align-items-center.gap-2.min-w-0
                .usr-avatar.usr-avatar-lg= (userItem.name || 'U').charAt(0).toUpperCase()
                div.min-w-0
                  .fw-bold.text-dark.text-truncate= userItem.name
                  small.text-muted.text-truncate.d-block= userItem.email

              span.usr-badge.flex-shrink-0(class=statusClass)
                i.fas(class=statusIcon)
                span= statusText

            //- Rol
            .mb-3
              span.usr-role-badge(class=roleName === 'admin' ? 'usr-role-admin' : 'usr-role-user')
                i.fas(
                  class=roleName === 'admin' ? 'fa-crown' : 'fa-user'
                  class='fa-xs me-1'
                )
                = roleName

            //- Acciones
            .d-flex.gap-2
              a.btn.btn-sm.btn-outline-warning.flex-fill.rounded-pill(
                href=`/users/${userItem.id}/edit`
              )
                i.fas.fa-edit.me-1
                | Editar
              form.d-inline.flex-fill(
                method="POST"
                action=`/users/${userItem.id}?_method=DELETE`
                onsubmit="return confirm('¿Eliminar este usuario?')"
              )
                button.btn.btn-sm.btn-outline-danger.w-100.rounded-pill(type="submit")
                  i.fas.fa-trash.me-1
                  | Eliminar
    else
      .card.border-0.shadow-sm.rounded-4
        .card-body.text-center.py-5
          .usr-empty
            i.fas.fa-users.fa-3x.mb-3.opacity-25.d-block
            p.text-muted.mb-3 No hay usuarios registrados
            a.btn.btn-primary.rounded-pill(href="/users/create")
              i.fas.fa-plus-circle.me-1
              | Crear primer usuario

  //- ============================================
  //- SIN RESULTADOS
  //- ============================================
  .card.border-0.shadow-sm.rounded-3.d-none#noResultsCard
    .card-body.text-center.py-5
      i.fas.fa-search.fa-3x.mb-3.opacity-25.d-block.text-muted
      p.text-muted.mb-0 No se encontraron usuarios con esos filtros

  //- ============================================
  //- ESTILOS
  //- ============================================
  style.
    .usr-page-header { padding-bottom: 0; }
    .usr-new-btn { white-space: nowrap; }
    .usr-count-badge { font-size: 0.85rem; font-weight: 700; }

    /* ---- Avatar ---- */
    .usr-avatar {
      width: 38px; height: 38px;
      border-radius: 50%;
      background: linear-gradient(135deg, #4f46e5, #7c3aed);
      color: #fff;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-weight: 700;
      font-size: 0.9rem;
      flex-shrink: 0;
    }
    .usr-avatar-lg {
      width: 46px; height: 46px;
      font-size: 1.05rem;
    }

    /* ---- Tabla ---- */
    .usr-table thead th {
      font-size: 0.72rem;
      text-transform: uppercase;
      letter-spacing: 0.7px;
      font-weight: 700;
      color: #64748b;
      border-bottom: 2px solid #e2e8f0;
      padding: 0.9rem 0.75rem;
      white-space: nowrap;
    }
    .usr-table tbody td {
      padding: 0.85rem 0.75rem;
      vertical-align: middle;
      border-bottom: 1px solid #f1f5f9;
    }
    .usr-table tbody tr:hover { background: #f8fafc; }
    .usr-table tbody tr:last-child td { border-bottom: none; }

    /* ---- Action buttons ---- */
    .usr-action-btn {
      width: 34px; height: 34px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: 8px !important;
      font-size: 0.85rem;
      transition: all 0.2s;
    }
    .usr-action-btn:hover { transform: translateY(-1px); }

    /* ---- Badges de estado ---- */
    .usr-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      padding: 0.35rem 0.75rem;
      border-radius: 999px;
      font-size: 0.75rem;
      font-weight: 700;
      white-space: nowrap;
    }
    .usr-badge i { font-size: 0.7rem; }
    .usr-badge-success { background: #dcfce7; color: #15803d; }
    .usr-badge-danger  { background: #fee2e2; color: #b91c1c; }

    /* ---- Badges de rol ---- */
    .usr-role-badge {
      display: inline-flex;
      align-items: center;
      padding: 0.28rem 0.7rem;
      border-radius: 6px;
      font-size: 0.72rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.3px;
      white-space: nowrap;
    }
    .usr-role-admin { background: #fef3c7; color: #b45309; }
    .usr-role-user  { background: #e0e7ff; color: #4338ca; }

    /* ---- Empty ---- */
    .usr-empty i { color: #cbd5e1; }

    /* ---- Mobile cards ---- */
    .usr-mobile-card {
      transition: all 0.2s ease;
      border: 1px solid #eef2f7 !important;
    }
    .usr-mobile-card:active {
      transform: scale(0.99);
      box-shadow: 0 2px 8px rgba(0,0,0,0.06) !important;
    }

    /* ---- Responsive ---- */
    @media (max-width: 575.98px) {
      .usr-page-header h1 { font-size: 1.15rem; }
      .usr-new-btn { padding: 0.5rem 0.9rem; font-size: 0.85rem; }
      .usr-mobile-card .card-body { padding: 0.85rem !important; }
      .usr-badge { font-size: 0.7rem; padding: 0.3rem 0.6rem; }
      .usr-role-badge { font-size: 0.68rem; }
    }

    @media (min-width: 768px) and (max-width: 991.98px) {
      .usr-table thead th,
      .usr-table tbody td { padding: 0.7rem 0.5rem; }
      .usr-table { font-size: 0.85rem; }
    }

  //- ============================================
  //- SCRIPT
  //- ============================================
  script.
    document.addEventListener('DOMContentLoaded', function() {
      var searchInput = document.getElementById('searchInput');
      var statusFilter = document.getElementById('statusFilter');
      var roleFilter = document.getElementById('roleFilter');
      var resultCount = document.getElementById('resultCount');
      var tableCard = document.getElementById('tableCard');
      var cardsView = document.getElementById('cardsView');
      var noResultsCard = document.getElementById('noResultsCard');

      // Poblar dinámicamente el select de roles (sin duplicados)
      if (roleFilter) {
        var roleNames = [];
        document.querySelectorAll('.usr-row').forEach(function(row) {
          var r = row.getAttribute('data-role') || '';
          if (r && r !== '—' && roleNames.indexOf(r) === -1) {
            roleNames.push(r);
          }
        });
        roleNames.sort().forEach(function(r) {
          var opt = document.createElement('option');
          opt.value = r;
          opt.textContent = r.charAt(0).toUpperCase() + r.slice(1);
          roleFilter.appendChild(opt);
        });
      }

      function applyFilters() {
        var term = searchInput ? searchInput.value.toLowerCase().trim() : '';
        var status = statusFilter ? statusFilter.value : '';
        var role = roleFilter ? roleFilter.value : '';
        var rows = document.querySelectorAll('.usr-row');
        var visible = 0;

        rows.forEach(function(row) {
          var searchData = row.getAttribute('data-search') || '';
          var rowStatus = row.getAttribute('data-status') || '';
          var rowRole = row.getAttribute('data-role') || '';

          var matchSearch = !term || searchData.indexOf(term) !== -1;
          var matchStatus = !status || rowStatus === status;
          var matchRole = !role || rowRole === role;

          if (matchSearch && matchStatus && matchRole) {
            row.style.display = '';
            visible++;
          } else {
            row.style.display = 'none';
          }
        });

        if (resultCount) resultCount.textContent = visible;

        if (visible === 0) {
          if (tableCard) tableCard.classList.add('d-none');
          if (cardsView) cardsView.classList.add('d-none');
          if (noResultsCard) noResultsCard.classList.remove('d-none');
        } else {
          if (noResultsCard) noResultsCard.classList.add('d-none');
          if (tableCard) tableCard.classList.remove('d-none');
          if (cardsView) cardsView.classList.remove('d-none');
        }
      }

      if (searchInput) searchInput.addEventListener('input', applyFilters);
      if (statusFilter) statusFilter.addEventListener('change', applyFilters);
      if (roleFilter) roleFilter.addEventListener('change', applyFilters);

      document.addEventListener('keydown', function(e) {
        if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
          e.preventDefault();
          if (searchInput) searchInput.focus();
        }
      });
    });