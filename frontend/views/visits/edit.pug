extends ../layouts/layout

block content

  //- ============================================
  //- HEADER
  //- ============================================
  .vis-edit-header.mb-3.mb-md-4
    .d-flex.flex-wrap.justify-content-between.align-items-center.gap-2.gap-md-3
      div.min-w-0
        nav.d-none.d-md-block(aria-label="breadcrumb")
          ol.breadcrumb.mb-1
            li.breadcrumb-item
              a.text-decoration-none(href="/") Inicio
            li.breadcrumb-item
              a.text-decoration-none(href="/visits") Visitas
            li.breadcrumb-item.active(aria-current="page") Editar

        h1.h4.h3-md.fw-bold.mb-1.text-dark.text-truncate
          i.fas.fa-edit.me-2.text-primary
          | Editar Visita

        p.text-muted.mb-0.small.d-none.d-sm-block
          | Modifica los datos de la visita técnica

      a.btn.btn-light.rounded-circle.shadow-sm.vis-back-btn(
        href="/visits"
        title="Volver"
      )
        i.fas.fa-arrow-left

  //- ============================================
  //- FORM
  //- ============================================
  .row.justify-content-center
    .col-12.col-lg-9.col-xl-7
      .card.border-0.shadow-sm.rounded-4
        .card-body.p-3.p-md-4

          form#visitForm(
            method="POST"
            action=`/visits/${visit._id}?_method=PUT`
          )

            //- Cliente
            .mb-3
              label.form-label.fw-semibold(for="client")
                i.fas.fa-user.me-1.text-primary
                | Cliente
                span.text-danger.ms-1 *
              select.form-select#client(
                name="client"
                required
              )
                option(value="") — Seleccionar cliente —
                each c in (clients || [])
                  option(
                    value=c._id
                    selected=(visit.client && (visit.client._id || visit.client).toString() === c._id.toString())
                  )= c.businessName

            //- Técnico + Fecha (2 columnas)
            .row.g-3.mb-3
              .col-12.col-md-6
                label.form-label.fw-semibold(for="technician")
                  i.fas.fa-user-cog.me-1.text-primary
                  | Técnico
                  span.text-danger.ms-1 *
                input.form-control#technician(
                  type="text"
                  name="technician"
                  required
                  value=visit.technician || ''
                  placeholder="Nombre del técnico"
                )

              .col-12.col-md-6
                label.form-label.fw-semibold(for="date")
                  i.fas.fa-calendar.me-1.text-primary
                  | Fecha
                  span.text-danger.ms-1 *
                - const dateValue = visit.date ? new Date(visit.date).toISOString().split('T')[0] : ''
                input.form-control#date(
                  type="date"
                  name="date"
                  required
                  value=dateValue
                )

            //- Propósito
            .mb-3
              label.form-label.fw-semibold(for="purpose")
                i.fas.fa-bullseye.me-1.text-primary
                | Propósito
                span.text-danger.ms-1 *
              input.form-control#purpose(
                type="text"
                name="purpose"
                required
                value=visit.purpose || ''
                placeholder="Ej: Revisión de equipo, instalación, diagnóstico..."
              )

            //- Estado
            .mb-3
              label.form-label.fw-semibold(for="status")
                i.fas.fa-flag.me-1.text-primary
                | Estado
                span.text-danger.ms-1 *
              select.form-select#status(name="status" required)
                option(value="Pendiente" selected=(visit.status === 'Pendiente')) Pendiente
                option(value="En proceso" selected=(visit.status === 'En proceso')) En proceso
                option(value="Realizada" selected=(visit.status === 'Realizada')) Realizada
                option(value="Cancelada" selected=(visit.status === 'Cancelada')) Cancelada

            //- Notas
            .mb-4
              label.form-label.fw-semibold(for="notes")
                i.fas.fa-sticky-note.me-1.text-primary
                | Notas (opcional)
              textarea.form-control#notes(
                name="notes"
                rows="3"
                placeholder="Observaciones, materiales usados, etc."
              )= visit.notes || ''

            //- Acciones
            .d-flex.flex-wrap.gap-2.justify-content-end.pt-2.border-top
              a.btn.btn-light.rounded-pill.px-4(href="/visits")
                i.fas.fa-times.me-1
                | Cancelar
              button.btn.btn-primary.rounded-pill.px-4.fw-semibold(
                type="submit"
              )
                i.fas.fa-save.me-1
                | Guardar cambios

  //- ============================================
  //- ESTILOS
  //- ============================================
  style.
    .vis-edit-header { padding-bottom: 0; }

    .vis-back-btn {
      width: 42px; height: 42px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .form-label {
      font-size: 0.85rem;
      color: #334155;
      margin-bottom: 0.4rem;
    }

    .form-control,
    .form-select {
      border-radius: 10px;
      border: 1.5px solid #e2e8f0;
      padding: 0.65rem 0.9rem;
      font-size: 0.9rem;
      transition: all 0.2s;
    }
    .form-control:focus,
    .form-select:focus {
      border-color: #2563eb;
      box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12);
    }

    textarea.form-control { resize: vertical; min-height: 80px; }

    @media (max-width: 575.98px) {
      .vis-edit-header h1 { font-size: 1.15rem; }
      .vis-back-btn { width: 38px; height: 38px; }
    }

  //- ============================================
  //- SCRIPT
  //- ============================================
  script.
    document.addEventListener('DOMContentLoaded', function() {
      var form = document.getElementById('visitForm');
      if (form) {
        form.addEventListener('submit', function(e) {
          var client = document.getElementById('client').value;
          var technician = document.getElementById('technician').value.trim();
          var date = document.getElementById('date').value;
          var purpose = document.getElementById('purpose').value.trim();
          var status = document.getElementById('status').value;

          if (!client || !technician || !date || !purpose || !status) {
            e.preventDefault();
            alert('Por favor completa todos los campos obligatorios.');
          }
        });
      }
    });