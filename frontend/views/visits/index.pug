extends ../layouts/layout

block content

  //- ============================================
  //- HEADER
  //- ============================================
  .vis-page-header.mb-3.mb-md-4
    .d-flex.flex-wrap.justify-content-between.align-items-center.gap-2.gap-md-3
      div.min-w-0
        nav.d-none.d-md-block(aria-label="breadcrumb")
          ol.breadcrumb.mb-1
            li.breadcrumb-item
              a.text-decoration-none(href="/") Inicio
            li.breadcrumb-item.active(aria-current="page") Visitas Técnicas

        h1.h4.h3-md.fw-bold.mb-1.text-dark.text-truncate
          i.fas.fa-clipboard-check.me-2.text-primary
          | Visitas Técnicas

        p.text-muted.mb-0.small.d-none.d-sm-block
          | Registra y da seguimiento a las visitas de tus técnicos

      a.btn.btn-primary.rounded-pill.px-3.px-md-4.fw-semibold.d-inline-flex.align-items-center.gap-2.vis-new-btn(
        href="/visits/create"
      )
        i.fas.fa-plus-circle
        span.d-none.d-sm-inline Nueva Visita
        span.d-sm-none Nueva

  //- ============================================
  //- BUSCADOR Y FILTROS
  //- ============================================
  .card.border-0.shadow-sm.rounded-3.mb-3
    .card-body.p-2.p-md-3
      .row.g-2.align-items-center

        .col-12.col-md-6
          .input-group
            span.input-group-text.bg-transparent.border-end-0
              i.fas.fa-search.text-muted
            input.form-control.border-start-0#searchInput(
              type="text"
              placeholder="Buscar cliente, técnico o propósito..."
              autocomplete="off"
            )

        .col-8.col-md-4
          select.form-select#statusFilter
            option(value="") Todos los estados
            option(value="Pendiente") Pendiente
            option(value="En proceso") En proceso
            option(value="Realizada") Realizada
            option(value="Cancelada") Cancelada

        .col-4.col-md-2.text-end
          span.badge.bg-primary-subtle.text-primary.rounded-pill.px-3.py-2.w-100.vis-count-badge
            i.fas.fa-list.me-1
            span#resultCount= (visits && visits.length) || 0

  //- ============================================
  //- TABLA (desktop/tablet)
  //- ============================================
  .card.border-0.shadow-sm.rounded-3.d-none.d-md-block#tableCard
    .card-body.p-0
      .table-responsive
        table.table.table-hover.align-middle.mb-0.vis-table
          thead.table-light
            tr
              th Cliente
              th Técnico
              th Fecha
              th Propósito
              th Estado
              th.text-end Acciones
          tbody#visitsTableBody
            if visits && visits.length
              each visit in visits
                - const statusClass = visit.status === 'Realizada' ? 'vis-badge-success' : visit.status === 'Cancelada' ? 'vis-badge-danger' : visit.status === 'En proceso' ? 'vis-badge-info' : 'vis-badge-warning'
                - const statusIcon = visit.status === 'Realizada' ? 'fa-check-circle' : visit.status === 'Cancelada' ? 'fa-times-circle' : visit.status === 'En proceso' ? 'fa-spinner' : 'fa-clock'
                - const searchData = ((visit.client ? visit.client.businessName : '') + ' ' + (visit.technician || '') + ' ' + (visit.purpose || '')).toLowerCase()

                tr.vis-row(
                  data-search=searchData
                  data-status=visit.status
                )
                  td
                    .d-flex.align-items-center.gap-2
                      .vis-avatar
                        i.fas.fa-user
                      div.min-w-0
                        .fw-semibold.text-truncate= visit.client ? visit.client.businessName : '-'

                  td
                    div.small.text-truncate= visit.technician

                  td
                    div.small.fw-semibold
                      = new Date(visit.date).toLocaleDateString('es-ES', { day: '2-digit', month: 'short', year: 'numeric' })

                  td
                    div.small.text-truncate= visit.purpose

                  td
                    span.vis-badge(class=statusClass)
                      i.fas(class=statusIcon)
                      span= visit.status

                  td.text-end
                    .btn-group.btn-group-sm
                      a.btn.btn-outline-info.vis-action-btn(
                        href=`/visits/${visit._id}`
                        title="Ver"
                      )
                        i.fas.fa-eye
                      a.btn.btn-outline-warning.vis-action-btn(
                        href=`/visits/${visit._id}/edit`
                        title="Editar"
                      )
                        i.fas.fa-edit
                      form.d-inline(
                        method="POST"
                        action=`/visits/${visit._id}?_method=DELETE`
                        onsubmit="return confirm('¿Eliminar esta visita?')"
                      )
                        button.btn.btn-outline-danger.vis-action-btn(
                          type="submit"
                          title="Eliminar"
                        )
                          i.fas.fa-trash
            else
              tr
                td(colspan="6").text-center.py-5
                  .vis-empty
                    i.fas.fa-clipboard-check.fa-3x.mb-3.opacity-25.d-block
                    p.text-muted.mb-3 No hay visitas registradas
                    a.btn.btn-sm.btn-primary.rounded-pill(href="/visits/create")
                      i.fas.fa-plus-circle.me-1
                      | Registrar primera visita

  //- ============================================
  //- CARDS (móvil)
  //- ============================================
  .d-md-none#cardsView
    if visits && visits.length
      each visit in visits
        - const statusClass = visit.status === 'Realizada' ? 'vis-badge-success' : visit.status === 'Cancelada' ? 'vis-badge-danger' : visit.status === 'En proceso' ? 'vis-badge-info' : 'vis-badge-warning'
        - const statusIcon = visit.status === 'Realizada' ? 'fa-check-circle' : visit.status === 'Cancelada' ? 'fa-times-circle' : visit.status === 'En proceso' ? 'fa-spinner' : 'fa-clock'
        - const searchData = ((visit.client ? visit.client.businessName : '') + ' ' + (visit.technician || '') + ' ' + (visit.purpose || '')).toLowerCase()

        .card.vis-mobile-card.border-0.shadow-sm.rounded-4.mb-2.vis-row(
          data-search=searchData
          data-status=visit.status
        )
          .card-body.p-3

            .d-flex.justify-content-between.align-items-start.gap-2.mb-2
              .d-flex.align-items-center.gap-2.min-w-0
                .vis-avatar
                  i.fas.fa-user
                div.min-w-0
                  .fw-bold.text-dark.text-truncate
                    = visit.client ? visit.client.businessName : '-'
                  small.text-muted.text-truncate.d-block= visit.purpose

              span.vis-badge.flex-shrink-0(class=statusClass)
                i.fas(class=statusIcon)
                span= visit.status

            .vis-mobile-info.mb-3
              .d-flex.align-items-center.gap-2.mb-1
                i.fas.fa-calendar.text-primary.fa-sm
                small.text-muted
                  = new Date(visit.date).toLocaleDateString('es-ES', { day: '2-digit', month: 'short', year: 'numeric' })
              .d-flex.align-items-center.gap-2
                i.fas.fa-user-cog.text-primary.fa-sm
                small.text-muted.text-truncate= visit.technician

            .d-flex.gap-2
              a.btn.btn-sm.btn-outline-info.flex-fill.rounded-pill(
                href=`/visits/${visit._id}`
              )
                i.fas.fa-eye.me-1
                | Ver
              a.btn.btn-sm.btn-outline-warning.flex-fill.rounded-pill(
                href=`/visits/${visit._id}/edit`
              )
                i.fas.fa-edit.me-1
                | Editar
              form.d-inline.flex-fill(
                method="POST"
                action=`/visits/${visit._id}?_method=DELETE`
                onsubmit="return confirm('¿Eliminar esta visita?')"
              )
                button.btn.btn-sm.btn-outline-danger.w-100.rounded-pill(type="submit")
                  i.fas.fa-trash.me-1
                  | Borrar
    else
      .card.border-0.shadow-sm.rounded-4
        .card-body.text-center.py-5
          .vis-empty
            i.fas.fa-clipboard-check.fa-3x.mb-3.opacity-25.d-block
            p.text-muted.mb-3 No hay visitas registradas
            a.btn.btn-primary.rounded-pill(href="/visits/create")
              i.fas.fa-plus-circle.me-1
              | Registrar primera visita

  //- ============================================
  //- SIN RESULTADOS
  //- ============================================
  .card.border-0.shadow-sm.rounded-3.d-none#noResultsCard
    .card-body.text-center.py-5
      i.fas.fa-search.fa-3x.mb-3.opacity-25.d-block.text-muted
      p.text-muted.mb-0 No se encontraron visitas con esos filtros

  //- ============================================
  //- ESTILOS
  //- ============================================
  style.
    .vis-page-header { padding-bottom: 0; }
    .vis-new-btn { white-space: nowrap; }
    .vis-count-badge { font-size: 0.85rem; font-weight: 700; }

    .vis-avatar {
      width: 38px; height: 38px;
      border-radius: 10px;
      background: #cffafe;
      color: #0e7490;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 0.9rem;
      flex-shrink: 0;
    }

    .vis-table thead th {
      font-size: 0.72rem;
      text-transform: uppercase;
      letter-spacing: 0.7px;
      font-weight: 700;
      color: #64748b;
      border-bottom: 2px solid #e2e8f0;
      padding: 0.9rem 0.75rem;
      white-space: nowrap;
    }
    .vis-table tbody td {
      padding: 0.85rem 0.75rem;
      vertical-align: middle;
      border-bottom: 1px solid #f1f5f9;
    }
    .vis-table tbody tr:hover { background: #f8fafc; }
    .vis-table tbody tr:last-child td { border-bottom: none; }

    .vis-action-btn {
      width: 34px; height: 34px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: 8px !important;
      font-size: 0.85rem;
      transition: all 0.2s;
    }
    .vis-action-btn:hover { transform: translateY(-1px); }

    .vis-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      padding: 0.35rem 0.75rem;
      border-radius: 999px;
      font-size: 0.75rem;
      font-weight: 700;
      white-space: nowrap;
    }
    .vis-badge i { font-size: 0.7rem; }
    .vis-badge-success { background: #dcfce7; color: #15803d; }
    .vis-badge-danger  { background: #fee2e2; color: #b91c1c; }
    .vis-badge-warning { background: #fef3c7; color: #b45309; }
    .vis-badge-info    { background: #dbeafe; color: #1d4ed8; }

    .vis-empty i { color: #cbd5e1; }

    .vis-mobile-card {
      transition: all 0.2s ease;
      border: 1px solid #eef2f7 !important;
    }
    .vis-mobile-card:active {
      transform: scale(0.99);
      box-shadow: 0 2px 8px rgba(0,0,0,0.06) !important;
    }
    .vis-mobile-info {
      background: #f8fafc;
      border-radius: 10px;
      padding: 0.6rem 0.75rem;
    }

    @media (max-width: 575.98px) {
      .vis-page-header h1 { font-size: 1.15rem; }
      .vis-new-btn { padding: 0.5rem 0.9rem; font-size: 0.85rem; }
      .vis-mobile-card .card-body { padding: 0.85rem !important; }
      .vis-badge { font-size: 0.7rem; padding: 0.3rem 0.6rem; }
    }

    @media (min-width: 768px) and (max-width: 991.98px) {
      .vis-table thead th,
      .vis-table tbody td { padding: 0.7rem 0.5rem; }
      .vis-table { font-size: 0.85rem; }
    }

  //- ============================================
  //- SCRIPT
  //- ============================================
  script.
    document.addEventListener('DOMContentLoaded', function() {
      var searchInput = document.getElementById('searchInput');
      var statusFilter = document.getElementById('statusFilter');
      var resultCount = document.getElementById('resultCount');
      var tableCard = document.getElementById('tableCard');
      var cardsView = document.getElementById('cardsView');
      var noResultsCard = document.getElementById('noResultsCard');

      function applyFilters() {
        var term = searchInput ? searchInput.value.toLowerCase().trim() : '';
        var status = statusFilter ? statusFilter.value : '';
        var rows = document.querySelectorAll('.vis-row');
        var visible = 0;

        rows.forEach(function(row) {
          var searchData = row.getAttribute('data-search') || '';
          var rowStatus = row.getAttribute('data-status') || '';
          var matchSearch = !term || searchData.indexOf(term) !== -1;
          var matchStatus = !status || rowStatus === status;

          if (matchSearch && matchStatus) {
            row.style.display = '';
            visible++;
          } else {
            row.style.display = 'none';
          }
        });

        if (resultCount) resultCount.textContent = visible;

        if (visible === 0) {
          if (tableCard) tableCard.classList.add('d-none');
          if (cardsView) cardsView.classList.add('d-none');
          if (noResultsCard) noResultsCard.classList.remove('d-none');
        } else {
          if (noResultsCard) noResultsCard.classList.add('d-none');
          if (tableCard) tableCard.classList.remove('d-none');
          if (cardsView) cardsView.classList.remove('d-none');
        }
      }

      if (searchInput) searchInput.addEventListener('input', applyFilters);
      if (statusFilter) statusFilter.addEventListener('change', applyFilters);

      document.addEventListener('keydown', function(e) {
        if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
          e.preventDefault();
          if (searchInput) searchInput.focus();
        }
      });
    });