extends ../layouts/layout

block content
  .d-flex.justify-content-between.flex-wrap.flex-md-nowrap.align-items-center.pb-2.mb-3.border-bottom
    h1.h2
      i.fas.fa-warehouse.me-2
      | Almacenes
    a.btn.btn-primary(href="/warehouses/create")
      i.fas.fa-plus-circle.me-1
      | Nuevo Almacén

  .card.border-0.shadow-sm
    .card-body
      .table-responsive
        table.table.table-hover.align-middle
          thead
            tr
              th Nombre
              th Ubicación
              th Estado
              th Acciones
          tbody
            each warehouse in warehouses
              tr
                td #{warehouse.name}
                td #{warehouse.location || '-'}
                td
                  if warehouse.isActive
                    span.badge.bg-success Activo
                  else
                    span.badge.bg-danger Inactivo
                td
                  .btn-group.btn-group-sm
                    a.btn.btn-outline-warning(href=`/warehouses/${warehouse._id}/edit`)
                      i.fas.fa-edit
                    form.d-inline(method="POST", action=`/warehouses/${warehouse._id}?_method=DELETE`, onsubmit="return confirm('¿Eliminar este almacén?')")
                      button.btn.btn-outline-danger(type="submit")
                        i.fas.fa-trash
            else
              tr
                td(colspan="4").text-center.py-4
                  p.text-muted No hay almacenes registrados.
                  a.btn.btn-sm.btn-primary(href="/warehouses/create") Crear primer almacén