extends ../layouts/layout

block content
  .d-flex.justify-content-between.flex-wrap.flex-md-nowrap.align-items-center.pb-2.mb-3.border-bottom
    h1.h2
      i.fas.fa-plus-circle.me-2
      | Nueva Orden de Trabajo
    a.btn.btn-outline-secondary(href="/work-orders")
      i.fas.fa-arrow-left.me-1
      | Volver

  .card.border-0.shadow-sm
    .card-body
      form(method="POST", action="/work-orders")
        .row
          .col-md-6
            .mb-3
              label.form-label Cliente *
              select.form-control(name="client", required)
                option(value="") Seleccionar...
                each client in clients || []
                  option(value=client._id) #{client.businessName}
          .col-md-6
            .mb-3
              label.form-label Proyecto (opcional)
              select.form-control(name="project")
                option(value="") Ninguno
                each project in projects || []
                  option(value=project._id) #{project.name}
        .mb-3
          label.form-label Descripción *
          textarea.form-control(name="description", rows="2", required)
        .row
          .col-md-6
            .mb-3
              label.form-label Prioridad
              select.form-control(name="priority")
                option(value="Baja") Baja
                option(value="Media") Media
                option(value="Alta") Alta
                option(value="Urgente") Urgente
          .col-md-6
            .mb-3
              label.form-label Asignado a *
              input.form-control(type="text", name="assignedTo", required)
        .row
          .col-md-6
            .mb-3
              label.form-label Fecha de Inicio *
              input.form-control(type="date", name="startDate", required)
          .col-md-6
            .mb-3
              label.form-label Fecha de Finalización
              input.form-control(type="date", name="endDate")
        .mb-3
          label.form-label Notas
          textarea.form-control(name="notes", rows="2")
        button.btn.btn-primary(type="submit")
          i.fas.fa-save.me-1
          | Guardar
        a.btn.btn-outline-secondary.ms-2(href="/work-orders") Cancelar